---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import LangBanner from '~/components/common/LangBanner.astro';

import { getHeaderData, getFooterData } from '~/navigation';
import { getLangFromPath, t, type Lang } from '~/i18n';

import Breadcrumb from '~/components/common/Breadcrumb.astro';
import type { BreadcrumbItem } from '~/components/common/Breadcrumb.astro';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  breadcrumbs?: BreadcrumbItem[];
  /** Override detected lang. Use only when the page genuinely owns the
   *  declaration (e.g. dynamic routes that pass lang explicitly). */
  lang?: Lang;
  /** Set false to keep a page out of the Pagefind index (e.g. /search/).
   *  With data-pagefind-body present on the rest of the site, a page
   *  without it is excluded entirely. */
  searchIndex?: boolean;
}

const { metadata, breadcrumbs, lang: langOverride, searchIndex = true } = Astro.props;
const lang: Lang = langOverride ?? getLangFromPath(new URL(Astro.url).pathname);
const headerData = getHeaderData(lang);
const footerData = getFooterData(lang);

// Pagefind scope + facet. data-pagefind-body on <main> keeps header /
// footer / nav chrome out of the index; the section filter (route's first
// path segment → localized section label) powers the "filter by section"
// panel in the search UI. Indexes are per-<html lang>, so localized filter
// values group correctly within each language's index.
const SECTION_KEY: Record<string, Parameters<typeof t>[1]> = {
  '': 'navHome',
  policies: 'navPolicies',
  levers: 'navLevers',
  'legal-ai': 'navLegalAi',
  timeline: 'navTimeline',
  ecosystem: 'navEcosystem',
  evolution: 'navEvolution',
  debates: 'navParliament',
  voices: 'navVoices',
  speeches: 'navVoices',
  videos: 'navVideos',
  tracker: 'navTracker',
  startups: 'navStartups',
  talent: 'navTalent',
  benchmarking: 'navBenchmarking',
  opensource: 'navOpensource',
  'community-opensource': 'navCommunityOpensource',
  fieldnotes: 'navFieldnotes',
  references: 'navReferences',
  updates: 'updatesNav',
  about: 'navAboutSite',
  challenges: 'navChallenges',
  blog: 'navAnalysis',
};

const pathSansLang = new URL(Astro.url).pathname.replace(/^\/(zh-tw|zh|ja|ko)(?=\/|$)/, '');
const firstSeg = pathSansLang.split('/').filter(Boolean)[0] ?? '';
// Unknown first segments are root-level blog posts → Analysis.
const sectionLabel = t(lang, SECTION_KEY[firstSeg] ?? 'navAnalysis');

const mainAttrs = searchIndex
  ? { 'data-pagefind-body': true, 'data-pagefind-filter': 'section[data-section]', 'data-section': sectionLabel }
  : {};
---

<Layout metadata={metadata} lang={lang}>
  <slot name="announcement">
    <Announcement />
  </slot>
  <slot name="header">
    <Header {...headerData} isSticky lang={lang} />
  </slot>
  <LangBanner currentLang={lang} />
  <main {...mainAttrs}>
    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <div data-pagefind-ignore>
          <Breadcrumb items={breadcrumbs} />
        </div>
      )
    }
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
