---
// src/components/common/NewsletterSignup.astro
//
// Monthly digest signup (P1-4). Plain HTML form POSTing to Buttondown —
// zero client JS. The component renders nothing until BUTTONDOWN_FORM_ID
// is filled in (one-line activation after creating the free account):
//   Buttondown settings → "Signup forms" → form id.
//
// Editorial note: the monthly digest itself is generated by
// scripts/refresh/newsletter/generate-monthly.ts.

import { getLangFromPath, t, type Lang } from '~/i18n';

const lang: Lang = getLangFromPath(new URL(Astro.url).pathname);

// TODO(activation): fill in after creating the Buttondown account.
const BUTTONDOWN_FORM_ID = '';
const formAction = BUTTONDOWN_FORM_ID
  ? `https://buttondown.email/api/emails/embed-subscribe/${BUTTONDOWN_FORM_ID}`
  : null;
---

{
  formAction && (
    <section class="mt-10 bg-surface border border-subtle rounded-lg p-6 max-w-2xl">
      <h2 class="t-h3 text-gray-900 dark:text-white mb-2">{t(lang, 'newsletterTitle')}</h2>
      <p class="text-sm text-muted mb-4">{t(lang, 'newsletterBlurb')}</p>
      <form action={formAction} method="post" target="popupwindow" class="flex flex-wrap gap-2">
        <label class="sr-only" for="bd-email">
          {t(lang, 'newsletterEmailLabel')}
        </label>
        <input
          type="email"
          name="email"
          id="bd-email"
          required
          placeholder={t(lang, 'newsletterEmailLabel')}
          class="flex-1 min-w-48 px-3 py-2 rounded border border-subtle bg-white dark:bg-slate-800 text-sm"
        />
        <button
          type="submit"
          class="bg-primary hover:bg-secondary text-white font-semibold px-4 py-2 rounded text-sm transition-colors"
        >
          {t(lang, 'newsletterSubmit')}
        </button>
      </form>
    </section>
  )
}
