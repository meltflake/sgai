---
// i18n — non-intrusive language hint banner.
//
// Behaviour:
//  - SSR-renders hidden. Client-side reveals it only when the visitor's
//    browser language disagrees with the current page AND no `sgai_lang`
//    localStorage choice is set.
//  - NEVER auto-redirects. URL paths are the source of truth.
//  - Supports all configured locales (en/zh/ja/zh-tw/ko). Suggests the
//    best matching locale from the browser's language preferences.

import { type Lang, LOCALES, ROUTE_DEFAULT_LOCALE, t } from '~/i18n';

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;

// Native-script banner copy per locale. Keys map by Lang code (which
// doubles as the URL segment for non-default locales).
const BANNER_MESSAGES: Record<Lang, string> = {
  en: t('en', 'langBannerEn') || 'English version available',
  zh: '中文版可用',
  ja: '日本語版があります',
  'zh-tw': '繁體中文版可用',
  ko: '한국어 버전 이용 가능',
};
const SWITCH_LABELS: Record<Lang, string> = {
  en: t('en', 'langBannerSwitch') || 'Read in English →',
  zh: '阅读中文版 →',
  ja: '日本語で読む →',
  'zh-tw': '閱讀繁體中文版 →',
  ko: '한국어로 읽기 →',
};
const dismissLabel = t(currentLang, 'langBannerDismiss') || '关闭';
const localesJson = JSON.stringify(LOCALES.filter((l) => l !== currentLang));
const routeData = {
  routeDefault: ROUTE_DEFAULT_LOCALE,
  nonDefaultLangs: LOCALES.filter((l) => l !== ROUTE_DEFAULT_LOCALE),
};
---

<div
  id="lang-banner"
  data-current-lang={currentLang}
  data-suggest-locales={localesJson}
  class="hidden bg-primary/5 dark:bg-primary/10 border-b border-primary/20"
  aria-live="polite"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2 flex items-center justify-between gap-4 text-sm">
    <span class="text-gray-700 dark:text-gray-300">
      <span class="font-medium" id="lang-banner-msg"></span>
    </span>
    <div class="flex items-center gap-3 shrink-0">
      <a
        id="lang-banner-switch"
        href="#"
        class="text-primary hover:text-secondary font-semibold underline-offset-4 hover:underline"></a>
      <button
        type="button"
        id="lang-banner-dismiss"
        class="text-xs text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
        aria-label={dismissLabel}
      >
        {dismissLabel}
      </button>
    </div>
  </div>
</div>

<script define:vars={{ BANNER_MESSAGES, SWITCH_LABELS, routeData }}>
  (() => {
    const { routeDefault, nonDefaultLangs } = routeData;

    function localeUrl(targetLang) {
      const path = location.pathname;
      let bare = path;
      for (const lang of nonDefaultLangs) {
        const p = '/' + lang;
        if (path === p || path === p + '/') {
          bare = '/';
          break;
        }
        if (path.startsWith(p + '/')) {
          bare = path.slice(p.length);
          break;
        }
      }
      if (targetLang === routeDefault) return bare;
      if (bare === '/' || bare === '') return '/' + targetLang + '/';
      return '/' + targetLang + bare;
    }

    // Browser-preference matcher. Maps BCP-47 prefs to Lang codes.
    // zh-TW / zh-Hant / zh-HK → zh-tw; zh / zh-CN / zh-Hans → zh.
    function prefersLang(prefs, lang) {
      for (const p of prefs) {
        if (lang === 'zh-tw' && (p.startsWith('zh-tw') || p.startsWith('zh-hk') || p.startsWith('zh-hant')))
          return true;
        if (
          lang === 'zh' &&
          p.startsWith('zh') &&
          !p.startsWith('zh-tw') &&
          !p.startsWith('zh-hk') &&
          !p.startsWith('zh-hant')
        )
          return true;
        if (lang !== 'zh' && lang !== 'zh-tw' && p.startsWith(lang)) return true;
      }
      return false;
    }

    // ClientRouter swaps the DOM without re-running identical inline scripts,
    // so the show/hide decision and listeners must re-run on every
    // astro:page-load against the freshly swapped-in banner. The dataset flag
    // keeps the initial full load (direct call + astro:page-load both firing)
    // from double-binding; the window flag keeps re-evaluations of this
    // script (leaving and re-entering pages that render it) from stacking
    // astro:page-load listeners.
    function boot() {
      const banner = document.getElementById('lang-banner');
      if (!banner || banner.dataset.langBannerReady) return;
      banner.dataset.langBannerReady = '1';

      const currentLang = banner.dataset.currentLang;
      const candidates = JSON.parse(banner.dataset.suggestLocales || '[]');

      const stored = localStorage.getItem('sgai_lang');
      if (stored) return;

      const prefs = (navigator.languages?.length ? navigator.languages : [navigator.language]).map((l) =>
        l.toLowerCase()
      );
      if (prefersLang(prefs, currentLang)) return;

      const suggestLang = candidates.find((lang) => prefersLang(prefs, lang));
      if (!suggestLang) return;

      document.getElementById('lang-banner-msg').textContent = BANNER_MESSAGES[suggestLang] || '';
      const switchEl = document.getElementById('lang-banner-switch');
      switchEl.textContent = SWITCH_LABELS[suggestLang] || '';
      banner.classList.remove('hidden');

      switchEl?.addEventListener('click', (e) => {
        e.preventDefault();
        localStorage.setItem('sgai_lang', suggestLang);
        location.assign(localeUrl(suggestLang));
      });
      document.getElementById('lang-banner-dismiss')?.addEventListener('click', () => {
        localStorage.setItem('sgai_lang', currentLang);
        banner.classList.add('hidden');
      });
    }

    boot();
    if (!window.__sgaiLangBannerBound) {
      window.__sgaiLangBannerBound = true;
      document.addEventListener('astro:page-load', boot);
    }
  })();
</script>
