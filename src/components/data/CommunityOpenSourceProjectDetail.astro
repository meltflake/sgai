---
import { Icon } from 'astro-icon/components';

import EcosystemProse from '~/components/data/EcosystemProse.astro';
import { localizedHref, pickLocalized, t, type Lang } from '~/i18n';
import {
  allCommunityOpenSourceProjects,
  type CommunityOpenSourceResource,
  type OpenSourceProject,
} from '~/data/community-opensource';

interface Props {
  project: OpenSourceProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
// All user-visible fields carry *Ja / *Ko siblings, so pickLocalized resolves
// every locale (zh-tw via OpenCC). No en fallback leaks → no marker needed.
const displayName = pickLocalized(project, 'name', lang) || project.name;
const org = pickLocalized(project, 'org', lang) || project.org;
const category = pickLocalized(project, 'category', lang) || project.category;
const status = pickLocalized(project, 'status', lang) || project.status;
const description = pickLocalized(project, 'description', lang) || project.description;
const summary = pickLocalized(project, 'summary', lang) || project.summary;
const whatItIs = pickLocalized(project, 'whatItIs', lang) || project.whatItIs;
const aiRelevance = pickLocalized(project, 'aiRelevance', lang) || project.aiRelevance;
const singaporeRelevance = pickLocalized(project, 'singaporeRelevance', lang) || project.singaporeRelevance;
const license = pickLocalized(project, 'license', lang) || project.license;
const relatedProjects = allCommunityOpenSourceProjects
  .filter((candidate) => candidate.id !== project.id && candidate.orgType === project.orgType)
  .slice(0, 4);

const orgTypeKey: Record<
  OpenSourceProject['orgType'],
  'osOrgTypeUniversity' | 'osOrgTypeCorporateLab' | 'osOrgTypeStartup'
> = {
  university: 'osOrgTypeUniversity',
  'corporate-lab': 'osOrgTypeCorporateLab',
  startup: 'osOrgTypeStartup',
};

const labels = {
  back: t(lang, 'osCommunityBack'),
  profile: t(lang, 'osCommunityProfile'),
  org: t(lang, 'osOrg'),
  orgType: t(lang, 'osOrgType'),
  category: t(lang, 'osCategory'),
  status: t(lang, 'osStatus'),
  founded: t(lang, 'osFounded'),
  language: t(lang, 'osLanguage'),
  license: t(lang, 'osLicense'),
  stars: 'GitHub Stars',
  updated: t(lang, 'osUpdated'),
  whatItIs: t(lang, 'osWhatItIs'),
  aiRelevance: t(lang, 'osAiRelevance'),
  singaporeRelevance: t(lang, 'osSingaporeRelevance'),
  milestones: t(lang, 'osMilestones'),
  resources: t(lang, 'osResources'),
  related: t(lang, 'osCommunityRelated'),
};

function hrefFor(resource: CommunityOpenSourceResource): string {
  return resource.url.startsWith('/') ? localizedHref(resource.url, lang) : resource.url;
}

function isExternal(url: string): boolean {
  return /^https?:\/\//.test(url);
}

const facts = [
  { label: labels.org, value: org },
  { label: labels.orgType, value: t(lang, orgTypeKey[project.orgType]) },
  { label: labels.category, value: category },
  { label: labels.status, value: status },
  { label: labels.founded, value: project.founded },
  { label: labels.language, value: project.language },
  { label: labels.license, value: license },
  { label: labels.stars, value: typeof project.stars === 'number' ? project.stars.toLocaleString() : undefined },
  { label: labels.updated, value: project.updated },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));
---

<article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-12">
  <div class="mb-6 flex flex-wrap items-center gap-2 text-xs">
    <a
      href={localizedHref('/community-opensource/', lang)}
      class="inline-flex items-center gap-1 bg-primary/10 text-primary px-3 py-1.5 rounded font-semibold hover:bg-primary/15 transition-colors"
    >
      <Icon name="tabler:arrow-left" class="w-3.5 h-3.5" />
      {labels.back}
    </a>
    <span class="bg-slate-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-3 py-1.5 rounded">
      {category}
    </span>
    <span
      class="bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300 px-3 py-1.5 rounded font-medium"
    >
      {status}
    </span>
  </div>

  <p class="text-sm uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold mb-2">{labels.profile}</p>
  <h1 class="t-display text-gray-900 dark:text-white mb-3">{displayName}</h1>
  <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-8">{description}</p>

  {
    project.metrics && project.metrics.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
        {project.metrics.map((metric) => (
          <div class="bg-surface rounded-lg border border-subtle p-4">
            <div class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">
              {pickLocalized(metric, 'label', lang) || metric.label}
            </div>
            <div class="t-stat text-primary">{pickLocalized(metric, 'value', lang) || metric.value}</div>
            {pickLocalized(metric, 'note', lang) && (
              <div class="text-xs text-muted mt-1">{pickLocalized(metric, 'note', lang)}</div>
            )}
          </div>
        ))}
      </div>
    )
  }

  <dl
    class="bg-surface rounded-lg border border-subtle p-5 mb-8 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm"
  >
    {
      facts.map((fact) => (
        <div>
          <dt class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">{fact.label}</dt>
          <dd class="text-gray-900 dark:text-white">{fact.value}</dd>
        </div>
      ))
    }
  </dl>

  <p
    class="font-serif text-lg leading-[1.85] text-gray-800 dark:text-gray-200 mb-8 border-l-4 border-primary pl-5 italic"
  >
    {summary}
  </p>

  <section class="mb-10">
    <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.whatItIs}</h2>
    <EcosystemProse content={whatItIs} />
  </section>

  <section class="mb-10">
    <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.aiRelevance}</h2>
    <EcosystemProse content={aiRelevance} />
  </section>

  <section class="mb-10">
    <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.singaporeRelevance}</h2>
    <EcosystemProse content={singaporeRelevance} />
  </section>

  {
    project.milestones && project.milestones.length > 0 && (
      <section class="mb-10">
        <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.milestones}</h2>
        <ol class="relative border-l-2 border-primary/30 ml-2 pl-6 space-y-5">
          {project.milestones.map((m) => (
            <li class="relative">
              <span class="absolute -left-[33px] top-1 w-3 h-3 rounded-full bg-primary ring-4 ring-primary/10" />
              <div class="text-xs font-mono text-gray-500 dark:text-gray-400 mb-1">{m.date}</div>
              <div class="font-semibold text-gray-900 dark:text-white">
                {pickLocalized(m, 'title', lang) || m.title}
              </div>
              {pickLocalized(m, 'description', lang) && (
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 leading-relaxed">
                  {pickLocalized(m, 'description', lang)}
                </p>
              )}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="mb-10 pt-6 border-t border-subtle">
    <h2 class="text-sm uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold mb-3">
      {labels.resources}
    </h2>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        project.resources.map((resource) => {
          const href = hrefFor(resource);
          const external = isExternal(href);
          return (
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
              class="flex items-center justify-between gap-3 bg-surface rounded-lg border border-subtle p-4 hover:border-primary/40 hover:shadow-sm transition-all"
            >
              <span class="text-sm font-medium text-gray-900 dark:text-white">
                {pickLocalized(resource, 'label', lang) || resource.label}
              </span>
              <Icon name={external ? 'tabler:external-link' : 'tabler:arrow-right'} class="w-4 h-4 text-primary" />
            </a>
          );
        })
      }
    </div>
  </section>

  {
    relatedProjects.length > 0 && (
      <section class="mb-10">
        <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.related}</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {relatedProjects.map((related) => (
            <a
              href={localizedHref(`/community-opensource/${related.id}/`, lang)}
              class="group bg-surface rounded-lg border border-subtle p-4 hover:border-primary/40 hover:shadow-sm transition-all"
            >
              <p class="text-xs text-muted mb-1">{pickLocalized(related, 'org', lang) || related.org}</p>
              <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-primary">
                {pickLocalized(related, 'name', lang) || related.name}
              </h3>
              <p class="text-xs text-muted mt-1">{pickLocalized(related, 'category', lang) || related.category}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</article>
