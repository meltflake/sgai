---
import { Icon } from 'astro-icon/components';

import Headline from '~/components/ui/Headline.astro';
import Layout from '~/layouts/PageLayout.astro';
import CrossDomainRail from '~/components/listing/CrossDomainRail.astro';
import LatestAdditions from '~/components/listing/LatestAdditions.astro';
import { programmes, talentDataDate, type TalentStatusTone } from '~/data/talent';
import { latestJobsSnapshot, previousJobsSnapshot, METHODOLOGY_VERSION, type RoleTypeId } from '~/data/ai-jobs-index';
import { localizedHref, pickLocalized, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// AI Jobs Index demand-side section (renders only after the first capture).
const jobsSnapshot = latestJobsSnapshot();
const prevSnapshot = previousJobsSnapshot();
const momDelta = jobsSnapshot && prevSnapshot ? jobsSnapshot.totalOpenings - prevSnapshot.totalOpenings : null;
const ROLE_LABEL_KEY: Record<RoleTypeId, Parameters<typeof t>[1]> = {
  engineering: 'jobsRoleEngineering',
  research: 'jobsRoleResearch',
  data: 'jobsRoleData',
  product: 'jobsRoleProduct',
  gtm: 'jobsRoleGtm',
  'ops-other': 'jobsRoleOpsOther',
};
const pickStringArray = (record: unknown, field: string, fallback: string[]): string[] =>
  (pickLocalized(record, field, lang) as string[] | null | undefined) || fallback;

const statusClasses: Record<TalentStatusTone, string> = {
  active: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-200',
  scheduled: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-200',
  closed: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
  evergreen: 'bg-teal-100 text-teal-800 dark:bg-teal-900/30 dark:text-teal-200',
};

// One-off headline copy (distinct from the shorter talentPageTitle dict key
// used for <title>/breadcrumbs) — page-local per-locale template.
const HEADLINE: Record<Lang, string> = {
  zh: 'AI 人才培养',
  en: 'AI Talent Pipeline',
  ja: 'AI 人材育成',
  'zh-tw': toTraditional('AI 人才培养'),
  ko: 'AI 인재 양성',
};
const SUBTITLE: Record<Lang, string> = {
  zh: '新加坡 AI 人才体系不是一条线，而是一组可追踪的项目入口：学生、教师、职业转型、企业内训、本硕博研究，各自有承办方、门槛和交付物。',
  en: "Singapore's AI talent system is not a single path. It is a set of trackable project entry points: students, educators, career switchers, enterprise teams, and research talent from undergraduate to PhD.",
  ja: 'シンガポールの AI 人材システムは一本道ではなく、学生、教育者、キャリアチェンジ、企業内チーム、学部から博士までの研究人材まで、それぞれ担当機関・要件・成果物を持つ追跡可能なプロジェクトの入り口の集合です。',
  'zh-tw': toTraditional(
    '新加坡 AI 人才体系不是一条线，而是一组可追踪的项目入口：学生、教师、职业转型、企业内训、本硕博研究，各自有承办方、门槛和交付物。'
  ),
  ko: '싱가포르의 AI 인재 시스템은 하나의 경로가 아니라 추적 가능한 여러 프로젝트 진입점의 집합입니다: 학생, 교육자, 커리어 전환자, 기업 내부 교육, 학부부터 박사까지의 연구 인재 — 각각 담당 기관, 요건, 결과물을 갖습니다.',
};
---

<Layout
  metadata={{
    title: t(lang, 'talentPageTitle'),
    description: t(lang, 'talentPageDesc'),
  }}
  breadcrumbs={[{ label: t(lang, 'navTalent') }]}
  lang={lang}
>
  <section class="px-4 py-14 sm:px-6 mx-auto lg:px-8 max-w-6xl">
    <Headline title={HEADLINE[lang]} subtitle={SUBTITLE[lang]} />
    <LatestAdditions lang={lang} source="talent" class="mt-8 mb-2" />

    <div class="grid gap-5 md:grid-cols-2">
      {
        programmes.map((prog) => (
          <a
            href={localizedHref(`/talent/${prog.id}/`, lang)}
            class="group flex h-full flex-col bg-surface rounded-lg border border-subtle shadow-sm hover:shadow-md hover:border-primary/40 transition-all overflow-hidden focus-visible:outline-primary"
          >
            <div class="p-5 sm:p-6 flex-1 flex flex-col">
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex gap-3 min-w-0">
                  <div class="w-11 h-11 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                    <Icon name={prog.icon} class="w-6 h-6" />
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs uppercase tracking-[0.14em] text-muted font-semibold mb-1">
                      {pickLocalized(prog, 'category', lang)}
                    </p>
                    <h3 class="t-h3 text-gray-900 dark:text-white">{pickLocalized(prog, 'name', lang)}</h3>
                    {lang === 'zh' && <p class="text-sm text-muted mt-1">{prog.nameEn}</p>}
                    {lang !== 'zh' && prog.shortName && <p class="text-sm text-muted mt-1">{prog.shortName}</p>}
                  </div>
                </div>
                <span
                  class={`text-xs font-medium px-2.5 py-1 rounded whitespace-nowrap ${statusClasses[prog.statusTone]}`}
                >
                  {pickLocalized(prog, 'status', lang)}
                </span>
              </div>

              <p class="text-sm leading-relaxed text-gray-700 dark:text-gray-300 mb-5">
                {pickLocalized(prog, 'description', lang)}
              </p>

              <div class="grid grid-cols-2 gap-2 mb-5">
                {prog.stats.slice(0, 4).map((stat) => (
                  <div class="rounded-md bg-slate-50 dark:bg-slate-800/70 p-3">
                    <div class="text-base font-semibold text-gray-900 dark:text-white">
                      {pickLocalized(stat, 'value', lang) || stat.value}
                    </div>
                    <div class="text-xs text-muted mt-1">{pickLocalized(stat, 'label', lang)}</div>
                  </div>
                ))}
              </div>

              <ul class="text-sm space-y-2 mb-5">
                {pickStringArray(prog, 'highlights', prog.highlights)
                  .slice(0, 3)
                  .map((h) => (
                    <li class="flex items-start gap-2 text-gray-700 dark:text-gray-300">
                      <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary shrink-0" />
                      <span>{h}</span>
                    </li>
                  ))}
              </ul>

              <div class="mt-auto pt-4 border-t border-subtle flex items-center justify-between gap-3">
                <span class="text-xs text-muted">{pickLocalized(prog, 'owner', lang)}</span>
                <span class="inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:text-secondary">
                  {t(lang, 'openProfileCta')}
                  <Icon name="tabler:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-muted text-center">
      {t(lang, 'talentSourcesNote').replace('{date}', talentDataDate)}
    </p>

    {
      /* Demand-side monthly snapshot from the AI Jobs Index. Renders only
        after the first pipeline capture; QoQ views unlock later as the
        series accumulates (see src/data/ai-jobs-index.ts methodology). */
      jobsSnapshot && (
        <div class="mt-14 pt-10 border-t border-subtle" id="jobs-index">
          <h2 class="t-h3 text-gray-900 dark:text-white mb-2">{t(lang, 'jobsIndexHeading')}</h2>
          <p class="text-sm text-muted max-w-3xl mb-6">{t(lang, 'jobsIndexIntro')}</p>

          <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-8">
            <div class="rounded-lg border border-subtle bg-surface p-4">
              <dt class="text-xs uppercase tracking-wider text-muted">{t(lang, 'jobsIndexTotalLabel')}</dt>
              <dd class="mt-1 t-stat text-gray-900 dark:text-white">
                {jobsSnapshot.totalOpenings.toLocaleString('en-SG')}
              </dd>
              {momDelta !== null && (
                <dd class={`text-xs mt-1 ${momDelta >= 0 ? 'text-emerald-600' : 'text-red-500'}`}>
                  {momDelta >= 0 ? '+' : ''}
                  {momDelta.toLocaleString('en-SG')} {t(lang, 'jobsIndexMoMLabel')}
                </dd>
              )}
            </div>
            <div class="rounded-lg border border-subtle bg-surface p-4">
              <dt class="text-xs uppercase tracking-wider text-muted">{t(lang, 'jobsIndexMedianLabel')}</dt>
              <dd class="mt-1 t-stat text-gray-900 dark:text-white">
                {jobsSnapshot.salaryMidpointMedian
                  ? `S$${jobsSnapshot.salaryMidpointMedian.toLocaleString('en-SG')}`
                  : '—'}
              </dd>
            </div>
            <div class="rounded-lg border border-subtle bg-surface p-4">
              <dt class="text-xs uppercase tracking-wider text-muted">{t(lang, 'jobsIndexBandLabel')}</dt>
              <dd class="mt-1 text-lg font-semibold text-gray-900 dark:text-white">
                {jobsSnapshot.salaryMidpointP25 && jobsSnapshot.salaryMidpointP75
                  ? `S$${jobsSnapshot.salaryMidpointP25.toLocaleString('en-SG')} – S$${jobsSnapshot.salaryMidpointP75.toLocaleString('en-SG')}`
                  : '—'}
              </dd>
            </div>
            <div class="rounded-lg border border-subtle bg-surface p-4">
              <dt class="text-xs uppercase tracking-wider text-muted">{t(lang, 'jobsIndexDisclosureLabel')}</dt>
              <dd class="mt-1 t-stat text-gray-900 dark:text-white">
                {(jobsSnapshot.salaryDisclosureRate * 100).toFixed(0)}%
              </dd>
            </div>
          </dl>

          <div class="grid gap-8 md:grid-cols-2">
            <div>
              <h3 class="font-serif text-base font-semibold text-gray-900 dark:text-white mb-3">
                {t(lang, 'jobsIndexTopEmployersLabel')}
              </h3>
              <ol class="space-y-1.5">
                {jobsSnapshot.topEmployers.map((e, i) => (
                  <li class="flex items-baseline justify-between gap-3 text-sm">
                    <span class="text-gray-700 dark:text-gray-300 truncate">
                      <span class="text-muted tabular-nums mr-2">{i + 1}.</span>
                      {e.employer}
                    </span>
                    <span class="tabular-nums text-muted shrink-0">{e.openings}</span>
                  </li>
                ))}
              </ol>
            </div>
            <div>
              <h3 class="font-serif text-base font-semibold text-gray-900 dark:text-white mb-3">
                {t(lang, 'jobsIndexRolesLabel')}
              </h3>
              <ul class="space-y-2">
                {jobsSnapshot.roleTypes.map((r) => (
                  <li class="text-sm">
                    <div class="flex items-baseline justify-between gap-3 mb-1">
                      <span class="text-gray-700 dark:text-gray-300">{t(lang, ROLE_LABEL_KEY[r.roleType])}</span>
                      <span class="tabular-nums text-muted">{r.count}</span>
                    </div>
                    <div class="h-1.5 rounded bg-gray-100 dark:bg-slate-800 overflow-hidden">
                      <div
                        class="h-full bg-primary/70"
                        style={`width: ${Math.max(2, Math.round((r.count / jobsSnapshot.totalOpenings) * 100))}%`}
                      />
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {!prevSnapshot && <p class="mt-6 text-xs text-muted">{t(lang, 'jobsIndexAccumulating')}</p>}
          <p class="mt-2 text-xs text-muted">
            {t(lang, 'jobsIndexMethodNote')
              .replace('{v}', String(METHODOLOGY_VERSION))
              .replace('{month}', jobsSnapshot.month)}{' '}
            <a
              href={jobsSnapshot.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:text-secondary underline underline-offset-2"
            >
              MyCareersFuture ↗
            </a>
          </p>
        </div>
      )
    }
  </section>
  <CrossDomainRail lang={lang} current="talent" class="max-w-6xl mx-auto px-4 sm:px-6 pb-16" />
</Layout>
