// For zh-tw render: run every string value of L_RAW through OpenCC. This
// avoids duplicating the entire 60-key dict for a locale that's a
// deterministic char-conversion of zh.
if (isZhTw) {
  for (const k of Object.keys(L_RAW)) {
    const v = (L_RAW as Record<string, string>)[k];
    if (typeof v === 'string') (L_RAW as Record<string, string>)[k] = toTraditional(v);
  }
}
const L = L_RAW;

// Shared utility module for type/topic labels handles 5 locales (zh-tw via
// OpenCC, ko via hand translation, others as-is). Reuse from there.
import { debateTypeLabel as _typeFn } from '~/utils/debate-labels';
const TYPE_KEYS = ['Oral Answers to Questions', 'Written Answers to Questions', 'Budget', 'Motions'];
const typeMap: Record<string, string> = Object.fromEntries(TYPE_KEYS.map((k) => [k, _typeFn(k, lang)]));

const CONTROVERSY_LABELS: Record<Lang, Record<number, string>> = {
  zh: { 1: '信息发布', 2: '温和质询', 3: '实质辩论', 4: '激烈争议', 5: '高度对立' },
  en: { 1: 'Information', 2: 'Mild scrutiny', 3: 'Substantive debate', 4: 'Heated controversy', 5: 'Sharp opposition' },
  ja: { 1: '情報発信', 2: '穏やかな質問', 3: '実質的な討論', 4: '激しい論争', 5: '対立' },
  'zh-tw': {
    1: toTraditional('信息发布'),
    2: toTraditional('温和质询'),
    3: toTraditional('实质辩论'),
    4: toTraditional('激烈争议'),
    5: toTraditional('高度对立'),
  },
  ko: { 1: '정보 공개', 2: '온건한 질의', 3: '실질적 토론', 4: '치열한 논쟁', 5: '강한 대립' },
};
const controversyLabels: Record<number, string> = CONTROVERSY_LABELS[lang] || CONTROVERSY_LABELS.en;

const controversyColors: Record<number, string> = {
  1: 'bg-surface text-muted border border-subtle',
  2: 'bg-surface text-muted border border-subtle',
  3: 'bg-surface text-default border border-subtle',
  4: 'bg-primary/10 text-primary border border-primary/30',
  5: 'bg-primary/15 text-primary border border-primary/40 font-semibold',
};

const statusColors: Record<string, string> = {
  ongoing: 'bg-surface text-muted border border-subtle',
  escalating: 'bg-primary/10 text-primary border border-primary/30',
  resolved: 'bg-surface text-default border border-subtle',
};

const STATUS_LABELS: Record<Lang, Record<string, string>> = {
  zh: { ongoing: '持续讨论中', escalating: '争议升级', resolved: '已有定论' },
  en: { ongoing: 'Ongoing', escalating: 'Escalating', resolved: 'Resolved' },
  ja: { ongoing: '討論継続中', escalating: '争点エスカレーション', resolved: '定論済み' },
  'zh-tw': {
    ongoing: toTraditional('持续讨论中'),
    escalating: toTraditional('争议升级'),
    resolved: toTraditional('已有定论'),
  },
  ko: { ongoing: '논의 중', escalating: '쟁점 격화', resolved: '결론 도출' },
};
const statusLabels: Record<string, string> = STATUS_LABELS[lang] || STATUS_LABELS.en;

const significanceColors: Record<string, string> = {
  high: 'border-l-primary',
  medium: 'border-l-subtle',
  low: 'border-l-subtle',
};

// Topic labels reuse the shared debate-labels helper (supports all 5 locales).
import { debateTopicLabel as _topicFn } from '~/utils/debate-labels';
const TOPIC_KEYS = [
  'AI Economy & Industry',
  'AI & Employment',
  'AI Governance & Regulation',
  'AI & National Security',
  'AI in Public Sector',
  'AI Infrastructure & Research',
  'AI Safety & Ethics',
  'AI in Education',
  'AI in Healthcare',
  'AI Strategy',
  'Deepfakes & Disinformation',
];
const topicLabels: Record<string, string> = Object.fromEntries(TOPIC_KEYS.map((k) => [k, _topicFn(k, lang)]));

const topicCounts = new Map<string, number>();
for (const d of debates) {
  for (const topic of new Set(d.topics || [])) {
    topicCounts.set(topic, (topicCounts.get(topic) || 0) + 1);
  }
}

const topicEntries = Object.entries(topicLabels)
  .map(([topic, label]) => ({ topic, label, count: topicCounts.get(topic) || 0 }))
  .filter((entry) => entry.count > 0)
  .sort((a, b) => b.count - a.count);

const maxCount = Math.max(...Object.values(DEBATE_STATS.byYear));

// Initial render window: cards past this index ship with `hidden` so the
// unfiltered page stays light (the archive is 179+ cards and grows weekly).
// The client script reveals them when a filter/search is active or the
// "show earlier" button is pressed.
const DEFAULT_VISIBLE = 25;
const earlierCount = Math.max(0, debates.length - DEFAULT_VISIBLE);
const latestDate = debates[0]?.date || String(DEBATE_STATS.yearRange.to);
const latestYear = latestDate.slice(0, 4);

const controversyDebateCounts = RECURRING_CONTROVERSIES.map((c) => {
  const relTopics = (c as { relatedTopics: string[] }).relatedTopics || [];
  return debates.filter((d) => relTopics.some((topic) => d.topics.includes(topic))).length;
});

const speakerCounts = new Map<string, number>();
for (const d of debates) {
  for (const speaker of d.speakers) {
    if (speaker && speaker.length > 1) {
      speakerCounts.set(speaker, (speakerCounts.get(speaker) || 0) + 1);
    }
  }
}

const frequentSpeakers = [...speakerCounts.entries()]
  .filter(([, count]) => count >= 3)
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

const QUICK_FILTER_LABELS: Record<Lang, string[]> = {
  en: [
    'Latest sitting',
    'Data sovereignty',
    'Employment',
    'Governance',
    'National security',
    'Healthcare',
    'High controversy',
  ],
  zh: ['最新场次', '数据主权', '就业', '治理', '国家安全', '医疗', '高争议'],
  ja: ['最新の議会', 'データ主権', '雇用', 'ガバナンス', '国家安全保障', '医療', '高争点'],
  'zh-tw': [
    toTraditional('最新场次'),
    toTraditional('数据主权'),
    toTraditional('就业'),
    toTraditional('治理'),
    toTraditional('国家安全'),
    toTraditional('医疗'),
    toTraditional('高争议'),
  ],
  ko: ['최신 회기', '데이터 주권', '고용', '거버넌스', '국가 안보', '의료', '높은 논쟁'],
};
const _qfl = QUICK_FILTER_LABELS[lang] || QUICK_FILTER_LABELS.en;
// Search keyword for the "data sovereignty" quick-filter. Kept English on
// non-Chinese locales because the searchBlob is lowercased and the source
// data uses the English term — ja/ko/en pages match against that.
const QUICK_DATA_SOV_KW: Record<Lang, string> = {
  zh: '数据主权',
  en: 'data sovereignty',
  ja: 'data sovereignty',
  'zh-tw': toTraditional('数据主权'),
  ko: 'data sovereignty',
};
const QUICK_DATA_SOV = QUICK_DATA_SOV_KW[lang] || QUICK_DATA_SOV_KW.en;
const quickFilters = [
  { label: _qfl[0], dimension: 'keyword', value: latestDate },
  { label: latestYear, dimension: 'year', value: latestYear },
  { label: _qfl[1], dimension: 'keyword', value: QUICK_DATA_SOV },
  { label: _qfl[2], dimension: 'topic', value: 'AI & Employment' },
  { label: _qfl[3], dimension: 'topic', value: 'AI Governance & Regulation' },
  { label: _qfl[4], dimension: 'topic', value: 'AI & National Security' },
  { label: _qfl[5], dimension: 'topic', value: 'AI in Healthcare' },
  { label: _qfl[6], dimension: 'controversy', value: '4' },
];

const jsAttr = (s: string) => String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'");

const truncate = (text: string | null | undefined, max: number) => {
  const s = String(text || '')
    .replace(/\s+/g, ' ')
    .trim();
  return s.length > max ? `${s.slice(0, max).trim()}...` : s;
};

// Field pickers go through pickLocalized to support all 5 locales. The
// pickLocalized shape-B form (4-arg) walks FALLBACK_CHAINS automatically
// so each call covers ja/ko/zh-tw/en/zh.
const debateTitle = (d: (typeof debates)[number]) => pickLocalized<string>(d, 'title', 'titleEn', lang) || d.title;
const debateSummary = (d: (typeof debates)[number]) =>
  pickLocalized<string>(d, 'summary', 'summaryEn', lang) || d.summary || '';
const debateSignal = (d: (typeof debates)[number]) =>
  pickLocalized<string>(d, 'policySignal', 'policySignalEn', lang) || d.policySignal;
const debateQuote = (d: (typeof debates)[number]) =>
  pickLocalized<string>(d, 'notableQuote', 'notableQuoteEn', lang) || d.notableQuote;
const debateKeyPoints = (d: (typeof debates)[number]) =>
  pickLocalized<string[]>(d, 'keyPoints', 'keyPointsEn', lang) || d.keyPoints;
const debateGovStance = (d: (typeof debates)[number]) =>
  pickLocalized<string>(d, 'governmentStance', 'governmentStanceEn', lang) || d.governmentStance;
const debateOppStance = (d: (typeof debates)[number]) =>
  pickLocalized<string>(d, 'oppositionStance', 'oppositionStanceEn', lang) || d.oppositionStance;

// MP card helpers — defined at top-level so the JSX template doesn't
// inline-declare them and trip Astro's TS-in-JSX parser.
const DEBATES_COUNT_LABEL: Record<Lang, string> = {
  zh: '次发言',
  en: 'debates',
  ja: '次発言',
  'zh-tw': toTraditional('次发言'),
  ko: '회 발언',
};
function mpFocusAreas(mp: (typeof MP_PROFILES)[number]): string[] {
  return pickLocalized<string[]>(mp, 'focusAreas', 'focusAreasEn', lang) || mp.focusAreas;
}
function mpDisplayName(mp: (typeof MP_PROFILES)[number]): string {
  if (isZh) return mp.name || mp.nameEn;
  return pickLocalized<string>(mp, 'name', 'nameEn', lang) || mp.nameEn || mp.name;
}
function mpRoleLabel(mp: (typeof MP_PROFILES)[number]): string {
  const localized = pickLocalized<string>(mp, 'role', 'roleEn', lang);
  if (localized) return localized;
  return mp.roleEn || (mp.role === '反对党' ? 'Opposition' : 'Ruling party');
}

const searchBlob = (d: (typeof debates)[number]) => {
  // Build search blob from locale-appropriate text so the data-search
  // attribute matches what the user sees. On zh-tw, run the bare zh
  // title through OpenCC so the blob matches the displayed Traditional
  // form; on other locales the locale-picker yields the right text.
  const titleField = lang === 'zh-tw' && d.title ? toTraditional(d.title) : debateTitle(d);
  return [
    d.date,
    d.type,
    titleField,
    d.titleEn,
    debateSummary(d),
    debateSignal(d),
    ...(d.topics || []),
    ...(d.speakers || []),
    ...(debateKeyPoints(d) || []),
  ]
    .join(' ')
    .toLowerCase();
};

const speakerDisplay = (raw: string) => {
  const pid = findPersonId(raw);
  const person = pid ? getPerson(pid) : undefined;
  // Speaker display: prefer the locale's curated `name*` field, falling
  // back to nameEn (Latin form — universally readable). zh keeps the
  // bare zh name; non-zh locales prefer the Latin form for Singapore
  // press standard recognisability.
  const label = person
    ? isZh
      ? person.name || person.nameEn || raw
      : pickLocalized<string>(person, 'name', 'nameEn', lang) || person.nameEn || raw
    : raw;
  const href = pid ? localizedHref(`/voices/${pid}/`, lang) : null;
  return { label, href, title: raw };
};

const debateHref = (id: string) => localizedHref(`/debates/${id}/`, lang);
const yearRangeLabel = `${DEBATE_STATS.yearRange.from}-${DEBATE_STATS.yearRange.to}`;
const typeMixLabel = Object.entries(DEBATE_STATS.byType)
  .map(([type, count]) => `${typeMap[type] || type} ${count}`)
  .join(' / ');
---

<Layout metadata={meta} breadcrumbs={[{ label: L.crumb }]} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 py-8 md:py-10 overflow-x-hidden">
    <div
      class="mb-6 flex flex-col gap-2 rounded-lg bg-blue-50 dark:bg-slate-800 border border-blue-200 dark:border-slate-600 px-4 py-3 md:flex-row md:items-center md:justify-between md:px-5"
    >
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
        <span class="font-semibold text-blue-800 dark:text-blue-300">{L.updated}: {DATA_UPDATED}</span>
        <span class="text-gray-500 dark:text-gray-400">{DEBATE_STATS.total} {L.recordCount}</span>
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
        <span>
          {L.source}: <a href="https://sprs.parl.gov.sg/search/" target="_blank" class="text-blue-600 hover:underline"
            >SPRS Hansard</a
          > · <a href="https://search.pair.gov.sg/" target="_blank" class="text-blue-600 hover:underline">PAIR Search</a
          >
        </span>
        <span class="hidden text-gray-300 dark:text-gray-600 sm:inline">|</span>
        <span>{L.digestNote}</span>
      </div>
    </div>

    <header class="mb-6 md:mb-8">
      <div class="flex items-center gap-3 mb-3 min-w-0">
        <span class="text-3xl md:text-4xl shrink-0">🏛️</span>
        <h1 class="t-h1 text-gray-900 dark:text-white min-w-0">{L.title}</h1>
      </div>
      <p class="text-gray-600 dark:text-gray-400 text-base md:text-lg max-w-3xl leading-relaxed">{L.intro}</p>
    </header>

    <section
      class="mb-7 rounded-xl border border-subtle bg-surface p-4 shadow-sm md:p-5"
      aria-labelledby="debate-finder-title"
    >
      <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="debate-finder-title" class="t-h3 text-gray-900 dark:text-white">{L.finderTitle}</h2>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{L.finderHint}</p>
        </div>
        <button
          id="clear-filters-btn"
          onclick="clearFilters()"
          class="hidden self-start rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-500 transition-all hover:border-red-400 hover:text-red-700 md:self-auto"
        >
          {L.clear}
        </button>
      </div>

      <div class="grid grid-cols-1 gap-3 md:grid-cols-12">
        <input
          id="search-input"
          type="text"
          placeholder={L.searchPlaceholder}
          class="min-w-0 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-200 md:col-span-5"
        />
        <select
          id="type-filter"
          class="min-w-0 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-200 md:col-span-2"
        >
          <option value="">{L.allTypes}</option>
          {Object.entries(typeMap).map(([type, label]) => <option value={type}>{label}</option>)}
        </select>
        <select
          id="topic-filter"
          class="min-w-0 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-200 md:col-span-3"
        >
          <option value="">{L.allTopics}</option>
          {topicEntries.map((entry) => <option value={entry.topic}>{entry.label}</option>)}
        </select>
        <select
          id="year-filter"
          class="min-w-0 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-200 md:col-span-2"
        >
          <option value="">{L.allYears}</option>
          {
            Object.keys(DEBATE_STATS.byYear)
              .sort()
              .reverse()
              .map((year) => <option value={year}>{year}</option>)
          }
        </select>
      </div>

      <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-12">
        <select
          id="speaker-filter"
          class="min-w-0 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-200 md:col-span-5"
        >
          <option value="">{L.allMps}</option>
          {
            frequentSpeakers.map((speaker) => (
              <option value={speaker.name}>
                {speaker.name} ({speaker.count})
              </option>
            ))
          }
        </select>
        <select
          id="controversy-filter"
          class="min-w-0 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-200 md:col-span-3"
        >
          <option value="">{L.allControversy}</option>
          <option value="4">{L.highControversy}</option>
          <option value="3">{L.midControversy}</option>
          <option value="1">{L.lowControversy}</option>
        </select>
        <div id="result-count" class="text-sm text-gray-500 md:col-span-4 md:self-center md:text-right"></div>
      </div>

      <div class="mt-4">
        <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">{L.quickTitle}</div>
        <div class="flex flex-wrap gap-2">
          {
            quickFilters.map((filter) => (
              <button
                onclick={`filterBy('${filter.dimension}','${jsAttr(filter.value)}')`}
                class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1.5 text-sm text-blue-700 transition-colors hover:border-blue-300 hover:bg-blue-100 dark:border-blue-900 dark:bg-blue-900/30 dark:text-blue-300"
              >
                {filter.label}
              </button>
            ))
          }
        </div>
      </div>

      <div
        id="active-filter-bar"
        class="mt-4 hidden rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 dark:border-blue-800 dark:bg-blue-900/20"
      >
        <span class="text-sm font-medium text-blue-700 dark:text-blue-300">{L.active}</span>
        <span id="active-filter-label" class="text-sm text-blue-600 dark:text-blue-400"></span>
      </div>
    </section>

    <section class="mb-7" aria-labelledby="topic-browser-title">
      <div class="mb-3 flex flex-col gap-1 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="topic-browser-title" class="t-h3 text-gray-800 dark:text-white">{L.topicTitle}</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">{L.topicHint}</p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        {
          topicEntries.map((entry) => (
            <button
              onclick={`filterBy('topic','${jsAttr(entry.topic)}')`}
              class="inline-flex items-center gap-1.5 rounded-full border border-indigo-100 bg-indigo-50 px-3 py-1.5 text-sm text-indigo-700 transition-all hover:border-indigo-400 hover:bg-indigo-100 dark:border-indigo-800 dark:bg-indigo-900/30 dark:text-indigo-300 dark:hover:bg-indigo-900/60"
            >
              {entry.label}
              <span class="rounded-full bg-indigo-200 px-1.5 py-0.5 text-xs text-indigo-700 dark:bg-indigo-800 dark:text-indigo-300">
                {entry.count}
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="mb-8 rounded-xl border border-subtle bg-surface p-4 shadow-sm md:p-5">
      <div class="mb-4 flex flex-col gap-1 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="t-h3 text-gray-800 dark:text-white">{L.overviewTitle}</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">{L.trendHint}</p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        <div class="rounded-lg border border-subtle bg-gray-50 p-3 dark:bg-slate-800/60">
          <div class="text-xs text-gray-500">{L.total}</div>
          <div class="mt-1 t-stat text-blue-600">{DEBATE_STATS.total}</div>
        </div>
        <div class="rounded-lg border border-subtle bg-gray-50 p-3 dark:bg-slate-800/60">
          <div class="text-xs text-gray-500">{L.years}</div>
          <div class="mt-1 text-lg font-semibold text-gray-900 dark:text-white">{yearRangeLabel}</div>
        </div>
        <div class="rounded-lg border border-subtle bg-gray-50 p-3 dark:bg-slate-800/60">
          <div class="text-xs text-gray-500">{L.updatedShort}</div>
          <div class="mt-1 text-lg font-semibold text-gray-900 dark:text-white">{DATA_UPDATED}</div>
        </div>
        <div class="rounded-lg border border-subtle bg-gray-50 p-3 dark:bg-slate-800/60">
          <div class="text-xs text-gray-500">{L.typeMix}</div>
          <div class="mt-1 text-xs leading-relaxed text-gray-700 dark:text-gray-300">{typeMixLabel}</div>
        </div>
      </div>

      <div class="mt-5">
        <div class="mb-2 text-sm font-semibold text-gray-700 dark:text-gray-200">{L.trendTitle}</div>
        <div class="grid h-28 grid-cols-12 items-end gap-1 sm:gap-2">
          {
            Object.entries(DEBATE_STATS.byYear)
              .sort()
              .map(([year, count]) => (
                <button
                  onclick={`filterBy('year','${year}')`}
                  class="group flex min-w-0 flex-col items-center gap-1"
                  title={`${year}: ${count}`}
                >
                  <span class="text-[10px] font-medium text-gray-500 group-hover:text-blue-600">{count}</span>
                  <div
                    class="w-full rounded-t-sm bg-gradient-to-t from-blue-500 to-purple-400 transition-transform group-hover:scale-105"
                    style={`height: ${Math.round((count / maxCount) * 76)}px; min-height: 4px;`}
                  />
                  <span class="text-[10px] text-gray-400 group-hover:text-blue-600">{year.slice(2)}</span>
                </button>
              ))
          }
        </div>
      </div>
    </section>

    <section id="debate-section" class="mb-12" aria-labelledby="debate-list-title">
      <div class="mb-4 flex flex-col gap-1 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="debate-list-title" class="t-h3 text-gray-800 dark:text-white">{L.listTitle}</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">{L.listHint}</p>
        </div>
      </div>

      <div id="debate-list" class="space-y-3">
        {
          debates.map((d, cardIndex) => {
            const cLevel = d.controversyLevel || 1;
            const cLabel = controversyLabels[cLevel] || 'Unknown';
            const cColor = controversyColors[cLevel] || 'bg-gray-100 text-gray-600';
            const yearStr = d.date.slice(0, 4);
            const title = debateTitle(d);
            const summary = debateSummary(d);
            const keyPoints = debateKeyPoints(d);
            const govStance = debateGovStance(d);
            const oppStance = debateOppStance(d);
            const signal = debateSignal(d);
            const quote = debateQuote(d);
            return (
              <article
                data-debate-card
                data-type={d.type}
                data-year={yearStr}
                data-controversy={cLevel}
                data-topics={(d.topics || []).join('|')}
                data-speakers={(d.speakers || []).join('|')}
                data-search={searchBlob(d)}
                hidden={cardIndex >= DEFAULT_VISIBLE}
                class="overflow-hidden rounded-xl border border-subtle bg-surface shadow-sm"
              >
                <div class="p-4 md:p-5">
                  <div class="mb-2 flex flex-wrap items-center gap-2">
                    <button
                      type="button"
                      onclick={`filterBy('type','${jsAttr(d.type)}')`}
                      class="rounded bg-slate-100 px-2 py-1 text-xs text-slate-600 transition-colors hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-400"
                    >
                      {typeMap[d.type] || d.type}
                    </button>
                    <button
                      type="button"
                      onclick={`filterBy('year','${yearStr}')`}
                      class="text-xs text-gray-500 transition-colors hover:text-blue-600 hover:underline"
                    >
                      {d.date}
                    </button>
                    <span class="text-xs text-gray-400">
                      {isZh || isZhTw ? `第 ${d.parliament} ${L.parliament}` : `${d.parliament} ${L.parliament}`}
                    </span>
                    <span class={`rounded-full px-2 py-0.5 text-xs ${cColor}`}>{cLabel}</span>
                  </div>

                  <h3 class="mb-2 text-base font-bold leading-snug text-gray-900 dark:text-white md:text-lg">
                    <a href={debateHref(d.id)} class="hover:text-primary">
                      {title}
                    </a>
                  </h3>

                  {/* Show original English title as secondary for non-en locales. */}
                  {!isEn && <p class="mb-2 text-xs italic text-gray-400">{truncate(d.titleEn || '', 120)}</p>}

                  <div class="mb-3 flex flex-wrap gap-1.5">
                    {(d.topics || []).map((topic) => (
                      <button
                        type="button"
                        onclick={`filterBy('topic','${jsAttr(topic)}')`}
                        class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs text-indigo-600 transition-colors hover:bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-400"
                      >
                        {topicLabels[topic] || topic}
                      </button>
                    ))}
                  </div>

                  <p class="text-sm leading-relaxed text-gray-700 dark:text-gray-300">
                    {truncate(summary, isEn ? 320 : 220)}
                  </p>

                  {signal && (
                    <div class="mt-3 inline-flex max-w-full rounded bg-purple-50 px-2 py-1 text-xs text-purple-600 dark:bg-purple-900/20 dark:text-purple-400">
                      <span class="min-w-0">
                        {L.signal}: {signal}
                      </span>
                    </div>
                  )}

                  <div class="mt-4 flex flex-col gap-3 border-t border-subtle pt-3 text-xs sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex min-w-0 flex-wrap items-center gap-1">
                      <span class="text-gray-400">🎙️</span>
                      {(d.speakers || []).slice(0, 5).map((speaker, index) => {
                        const display = speakerDisplay(speaker);
                        return (
                          <>
                            {index > 0 && <span class="text-gray-300">·</span>}
                            {display.href ? (
                              <a
                                href={display.href}
                                class="text-gray-500 transition-colors hover:text-purple-600 hover:underline"
                                title={display.title}
                              >
                                {display.label}
                              </a>
                            ) : (
                              <span class="text-gray-500" title={display.title}>
                                {display.label}
                              </span>
                            )}
                          </>
                        );
                      })}
                    </div>
                    <div class="flex shrink-0 flex-wrap gap-3">
                      <a href={debateHref(d.id)} class="text-blue-600 hover:underline">
                        {L.detailPage} →
                      </a>
                      {d.sourceUrl && (
                        <a href={d.sourceUrl} target="_blank" rel="noopener" class="text-blue-600 hover:underline">
                          {L.hansard} ↗
                        </a>
                      )}
                    </div>
                  </div>

                  <details class="mt-3 rounded-lg border border-subtle bg-gray-50 p-3 dark:bg-slate-700/40">
                    <summary class="cursor-pointer text-sm font-semibold text-gray-700 dark:text-gray-200">
                      {L.details}
                    </summary>
                    <div class="mt-3 space-y-3">
                      <p class="text-sm leading-relaxed text-gray-700 dark:text-gray-300">{summary}</p>

                      {keyPoints && keyPoints.length > 0 && (
                        <div>
                          <div class="mb-1 text-xs font-semibold text-gray-500">{L.keyPoints}</div>
                          <ul class="space-y-1">
                            {keyPoints.slice(0, 4).map((point) => (
                              <li class="text-xs text-gray-600 dark:text-gray-400">• {point}</li>
                            ))}
                          </ul>
                        </div>
                      )}

                      {(govStance || oppStance) && (
                        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                          {govStance && (
                            <div class="rounded-lg bg-blue-50 p-2.5 dark:bg-blue-900/20">
                              <div class="mb-1 text-xs font-semibold text-blue-600 dark:text-blue-400">
                                {L.government}
                              </div>
                              <div class="text-xs text-gray-700 dark:text-gray-300">{govStance}</div>
                            </div>
                          )}
                          {oppStance && (
                            <div class="rounded-lg bg-orange-50 p-2.5 dark:bg-orange-900/20">
                              <div class="mb-1 text-xs font-semibold text-orange-600 dark:text-orange-400">
                                {L.opposition}
                              </div>
                              <div class="text-xs text-gray-700 dark:text-gray-300">{oppStance}</div>
                            </div>
                          )}
                        </div>
                      )}

                      {quote && (
                        <blockquote class="border-l-2 border-gray-300 pl-3 text-xs italic text-gray-500 dark:border-gray-600 dark:text-gray-400">
                          "{quote}"
                        </blockquote>
                      )}

                      {d.transcriptEn && (
                        <details
                          class="rounded-lg border border-subtle bg-white p-3 dark:bg-slate-800"
                          {...(lang !== 'en' ? { 'data-i18n-allow-en': 'hansard-transcript-verbatim' } : {})}
                        >
                          <summary class="cursor-pointer text-xs font-semibold text-gray-500">{L.transcript}</summary>
                          <div class="mt-2 max-h-64 overflow-y-auto whitespace-pre-wrap text-xs leading-relaxed text-gray-600 dark:text-gray-400">
                            {d.transcriptEn}
                          </div>
                        </details>
                      )}
                    </div>
                  </details>
                </div>
              </article>
            );
          })
        }
      </div>

      {
        earlierCount > 0 && (
          <div class="mt-6 text-center">
            <button
              id="show-earlier-btn"
              type="button"
              class="rounded-lg border border-subtle bg-surface px-5 py-2.5 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:border-blue-300 hover:text-blue-700 dark:text-gray-200 dark:hover:text-blue-300"
            >
              {L.showEarlier.replace('{n}', String(earlierCount))}
            </button>
          </div>
        )
      }

      <div id="debate-empty-state" class="hidden py-16 text-center text-gray-400">
        <div class="mb-3 text-4xl">🔍</div>
        <div class="mb-2 text-lg font-medium">{L.noResults}</div>
        <button onclick="clearFilters()" class="mt-3 text-sm text-blue-600 hover:underline">{L.clear}</button>
      </div>
    </section>

    <section class="space-y-12" aria-labelledby="analysis-title">
      <div>
        <h2 id="analysis-title" class="t-h2 text-gray-900 dark:text-white">{L.analysisTitle}</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{L.analysisHint}</p>
      </div>

      <section>
        <h3 class="t-h3 mb-5 text-gray-800 dark:text-white">💡 {L.insights}</h3>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {
            KEY_INSIGHTS.map((insight) => (
              <div
                class={`rounded-xl border border-subtle border-l-4 bg-surface p-5 shadow-sm ${significanceColors[insight.significance]}`}
              >
                <div class="mb-2 flex items-start justify-between gap-2">
                  <h4 class="text-sm font-semibold text-gray-800 dark:text-white">
                    {pickLocalized(insight, 'title', 'titleEn', lang)}
                  </h4>
                  {insight.significance === 'high' && (
                    <span class="shrink-0 rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-600">{L.important}</span>
                  )}
                </div>
                <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                  {pickLocalized(insight, 'description', 'descriptionEn', lang)}
                </p>
                <p class="mt-2 text-xs italic text-gray-400">
                  {pickLocalized(insight, 'evidence', 'evidenceEn', lang)}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h3 class="t-h3 mb-2 text-gray-800 dark:text-white">📈 {L.evolution}</h3>
        <p class="mb-5 text-sm text-gray-400">{L.clickPeriod}</p>
        <div class="relative">
          <div
            class="absolute bottom-0 left-6 top-0 hidden w-0.5 bg-gradient-to-b from-blue-300 to-purple-300 md:block"
          >
          </div>
          <div class="space-y-4">
            {
              POLICY_EVOLUTION.map((period, index) => {
                // keyDebates: zh uses bare; zh-tw runs each through OpenCC;
                // others fall through to en variant.
                const keyDebates = isZh
                  ? period.keyDebates
                  : isZhTw
                    ? period.keyDebates.map((s) => toTraditional(s))
                    : period.keyDebatesEn?.length
                      ? period.keyDebatesEn
                      : period.keyDebates;
                return (
                  <div class="relative md:pl-16">
                    <div class="absolute left-0 top-3 hidden h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-purple-600 text-sm font-bold text-white shadow-md md:flex">
                      {index + 1}
                    </div>
                    <button
                      onclick={`filterBy('yearRange','${period.years}')`}
                      class="group w-full rounded-xl border border-subtle bg-surface p-5 text-left shadow-sm transition-all hover:border-blue-400 hover:shadow-md"
                    >
                      <div class="mb-2 flex flex-wrap items-center gap-3">
                        <span class="rounded-full bg-blue-100 px-2 py-1 font-mono text-xs text-blue-700 dark:bg-blue-900 dark:text-blue-300">
                          {period.years}
                        </span>
                        <h4 class="font-bold text-gray-800 dark:text-white">
                          {pickLocalized(period, 'period', 'periodEn', lang)}
                        </h4>
                      </div>
                      <p class="mb-2 text-sm font-medium text-blue-700 dark:text-blue-400">
                        {pickLocalized(period, 'theme', 'themeEn', lang)}
                      </p>
                      <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                        {pickLocalized(period, 'description', 'descriptionEn', lang)}
                      </p>
                      {keyDebates.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-2">
                          {keyDebates.map((debate) => (
                            <span class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-600 dark:bg-slate-700 dark:text-gray-400">
                              📌 {debate}
                            </span>
                          ))}
                        </div>
                      )}
                    </button>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      <section>
        <h3 class="t-h3 mb-2 text-gray-800 dark:text-white">⚡ {L.controversies}</h3>
        <p class="mb-5 text-sm text-gray-400">{L.clickControversy}</p>
        <div class="grid gap-4 md:grid-cols-2">
          {
            RECURRING_CONTROVERSIES.map((controversy, index) => (
              <button
                onclick={`filterBy('topics','${(controversy as { relatedTopics: string[] }).relatedTopics.join(',')}')`}
                class="group rounded-xl border border-subtle bg-surface p-5 text-left shadow-sm transition-all hover:border-orange-400 hover:shadow-md"
              >
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h4 class="font-bold text-gray-800 transition-colors group-hover:text-orange-600 dark:text-white">
                      {pickLocalized(controversy, 'issue', 'issueEn', lang)}
                    </h4>
                    <p class="mt-1 text-sm text-gray-500">
                      {pickLocalized(controversy, 'description', 'descriptionEn', lang)}
                    </p>
                  </div>
                  <div class="flex shrink-0 flex-col items-end gap-1">
                    <span class="rounded-full bg-gray-100 px-2 py-1 text-xs text-gray-600 dark:bg-slate-700 dark:text-gray-400">
                      {controversyDebateCounts[index]} {L.related}
                    </span>
                    <span class={`rounded-full px-2 py-1 text-xs ${statusColors[controversy.resolutionStatus]}`}>
                      {statusLabels[controversy.resolutionStatus]}
                    </span>
                  </div>
                </div>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                  <div class="rounded-lg bg-blue-50 p-3 dark:bg-blue-900/20">
                    <div class="mb-1 text-xs font-semibold text-blue-600 dark:text-blue-400">{L.government}</div>
                    <div class="text-xs text-gray-700 dark:text-gray-300">
                      {pickLocalized(controversy, 'governmentPosition', 'governmentPositionEn', lang)}
                    </div>
                  </div>
                  <div class="rounded-lg bg-orange-50 p-3 dark:bg-orange-900/20">
                    <div class="mb-1 text-xs font-semibold text-orange-600 dark:text-orange-400">{L.opposition}</div>
                    <div class="text-xs text-gray-700 dark:text-gray-300">
                      {pickLocalized(controversy, 'oppositionPosition', 'oppositionPositionEn', lang)}
                    </div>
                  </div>
                </div>
              </button>
            ))
          }
        </div>
      </section>

      <section>
        <h3 class="t-h3 mb-5 text-gray-800 dark:text-white">⚖️ {L.tensions}</h3>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {
            TENSION_MAP.map((tension) => (
              <div class="rounded-xl border border-subtle bg-surface p-5 shadow-sm">
                <h4 class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
                  {pickLocalized(tension, 'dimension', 'dimensionEn', lang)}
                </h4>
                <div class="mb-3 flex items-center gap-2">
                  <div class="flex-1 rounded-lg bg-blue-50 p-2 text-center text-xs text-blue-700 dark:bg-blue-900/20 dark:text-blue-300">
                    {pickLocalized(tension, 'sideA', 'sideAEn', lang)}
                  </div>
                  <div class="text-sm font-bold text-gray-400">vs</div>
                  <div class="flex-1 rounded-lg bg-orange-50 p-2 text-center text-xs text-orange-700 dark:bg-orange-900/20 dark:text-orange-300">
                    {pickLocalized(tension, 'sideB', 'sideBEn', lang)}
                  </div>
                </div>
                <div class="rounded bg-gray-50 p-2 text-xs text-gray-500 dark:bg-slate-700 dark:text-gray-400">
                  <span class="font-medium">{L.currentBalance} </span>
                  {pickLocalized(tension, 'currentBalance', 'currentBalanceEn', lang)}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h3 class="t-h3 mb-2 text-gray-800 dark:text-white">🎙️ {L.mps}</h3>
        <p class="mb-5 text-sm text-gray-400">{L.clickMp}</p>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {
            MP_PROFILES.map((mp) => (
              <button
                onclick={`filterBy('speaker','${jsAttr(mp.nameEn || mp.name)}')`}
                class="group rounded-xl border border-subtle bg-surface p-4 text-left shadow-sm transition-all hover:border-purple-400 hover:shadow-md"
              >
                <div class="mb-2 flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <div class="text-sm font-semibold text-gray-800 transition-colors group-hover:text-purple-600 dark:text-white">
                      {mpDisplayName(mp)}
                    </div>
                    {!isEn && mp.nameEn && mp.nameEn !== mpDisplayName(mp) && (
                      <div class="text-xs text-gray-500">{mp.nameEn}</div>
                    )}
                  </div>
                  <span
                    class={`shrink-0 rounded-full px-2 py-0.5 text-xs ${mp.role === '反对党' ? 'bg-orange-100 text-orange-700' : 'bg-blue-100 text-blue-700'}`}
                  >
                    {mpRoleLabel(mp)}
                  </span>
                </div>
                <div class="mb-2 text-xs text-gray-500">
                  <span class="font-bold text-gray-700 dark:text-gray-300">{mp.debateCount}</span>{' '}
                  {DEBATES_COUNT_LABEL[lang] || DEBATES_COUNT_LABEL.en}
                </div>
                <div class="mb-2 flex flex-wrap gap-1">
                  {mpFocusAreas(mp)
                    .slice(0, 3)
                    .map((area) => (
                      <span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-600 dark:bg-slate-700 dark:text-gray-400">
                        {area}
                      </span>
                    ))}
                </div>
                <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">
                  {pickLocalized(mp, 'notablePosition', 'notablePositionEn', lang)}
                </p>
              </button>
            ))
          }
        </div>
      </section>

      <section>
        <h3 class="t-h3 mb-2 text-gray-800 dark:text-white">📡 {L.signals}</h3>
        <p class="mb-5 text-sm text-gray-400">{L.clickSignal}</p>
        <div class="grid gap-3 md:grid-cols-2">
          {
            POLICY_SIGNALS.map((signal) => (
              <button
                onclick={`filterBy('year','${signal.year}')`}
                class="group flex items-start gap-3 rounded-xl border border-subtle bg-surface p-4 text-left shadow-sm transition-all hover:border-green-400 hover:shadow-md"
              >
                <div class="mt-0.5 shrink-0">
                  {signal.status === '已落实' && <span class="text-lg text-green-500">✅</span>}
                  {signal.status === '进行中' && <span class="text-lg text-blue-500">🔄</span>}
                  {signal.status === '仍在讨论' && <span class="text-lg text-amber-500">💬</span>}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-sm font-semibold text-gray-800 transition-colors group-hover:text-green-600 dark:text-white">
                      {pickLocalized(signal, 'signal', 'signalEn', lang)}
                    </span>
                    <span class="text-xs text-gray-400">
                      {L.firstSeen} {signal.year}
                    </span>
                    <span
                      class={`rounded-full px-2 py-0.5 text-xs ${signal.status === '已落实' ? 'bg-green-100 text-green-700' : signal.status === '进行中' ? 'bg-blue-100 text-blue-700' : 'bg-amber-100 text-amber-700'}`}
                    >
                      {signal.status === '已落实'
                        ? L.implemented
                        : signal.status === '进行中'
                          ? L.inProgress
                          : L.stillDiscussing}
                    </span>
                  </div>
                  <p class="mt-1 text-xs text-gray-500">{pickLocalized(signal, 'context', 'contextEn', lang)}</p>
                </div>
              </button>
            ))
          }
        </div>
      </section>
    </section>
  </div>
</Layout>

<script define:vars={{ typeMap, controversyLabels, topicLabels, L, DEFAULT_VISIBLE }}>
  const cards = () => Array.from(document.querySelectorAll('[data-debate-card]'));

  // Cards past DEFAULT_VISIBLE ship server-hidden. Collapse only applies to
  // the unfiltered view; any active filter/search reveals every match.
  let listCollapsed = true;

  let activeFilters = {
    search: '',
    type: '',
    topic: '',
    topicsOr: [],
    year: '',
    controversy: '',
    speaker: '',
    _yearRange: null,
  };

  function setSelectValue(id, value) {
    const el = document.getElementById(id);
    if (el) el.value = value;
  }

  function setInputValue(id, value) {
    const el = document.getElementById(id);
    if (el) el.value = value;
  }

  function scrollToDebates() {
    document.getElementById('debate-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function resetActive() {
    activeFilters = {
      search: '',
      type: '',
      topic: '',
      topicsOr: [],
      year: '',
      controversy: '',
      speaker: '',
      _yearRange: null,
    };
    setInputValue('search-input', '');
    setSelectValue('type-filter', '');
    setSelectValue('topic-filter', '');
    setSelectValue('year-filter', '');
    setSelectValue('controversy-filter', '');
    setSelectValue('speaker-filter', '');
  }

  window.filterBy = function (dimension, value) {
    resetActive();

    if (dimension === 'type') {
      activeFilters.type = value;
      setSelectValue('type-filter', value);
    } else if (dimension === 'topic') {
      activeFilters.topic = value;
      setSelectValue('topic-filter', value);
    } else if (dimension === 'year') {
      activeFilters.year = value;
      setSelectValue('year-filter', value);
    } else if (dimension === 'speaker') {
      activeFilters.speaker = value;
      setSelectValue('speaker-filter', value);
    } else if (dimension === 'controversy') {
      activeFilters.controversy = value;
      setSelectValue('controversy-filter', value);
    } else if (dimension === 'topics') {
      activeFilters.topicsOr = value
        .split(',')
        .map((topic) => topic.trim())
        .filter(Boolean);
      if (activeFilters.topicsOr.length === 1) {
        setSelectValue('topic-filter', activeFilters.topicsOr[0]);
        activeFilters.topic = activeFilters.topicsOr[0];
        activeFilters.topicsOr = [];
      }
    } else if (dimension === 'keyword') {
      activeFilters.search = value.toLowerCase();
      setInputValue('search-input', value);
    } else if (dimension === 'yearRange') {
      const parts = value.split('-');
      activeFilters._yearRange = [parseInt(parts[0]), parseInt(parts[parts.length - 1])];
    }

    applyFilters();
    scrollToDebates();
  };

  window.clearFilters = function () {
    resetActive();
    applyFilters();
  };

  function updateActiveFilterBar(visibleCount) {
    const bar = document.getElementById('active-filter-bar');
    const label = document.getElementById('active-filter-label');
    const clearBtn = document.getElementById('clear-filters-btn');
    const parts = [];

    if (activeFilters.search) parts.push(`"${activeFilters.search}"`);
    if (activeFilters.type) parts.push(`${typeMap[activeFilters.type] || activeFilters.type}`);
    if (activeFilters.topic) parts.push(`${topicLabels[activeFilters.topic] || activeFilters.topic}`);
    if (activeFilters.year) parts.push(`${activeFilters.year}`);
    if (activeFilters.speaker) parts.push(`${activeFilters.speaker}`);
    if (activeFilters.controversy) parts.push(`${controversyLabels[parseInt(activeFilters.controversy, 10)] || ''}`);
    if (activeFilters._yearRange) parts.push(`${activeFilters._yearRange[0]}-${activeFilters._yearRange[1]}`);
    if (activeFilters.topicsOr && activeFilters.topicsOr.length > 0)
      parts.push(activeFilters.topicsOr.map((topic) => topicLabels[topic] || topic).join(' / '));

    if (parts.length > 0) {
      label.textContent = ` ${parts.join(' · ')} (${visibleCount} ${L.results})`;
      bar.classList.remove('hidden');
      clearBtn.classList.remove('hidden');
    } else {
      bar.classList.add('hidden');
      clearBtn.classList.add('hidden');
    }
  }

  function applyFilters() {
    activeFilters.search = (document.getElementById('search-input')?.value || '').toLowerCase();
    activeFilters.type = document.getElementById('type-filter')?.value || '';
    activeFilters.year = document.getElementById('year-filter')?.value || '';
    activeFilters.controversy = document.getElementById('controversy-filter')?.value || '';
    activeFilters.speaker = document.getElementById('speaker-filter')?.value || '';
    const topic = document.getElementById('topic-filter')?.value || '';
    if (topic !== activeFilters.topic) {
      activeFilters.topic = topic;
      activeFilters.topicsOr = [];
    }

    const hasActiveFilters = Boolean(
      activeFilters.search ||
      activeFilters.type ||
      activeFilters.topic ||
      activeFilters.topicsOr.length > 0 ||
      activeFilters.year ||
      activeFilters.speaker ||
      activeFilters.controversy ||
      activeFilters._yearRange
    );

    const all = cards();
    let visible = 0;
    let matched = 0;

    for (const card of all) {
      const cType = card.dataset.type || '';
      const cTopics = (card.dataset.topics || '').split('|').filter(Boolean);
      const cYear = card.dataset.year || '';
      const cSpeakers = (card.dataset.speakers || '').split('|').filter(Boolean);
      const cControversy = parseInt(card.dataset.controversy || '1', 10);
      const cSearch = card.dataset.search || '';

      let match = true;
      if (activeFilters.search && !cSearch.includes(activeFilters.search)) match = false;
      if (match && activeFilters.type && cType !== activeFilters.type) match = false;
      if (match && activeFilters.topic && !cTopics.includes(activeFilters.topic)) match = false;
      if (
        match &&
        activeFilters.topicsOr.length > 0 &&
        !activeFilters.topicsOr.some((topic) => cTopics.includes(topic))
      )
        match = false;
      if (match && activeFilters.year && cYear !== activeFilters.year) match = false;
      if (match && activeFilters.speaker && !cSpeakers.includes(activeFilters.speaker)) match = false;
      if (match && activeFilters._yearRange) {
        const y = parseInt(cYear, 10);
        if (y < activeFilters._yearRange[0] || y > activeFilters._yearRange[1]) match = false;
      }
      if (match && activeFilters.controversy === '4' && cControversy < 4) match = false;
      else if (match && activeFilters.controversy === '3' && cControversy !== 3) match = false;
      else if (match && activeFilters.controversy === '1' && cControversy > 2) match = false;

      if (match) {
        matched++;
        if (!hasActiveFilters && listCollapsed && matched > DEFAULT_VISIBLE) {
          card.setAttribute('hidden', '');
        } else {
          card.removeAttribute('hidden');
          visible++;
        }
      } else {
        card.setAttribute('hidden', '');
      }
    }

    const count = document.getElementById('result-count');
    if (count) count.textContent = `${L.showing} ${visible} / ${all.length} ${L.results}`;

    const empty = document.getElementById('debate-empty-state');
    if (empty) empty.classList.toggle('hidden', matched !== 0);

    const earlierBtn = document.getElementById('show-earlier-btn');
    if (earlierBtn) {
      earlierBtn.parentElement?.classList.toggle(
        'hidden',
        hasActiveFilters || !listCollapsed || matched <= DEFAULT_VISIBLE
      );
    }

    updateActiveFilterBar(visible);
  }

  function initDebates() {
    applyFilters();

    document.getElementById('show-earlier-btn')?.addEventListener('click', () => {
      listCollapsed = false;
      applyFilters();
    });

    document.getElementById('search-input')?.addEventListener('input', () => {
      activeFilters._yearRange = null;
      applyFilters();
    });

    ['type-filter', 'year-filter', 'controversy-filter', 'speaker-filter'].forEach((id) => {
      document.getElementById(id)?.addEventListener('change', () => {
        activeFilters._yearRange = null;
        applyFilters();
      });
    });

    document.getElementById('topic-filter')?.addEventListener('change', () => {
      activeFilters._yearRange = null;
      activeFilters.topicsOr = [];
      applyFilters();
    });
  }

  document.addEventListener('DOMContentLoaded', initDebates);
  document.addEventListener('astro:page-load', initDebates);
</script>
