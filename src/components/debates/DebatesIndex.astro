const isZh = lang === 'zh';
const isZhTw = lang === 'zh-tw';
const isKo = lang === 'ko';
const isEn = !isJa && !isZh && !isZhTw && !isKo;
const DATA_UPDATED = '2026-06-09';

// Bake actual record count + year range into meta — drives CTR on SERP.
