---
// Lang-aware /agent/ page body. Single source for `src/pages/agent/index.astro`
// and `src/pages/[lang]/agent/index.astro`. Page-local COPY (rather than the
// global i18n dict) because this is editorial prose, not chrome.
//
// Five locales, per CLAUDE.md rule #5 / #13:
//   zh / en / ja / ko → hand-written COPY entries (no ko→en fallback here).
//   zh-tw            → derived from COPY.zh via OpenCC (zhTwCopy below).
//
// Code samples (`kind: 'code'`) are ASCII shell commands / URLs and stay
// identical in every locale — translating a curl command would break it. On
// the four non-en locales they carry the registered `agent-api-sample`
// marker so the dist EN-sentence scanner doesn't read them as leaked English.

import { localizedHref, type Lang } from '~/i18n';
import { deepToTraditional, toTraditional } from '~/i18n/opencc';
import { DATA_LICENSE_URL, licenseLine } from '~/utils/license';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

type Block =
  | { kind: 'p'; html: string }
  | { kind: 'ul'; items: string[] }
  | { kind: 'code'; lines: string[] }
  | { kind: 'table'; head: [string, string]; rows: [string, string][] };

interface Section {
  id: string;
  heading: string;
  blocks: Block[];
}

interface AgentCopy {
  eyebrow: string;
  headline: string;
  lead: string;
  sections: Section[];
  aboutCta: string;
}

// Sample ids used in the Markdown-twin example. Real records, so the sample
// URLs resolve; both are the oldest entries in their data file and therefore
