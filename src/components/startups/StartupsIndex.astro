---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import CrossDomainRail from '~/components/listing/CrossDomainRail.astro';
import LatestAdditions from '~/components/listing/LatestAdditions.astro';
import Headline from '~/components/ui/Headline.astro';
import { ecosystemStats, exits, investors, unicorns, verticals } from '~/data/startups';
import { getStartupAiRelation, startupEntitySlug } from '~/utils/entity-pages';
import { localizedHref, pickLocalized, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// H1 = the exact query phrase ("singapore ai startups" — 501 impressions
// at position 31, GSC 2026-07); the dict key now holds the short per-locale
// keyword form shared by all routes.
const headlineTitle = t(lang, 'startupsPageTitle');

// SEO title / description carry live counts from ecosystemStats so they
// never go stale inside a dict literal. Year comes from the stats baseline.
const statsYear = ecosystemStats.dataDate.slice(0, 4);
const metaTitleByLang: Record<Lang, string> = {
  zh: `新加坡 AI 创业公司 — ${ecosystemStats.totalStartups} 家公司、${ecosystemStats.unicorns} 家独角兽（${statsYear}）`,
  'zh-tw': '',
  en: `Singapore AI Startups — ${ecosystemStats.totalStartups} companies, ${ecosystemStats.unicorns} unicorns (${statsYear})`,
  ja: `シンガポール AI スタートアップ — ${ecosystemStats.totalStartups} 社、ユニコーン ${ecosystemStats.unicorns} 社（${statsYear}）`,
  ko: `싱가포르 AI 스타트업 — ${ecosystemStats.totalStartups}개사, 유니콘 ${ecosystemStats.unicorns}개(${statsYear})`,
};
metaTitleByLang['zh-tw'] = toTraditional(metaTitleByLang.zh);
const metaDescByLang: Record<Lang, string> = {
  zh: `新加坡 AI 创业生态全景（${statsYear}）：${ecosystemStats.totalStartups} 家 AI 公司、${ecosystemStats.unicorns} 家独角兽、累计融资 ${ecosystemStats.totalVCRaised}、全球 AI 枢纽第 ${ecosystemStats.globalRank} 名。按垂直领域分类，含退出案例与投资人网络，数据基线 ${ecosystemStats.dataDate}。`,
  'zh-tw': '',
  en: `Singapore's AI startup ecosystem (${statsYear}): ${ecosystemStats.totalStartups} AI companies, ${ecosystemStats.unicorns} unicorns, ${ecosystemStats.totalVCRaised} cumulative VC raised, ranked #${ecosystemStats.globalRank} global AI hub. Mapped by vertical, with exits and the investor network. Baselined ${ecosystemStats.dataDate}.`,
  ja: `シンガポール AI スタートアップ生態系（${statsYear}）：AI 企業 ${ecosystemStats.totalStartups} 社、ユニコーン ${ecosystemStats.unicorns} 社、累計調達 ${ecosystemStats.totalVCRaised}、グローバル AI ハブ第 ${ecosystemStats.globalRank} 位。垂直分野別マップ、イグジット事例と投資家ネットワーク付き（基準日 ${ecosystemStats.dataDate}）。`,
  ko: `싱가포르 AI 스타트업 생태계(${statsYear}): AI 기업 ${ecosystemStats.totalStartups}개사, 유니콘 ${ecosystemStats.unicorns}개, 누적 투자 ${ecosystemStats.totalVCRaised}, 글로벌 AI 허브 ${ecosystemStats.globalRank}위. 버티컬별 지도, 엑시트 사례와 투자자 네트워크 포함(기준일 ${ecosystemStats.dataDate}).`,
};
metaDescByLang['zh-tw'] = toTraditional(metaDescByLang.zh);
// Visible freshness marker under the H1 — "is this list current?" is the
// first question on a listing page competing for a year-qualified query.
const updatedNoteByLang: Record<Lang, string> = {
  zh: `数据基线 ${ecosystemStats.dataDate} · 档案整理 ${ecosystemStats.profileUpdated}`,
  'zh-tw': '',
  en: `Data baseline ${ecosystemStats.dataDate} · profiles curated ${ecosystemStats.profileUpdated}`,
  ja: `データ基準日 ${ecosystemStats.dataDate} · プロファイル整理 ${ecosystemStats.profileUpdated}`,
  ko: `데이터 기준일 ${ecosystemStats.dataDate} · 프로필 정리 ${ecosystemStats.profileUpdated}`,
};
updatedNoteByLang['zh-tw'] = toTraditional(updatedNoteByLang.zh);

const hrefFor = (entity: { id?: string; name: string; nameEn?: string }) =>
  localizedHref(`/startups/${startupEntitySlug(entity)}/`, lang);

const stats = [
  { value: ecosystemStats.totalStartups, label: t(lang, 'startupStatAiCompanies') },
  {
    value: t(lang, 'startupStatGlobalRank').replace('{rank}', String(ecosystemStats.globalRank)),
    label: t(lang, 'startupStatHubRank'),
  },
  { value: ecosystemStats.seaFundingShare, label: t(lang, 'startupStatSeaFundingShare') },
  { value: ecosystemStats.totalVCRaised, label: t(lang, 'startupStatTotalVcRaised') },
  { value: String(ecosystemStats.unicorns), label: t(lang, 'startupStatUnicorns') },
  { value: ecosystemStats.govCommitment, label: t(lang, 'startupStatGovCommitment') },
];

// One-off long-form disclaimer paragraph with date interpolation — page-local
// per-locale template rather than a central dict key (not reused elsewhere).
const DISCLAIMER: Record<Lang, string> = {
  zh: `基础统计重定基线于 ${ecosystemStats.dataDate}，逐项锚定单一来源：AI 公司数与 VC 融资总额来自 Tracxn（2026-05 口径：548 家、累计融资 US$1.9B）；东南亚 AI 融资占比按 e-Conomy SEA 2025 报告（Google/Temasek/Bain）估算——新加坡 US$1.31B / 区域逾 US$2.3B（截至 2025 年 6 月的 12 个月）；政府 AI 承诺投入为 2024 年以来公告合计（Budget 2024 逾 S$10 亿 + Budget 2025 企业算力计划至多 S$1.5 亿 + 2026 年 1 月国家 AI 研发计划追加逾 S$10 亿）；AI 枢纽排名来自 Tortoise Global AI Index 2025；独角兽为本页收录档案数。实体档案整理于 ${ecosystemStats.profileUpdated}。融资金额来源于公开报道，实际数字可能有出入。`,
  en: `Aggregate statistics were re-baselined on ${ecosystemStats.dataDate}, each pinned to a single named source: the AI company count and total VC raised are from Tracxn (as of May 2026: 548 companies, US$1.9B cumulative); the SEA AI funding share is estimated from the e-Conomy SEA 2025 report by Google, Temasek and Bain (Singapore US$1.31B of the region's US$2.3B+ in the 12 months to June 2025); the government AI commitment sums announcements since 2024 (over S$1B at Budget 2024, up to S$150M for the Enterprise Compute Initiative at Budget 2025, and over S$1B for the National AI R&D Plan announced in January 2026); the AI hub rank is from the Tortoise Global AI Index 2025; the unicorn count is the number of profiles curated on this page. Entity profiles were organized on ${ecosystemStats.profileUpdated}. Funding amounts follow public reporting and actual numbers may differ.`,
  ja: `集計統計は${ecosystemStats.dataDate}に再基準化され、それぞれ単一の情報源に紐付けています。AI 企業数と VC 資金調達総額は Tracxn（2026年5月時点：548 社、累計 US$1.9B）；東南アジアの AI 資金調達シェアは e-Conomy SEA 2025 レポート（Google/Temasek/Bain）による推計——シンガポール US$1.31B／地域全体で US$2.3B 超（2025 年 6 月までの 12 か月間）；政府の AI コミットメントは 2024 年以降の発表累計（Budget 2024 で S$10 億超 + Budget 2025 の Enterprise Compute Initiative で最大 S$1.5 億 + 2026 年 1 月発表の National AI R&D Plan で S$10 億超追加）；AI ハブランキングは Tortoise Global AI Index 2025 による；ユニコーン数は本ページに掲載されているプロファイル数です。エンティティプロファイルは${ecosystemStats.profileUpdated}に整理されました。資金調達額は公開報道に基づいており、実際の数値と異なる場合があります。`,
  'zh-tw': '',
  ko: `종합 통계는 ${ecosystemStats.dataDate}에 재기준화되었으며, 각 항목은 단일 출처에 고정되어 있습니다. AI 기업 수와 VC 누적 투자액은 Tracxn 기준（2026년 5월 기준: 548개사, 누적 US$1.9B）; 동남아 AI 투자 비중은 e-Conomy SEA 2025 보고서（Google/Temasek/Bain）추정치——싱가포르 US$1.31B / 지역 전체 US$2.3B 이상（2025년 6월까지 12개월 기준）; 정부의 AI 투자 공약은 2024년 이후 발표 누계（Budget 2024에서 S$10억 이상 + Budget 2025 Enterprise Compute Initiative에서 최대 S$1.5억 + 2026년 1월 발표된 National AI R&D Plan에서 S$10억 이상 추가）; AI 허브 순위는 Tortoise Global AI Index 2025 기준; 유니콘 수는 이 페이지에 등재된 프로필 수입니다. 엔티티 프로필은 ${ecosystemStats.profileUpdated}에 정리되었습니다. 투자 금액은 공개 보도를 기반으로 하며 실제 수치와 다를 수 있습니다.`,
};
DISCLAIMER['zh-tw'] = toTraditional(DISCLAIMER.zh);
---

<Layout
  metadata={{
    title: metaTitleByLang[lang] || metaTitleByLang.en,
    description: metaDescByLang[lang] || metaDescByLang.en,
  }}
  breadcrumbs={[{ label: t(lang, 'navStartups') }]}
  lang={lang}
>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 max-w-6xl">
    <Headline title={headlineTitle} subtitle={t(lang, 'startupsPageSubtitle')} />
    <p class="text-xs text-muted -mt-6 mb-2 text-center">{updatedNoteByLang[lang] || updatedNoteByLang.en}</p>
    <LatestAdditions lang={lang} source="startup" class="mt-8 mb-2" />

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-12">
      {
        stats.map((stat) => (
          <div class="bg-surface rounded-lg shadow border border-subtle p-4 text-center">
            <div class="t-stat text-primary">{stat.value}</div>
            <div class="text-xs text-muted mt-1">{stat.label}</div>
          </div>
        ))
      }
    </div>

    <section class="mb-14">
      <div class="flex items-end justify-between gap-4 mb-5">
        <div>
          <p class="text-xs uppercase tracking-wider text-muted font-semibold mb-2">Scale Signals</p>
          <h2 class="t-h3">{t(lang, 'startupUnicornsSectionTitle')}</h2>
        </div>
        <span class="text-sm text-muted">{unicorns.length} {t(lang, 'companiesCountSuffix')}</span>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          unicorns.map((u) => (
            <a
              href={hrefFor(u)}
              class="group h-full bg-surface rounded-lg shadow-sm border border-subtle p-5 hover:border-primary hover:shadow-md transition-all"
            >
              <div class="flex items-start justify-between gap-3 mb-4">
                <div>
                  <p class="text-xs text-muted mb-1">{t(lang, 'startupUnicornBadge')}</p>
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                    {u.name}
                  </h3>
                  <span class="mt-2 inline-flex text-xs font-medium bg-primary/10 text-primary px-2 py-0.5 rounded">
                    {pickLocalized(getStartupAiRelation(startupEntitySlug(u)), 'label', lang)}
                  </span>
                </div>
                <Icon name="tabler:arrow-up-right" class="w-5 h-5 text-muted group-hover:text-primary shrink-0" />
              </div>
              <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
                {pickLocalized(u, 'sector', lang)}
              </p>
              <dl class="grid grid-cols-2 gap-3 text-xs">
                <div>
                  <dt class="text-muted mb-1">{t(lang, 'startupRaisedLabel')}</dt>
                  <dd class="font-semibold text-gray-900 dark:text-white">{u.raised}</dd>
                </div>
                <div>
                  <dt class="text-muted mb-1">{t(lang, 'startupValuation')}</dt>
                  <dd class="font-semibold text-primary">{u.valuation}</dd>
                </div>
                <div class="col-span-2">
                  <dt class="text-muted mb-1">{t(lang, 'startupStatusLabel')}</dt>
                  <dd>{pickLocalized(u, 'status', lang)}</dd>
                </div>
              </dl>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <div class="mb-6">
        <p class="text-xs uppercase tracking-wider text-muted font-semibold mb-2">Vertical Map</p>
        <h2 class="t-h3">{t(lang, 'startupByVerticalTitle')}</h2>
      </div>
      <div class="space-y-10">
        {
          verticals.map((v) => (
            <section>
              <div class="flex items-center justify-between gap-4 mb-4">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">
                  {v.icon} {pickLocalized(v, 'name', lang)}
                </h3>
                <span class="text-sm text-muted">
                  {v.startups.length} {t(lang, 'entitiesCountSuffix')}
                </span>
              </div>
              <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                {v.startups.map((s) => (
                  <a
                    href={hrefFor(s)}
                    class="group h-full bg-surface rounded-lg shadow-sm border border-subtle p-5 hover:border-primary hover:shadow-md transition-all"
                  >
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                      <h4 class="font-bold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                        {s.name}
                      </h4>
                      {pickLocalized(s, 'highlight', lang) && (
                        <span class="text-xs font-medium bg-primary/10 text-primary px-2 py-0.5 rounded">
                          {pickLocalized(s, 'highlight', lang)}
                        </span>
                      )}
                      <span class="text-xs font-medium bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 rounded">
                        {pickLocalized(getStartupAiRelation(startupEntitySlug(s)), 'label', lang)}
                      </span>
                    </div>
                    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
                      {pickLocalized(s, 'description', lang)}
                    </p>
                    <div class="flex flex-wrap gap-2 text-xs text-muted">
                      {s.raised && (
                        <span class="bg-gray-100 dark:bg-slate-800 px-2 py-1 rounded">
                          {t(lang, 'startupRaisedLabel')} {s.raised}
                        </span>
                      )}
                      {s.investors && (
                        <span class="bg-gray-100 dark:bg-slate-800 px-2 py-1 rounded">
                          {t(lang, 'startupInvestorsLabel')} {s.investors}
                        </span>
                      )}
                    </div>
                    <div class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-primary">
                      {t(lang, 'openProfileCta')}
                      <Icon name="tabler:arrow-right" class="w-4 h-4" />
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <div class="flex items-end justify-between gap-4 mb-5">
        <div>
          <p class="text-xs uppercase tracking-wider text-muted font-semibold mb-2">Exit Signals</p>
          <h2 class="t-h3">{t(lang, 'startupExitsSectionTitle')}</h2>
        </div>
        <span class="text-sm text-muted">
          {exits.length}
          {t(lang, 'recordsCountSuffix')}
        </span>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {
          exits.map((e) => (
            <a
              href={hrefFor(e)}
              class="group h-full bg-surface rounded-lg shadow-sm border border-subtle p-5 hover:border-primary hover:shadow-md transition-all"
            >
              <div class="flex items-start justify-between gap-3 mb-3">
                <div>
                  <p class="text-xs text-muted mb-1">{e.year || t(lang, 'yearPending')}</p>
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                    {e.name}
                  </h3>
                  <span class="mt-2 inline-flex text-xs font-medium bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 rounded">
                    {pickLocalized(getStartupAiRelation(startupEntitySlug(e)), 'label', lang)}
                  </span>
                </div>
                <Icon name="tabler:arrow-up-right" class="w-5 h-5 text-muted group-hover:text-primary shrink-0" />
              </div>
              <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
                {pickLocalized(e, 'description', lang)}
              </p>
              <dl class="grid gap-3 sm:grid-cols-2 text-xs">
                <div>
                  <dt class="text-muted mb-1">{t(lang, 'startupAcquirerLabel')}</dt>
                  <dd class="font-semibold text-gray-900 dark:text-white">{pickLocalized(e, 'acquirer', lang)}</dd>
                </div>
                <div>
                  <dt class="text-muted mb-1">{t(lang, 'benchmarkAmountLabel')}</dt>
                  <dd class="font-semibold text-primary">{e.amount}</dd>
                </div>
              </dl>
              {pickLocalized(e, 'note', lang) && (
                <p class="mt-4 text-xs leading-relaxed text-muted line-clamp-3">{pickLocalized(e, 'note', lang)}</p>
              )}
            </a>
          ))
        }
      </div>
    </section>

    <section class="mb-12">
      <div class="flex items-end justify-between gap-4 mb-5">
        <div>
          <p class="text-xs uppercase tracking-wider text-muted font-semibold mb-2">Capital Network</p>
          <h2 class="t-h3">{t(lang, 'startupInvestorEcosystemTitle')}</h2>
        </div>
        <span class="text-sm text-muted">
          {investors.length}
          {t(lang, 'institutionsCountSuffix')}
        </span>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          investors.map((inv) => (
            <a
              href={hrefFor(inv)}
              class="group h-full bg-surface rounded-lg shadow-sm border border-subtle p-5 hover:border-primary hover:shadow-md transition-all"
            >
              <div class="flex items-start justify-between gap-3 mb-3">
                <div>
                  <span class="text-xs font-medium bg-primary/10 text-primary px-2 py-0.5 rounded">
                    {pickLocalized(inv, 'type', lang)}
                  </span>
                  <span class="ml-2 text-xs font-medium bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-2 py-0.5 rounded">
                    {pickLocalized(getStartupAiRelation(startupEntitySlug(inv)), 'label', lang)}
                  </span>
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-primary transition-colors mt-3">
                    {inv.name}
                  </h3>
                </div>
                <Icon name="tabler:arrow-up-right" class="w-5 h-5 text-muted group-hover:text-primary shrink-0" />
              </div>
              <p class="text-sm mt-3">
                <span class="text-muted">{t(lang, 'startupTrackRecordColon')}</span>
                {pickLocalized(inv, 'stats', lang)}
              </p>
              <p class="text-sm">
                <span class="text-muted">{t(lang, 'startupFocusColon')}</span>
                {pickLocalized(inv, 'focus', lang)}
              </p>
              {pickLocalized(inv, 'notableDeals', lang) && (
                <p class="text-sm">
                  <span class="text-muted">{t(lang, 'investorNotableDeals')}</span>
                  {pickLocalized(inv, 'notableDeals', lang)}
                </p>
              )}
            </a>
          ))
        }
      </div>
    </section>

    <p class="mt-8 text-sm text-muted text-center">
      {DISCLAIMER[lang]}
    </p>
  </section>
  <CrossDomainRail lang={lang} current="startups" class="max-w-6xl mx-auto px-4 sm:px-6 pb-16" />
</Layout>
