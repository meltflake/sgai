---
// Front-page latest-updates feed — main-column module, date-grouped like a
// newspaper's "what's new" river. One row per record (merged manual +
// derived feed from src/data/updates.ts): type chip · title (direct link)
// · one-line summary · the record's own date next to the day it entered
// the site. A "new since your last visit" badge lights up for returning
// readers (browser-local, see SinceLastVisit.astro).
//
// Window: everything from the last 14 days, at least 8 rows, at most 20 —
// so a quiet fortnight still shows a page of history and a batch import
// doesn't flood the front page.

import { recentUpdatesWindow, type Update } from '~/data/updates';
import { localizedHref, t, type Lang } from '~/i18n';
import { formatDayHeader, formatEventDate } from '~/utils/date-format';
import { CHIP_FALLBACK, TYPE_CHIP, eventDateLabelKey, linkLabel, typeLabel, updateText } from '~/utils/update-type-ui';
import SinceLastVisit from '~/components/common/SinceLastVisit.astro';

interface Props {
  lang: Lang;
  days?: number;
  min?: number;
  max?: number;
}

const { lang, days = 14, min = 8, max = 20 } = Astro.props;
const items: Update[] = recentUpdatesWindow({ days, min, max });

// Group consecutive same-day updates under one date header.
const byDate: Array<{ date: string; updates: Update[] }> = [];
for (const u of items) {
  const last = byDate[byDate.length - 1];
  if (last && last.date === u.date) last.updates.push(u);
  else byDate.push({ date: u.date, updates: [u] });
}

const SCOPE = 'latest-updates-feed';
---

<div id={SCOPE}>
  <div class="flex items-baseline justify-between mb-4 gap-4 flex-wrap">
    <div class="flex items-baseline gap-3 flex-wrap">
      <h2 class="t-h3 text-gray-900 dark:text-white">{t(lang, 'updatesHomeSection')}</h2>
      <SinceLastVisit lang={lang} scope={SCOPE} />
    </div>
    <a
      href={localizedHref('/updates/', lang)}
      class="text-sm text-gray-500 hover:text-primary dark:text-gray-400 transition-colors"
    >
      {t(lang, 'updatesHomeCta')}
    </a>
  </div>

  {
    items.length === 0 ? (
      <p class="text-sm text-gray-500 dark:text-gray-400">{t(lang, 'updatesEmpty')}</p>
    ) : (
      <div class="space-y-5">
        {byDate.map((group) => (
          <div>
            <div class="flex items-baseline justify-between text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 tabular-nums border-b border-subtle pb-1.5 mb-3">
              <span>{formatDayHeader(group.date, lang)}</span>
              <span>{t(lang, 'updatesCount').replace('{n}', String(group.updates.length))}</span>
            </div>
            <ul class="space-y-3">
              {group.updates.map((u) => {
                const chip = TYPE_CHIP[u.type] ?? CHIP_FALLBACK;
                const title = updateText(u, 'title', lang);
                const summary = updateText(u, 'summary', lang);
                const evtKey = u.eventDate ? eventDateLabelKey(u.source) : undefined;
                const showEvent = evtKey && u.eventDate && u.eventDate !== u.date;
                return (
                  <li data-added={u.date}>
                    <div class="flex items-baseline gap-2 flex-wrap mb-0.5">
                      <span
                        data-new-dot
                        class="hidden w-1.5 h-1.5 rounded-full bg-primary self-center"
                        aria-hidden="true"
                      />
                      <span class={`text-[11px] uppercase tracking-wider font-medium px-2 py-0.5 rounded ${chip}`}>
                        {typeLabel(u.type, lang)}
                      </span>
                      {u.href ? (
                        <a
                          href={localizedHref(u.href, lang)}
                          class="font-medium text-gray-900 dark:text-white leading-snug hover:text-primary transition-colors"
                        >
                          {title}
                        </a>
                      ) : (
                        <span class="font-medium text-gray-900 dark:text-white leading-snug">{title}</span>
                      )}
                      {showEvent && (
                        <span class="text-[11px] text-gray-400 dark:text-gray-500 tabular-nums whitespace-nowrap">
                          {t(lang, evtKey)} {formatEventDate(u.eventDate!, lang)}
                        </span>
                      )}
                    </div>
                    {summary && <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{summary}</p>}
                    {u.links && u.links.length > 0 && (
                      <div class="mt-1 flex gap-x-4 gap-y-1 flex-wrap text-xs">
                        {u.links.map((link) => (
                          <a
                            href={localizedHref(link.href, lang)}
                            class="text-primary hover:text-secondary underline-offset-4 hover:underline"
                          >
                            {linkLabel(link, lang)} →
                          </a>
                        ))}
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    )
  }
</div>
