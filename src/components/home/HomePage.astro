---
// Lang-aware homepage body. Single source of structure for both
// `src/pages/index.astro` (en) and `src/pages/[lang]/index.astro`. Page
// files are thin wrappers that supply metadata + JSON-LD; all section
// ordering, layout, and copy lookups live here.
//
// News-front-page layout (v0.21):
//   S0  Masthead        — latest-developments strip: data scale + updated date
//   S1  Front page      — 2-col: focus headline + updates feed + latest
//                         debates | sidebar (tracker mini / browse / hot)
//   S2  Domain directory— one card per dataset with count + latest addition
//   S3  Start here      — compressed thesis + task entries + lever map
//   S4  Closing thesis
//
// The old hero-thesis-first layout buried "what's new" below the fold;
// this order leads with freshness and keeps the editorial argument as the
// second act for first-time readers.

import { Icon } from 'astro-icon/components';
import { t, localizedHref, type Lang } from '~/i18n';
import Masthead from '~/components/home/Masthead.astro';
import FocusHeadline from '~/components/home/FocusHeadline.astro';
import LatestUpdatesFeed from '~/components/home/LatestUpdatesFeed.astro';
import LatestDebates from '~/components/home/LatestDebates.astro';
import HomeSidebar from '~/components/home/HomeSidebar.astro';
import DomainDirectory from '~/components/home/DomainDirectory.astro';
import LeverMap from '~/components/home/LeverMap.astro';
import TaskEntries from '~/components/home/TaskEntries.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

{/* S0 · Masthead — freshness signal above everything. */}
<Masthead lang={lang} />

{
  /* S1 · Front page — newspaper two-column: main column stacks focus
    headline → latest updates → latest debates; sticky sidebar carries the
    tracker mini-dashboard, browse entry points, and hot sections. On
    mobile the DOM order (main first, sidebar second) is the reading
    order — no reordering hacks. */
}
<section class="pt-10 md:pt-14 pb-12 md:pb-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[2fr_1fr] md:gap-10 lg:gap-14">
      <div class="min-w-0 space-y-12">
        <FocusHeadline lang={lang} />
        <LatestUpdatesFeed lang={lang} limit={8} />
        <LatestDebates lang={lang} limit={6} />
      </div>
      <div class="min-w-0 md:sticky md:top-20 md:self-start">
        <HomeSidebar lang={lang} />
      </div>
    </div>
  </div>
</section>

{/* S2 · Domain directory — every dataset, one card, latest addition. */}
<DomainDirectory lang={lang} />

{
  /* S3 · Start here — the editorial argument, now the second act.
    Compressed thesis (was the hero), task entry cards, lever map. */
}
<section class="pt-12 md:pt-16 border-t border-subtle">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <p class="text-xs uppercase tracking-[0.18em] text-primary font-semibold mb-4">
      {t(lang, 'fpStartHereSection')}
    </p>
    <h2 class="t-h2 text-gray-900 dark:text-white mb-4 max-w-3xl">
      {t(lang, 'heroHeadline')}{lang === 'en' ? ' ' : ''}{t(lang, 'heroHeadline2')}
    </h2>
    <p class="t-lead text-gray-700 dark:text-gray-300 mb-6 max-w-prose">
      {t(lang, 'heroSubtitle')}
    </p>
    <div class="flex flex-wrap gap-4 items-center">
      <a
        href={localizedHref('/singapore-ai-strategy-the-real-moat/', lang)}
        class="inline-flex items-center gap-2 bg-primary hover:bg-secondary text-white font-semibold px-5 py-3 rounded-md transition-colors text-sm"
      >
        {t(lang, 'ctaReadCore')}
        <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
      <a
        href={localizedHref('/blog/', lang)}
        class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary transition-colors underline-offset-4 hover:underline"
      >
        {t(lang, 'ctaBrowseAll')}
      </a>
    </div>
  </div>
</section>

<TaskEntries lang={lang} />

<LeverMap lang={lang} />

{
  /* S4 · Closing thesis tile — the solution. The compressed thesis opens
  with the problem (algorithm isn't the moat), closing answers with the
  proposal (AI-native country = architecture, not scale). */
}
<section class="py-12 md:py-20 border-t border-subtle">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <p class="font-serif text-xl md:text-2xl text-gray-700 dark:text-gray-300 leading-[1.7] mb-6 italic">
      "{t(lang, 'closingThesis')}"
    </p>
    <a
      href={localizedHref('/singapore-ai-native-companies-vs-nations/', lang)}
      class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-secondary transition-colors underline underline-offset-4"
    >
      {t(lang, 'closingCta')}
      <Icon name="tabler:arrow-right" class="w-4 h-4" />
    </a>
  </div>
</section>
