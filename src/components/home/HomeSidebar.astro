---
// Front-page sidebar — three stacked rails next to the main column:
//   1. TrackerMini — the 6 dashboard dimensions as a compact list
//      (replaces the old full-width tracker section)
//   2. QuickBrowse — search / by-time / by-topic entry points
//   3. HotEntries — the 4 highest-traffic domains with live counts and
//      each one's latest addition as a preview line
//
// The search button reuses the header's Pagefind modal (#search-trigger)
// so there is exactly one search UI; /search/ is linked as fallback for
// no-JS readers.

import { Icon } from 'astro-icon/components';
import { dimensions, dataDate as trackerDataDate } from '~/data/tracker';
import { domainStats, harvestedTitle, type DomainKey } from '~/utils/latest-content';
import { TOPICS_ENABLED } from '~/config/features';
import { t, pickLocalized, localizedHref, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const HOT_KEYS: DomainKey[] = ['debates', 'policies', 'videos', 'voices'];
const HOT_LABEL_KEY: Partial<Record<DomainKey, Parameters<typeof t>[1]>> = {
  debates: 'navParliament',
  policies: 'navPolicies',
  videos: 'navVideos',
  voices: 'navVoices',
};
const stats = domainStats();
const hotEntries = HOT_KEYS.map((k) => stats.find((s) => s.key === k)).filter((s): s is NonNullable<typeof s> =>
  Boolean(s)
);

// 4 · In-focus picks — detail pages with proven search demand (GSC 2026-07
// striking-distance queries), hand-picked so each gets a homepage internal
// link. Labels are per-locale Records (zh-tw derives via toTraditional in
// pickLocalized-equivalent form: authored here since these are one-offs).
const picks: Array<{ href: string; label: Record<Lang, string> }> = [
  {
    href: '/startups/',
    label: {
      zh: '新加坡 AI 创业公司全景',
      'zh-tw': '新加坡 AI 創業公司全景',
      en: 'Singapore AI startups map',
      ja: 'シンガポール AI スタートアップ全景',
      ko: '싱가포르 AI 스타트업 전경',
    },
  },
  {
    href: '/policies/national-ai-strategy-20-nais-20/',
    label: {
      zh: '国家 AI 战略 2.0（NAIS 2.0）',
      'zh-tw': '國家 AI 戰略 2.0（NAIS 2.0）',
      en: 'National AI Strategy 2.0 (NAIS 2.0)',
      ja: '国家 AI 戦略 2.0（NAIS 2.0）',
      ko: '국가 AI 전략 2.0(NAIS 2.0)',
    },
  },
  {
    href: '/talent/international-olympiad-in-ai-2027/',
    label: {
      zh: 'IOAI 2027 国际 AI 奥赛（新加坡）',
      'zh-tw': 'IOAI 2027 國際 AI 奧賽（新加坡）',
      en: 'IOAI 2027 — the AI olympiad in Singapore',
      ja: 'IOAI 2027 国際 AI オリンピック（シンガポール）',
      ko: 'IOAI 2027 국제 AI 올림피아드(싱가포르)',
    },
  },
  {
    href: '/talent/national-ai-student-challenge/',
    label: {
      zh: 'NAISC 全国 AI 学生挑战赛',
      'zh-tw': 'NAISC 全國 AI 學生挑戰賽',
      en: 'National AI Student Challenge (NAISC)',
      ja: 'NAISC 全国 AI 学生チャレンジ',
      ko: 'NAISC 전국 AI 학생 챌린지',
    },
  },
  {
    href: '/ecosystem/pdpc/',
    label: {
      zh: 'PDPC 个人数据保护委员会',
      'zh-tw': 'PDPC 個人資料保護委員會',
      en: 'PDPC (Personal Data Protection Commission)',
      ja: 'PDPC 個人データ保護委員会',
      ko: 'PDPC 개인정보보호위원회',
    },
  },
  {
    href: '/ecosystem/ai-trailblazers/',
    label: {
      zh: 'AI Trailblazers 政企共建计划',
      'zh-tw': 'AI Trailblazers 政企共建計劃',
      en: 'AI Trailblazers (with Google Cloud)',
      ja: 'AI Trailblazers 官民共創プログラム',
      ko: 'AI Trailblazers 민관 공동 프로그램',
    },
  },
];
---

<aside class="space-y-8">
  {/* 1 · Tracker mini */}
  <div class="border border-subtle rounded-md p-4 bg-surface">
    <div class="flex items-baseline justify-between mb-3 gap-2">
      <h3 class="font-serif text-base font-semibold text-gray-900 dark:text-white">
        {t(lang, 'homeTrackerSection')}
      </h3>
      <a
        href={localizedHref('/tracker/', lang)}
        class="text-xs text-gray-500 hover:text-primary dark:text-gray-400 transition-colors whitespace-nowrap"
      >
        {t(lang, 'homeTrackerCta')}
      </a>
    </div>
    <ul class="divide-y divide-gray-100 dark:divide-slate-800">
      {
        dimensions.map((dim) => {
          const arrow = dim.trend === 'up' ? '↗' : dim.trend === 'down' ? '↘' : '→';
          const arrowColor =
            dim.trend === 'up'
              ? 'text-emerald-600 dark:text-emerald-400'
              : dim.trend === 'down'
                ? 'text-rose-600 dark:text-rose-400'
                : 'text-gray-400 dark:text-gray-500';
          return (
            <li>
              <a
                href={localizedHref(`/tracker/${dim.id}/`, lang)}
                class="group flex items-center justify-between gap-2 py-1.5 text-sm"
              >
                <span class="min-w-0 text-gray-700 dark:text-gray-300 group-hover:text-primary transition-colors truncate">
                  <span class="mr-1.5">{dim.icon}</span>
                  {pickLocalized(dim, 'title', lang)}
                </span>
                <span class={`shrink-0 tabular-nums ${arrowColor}`}>{arrow}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <div class="mt-2 text-[11px] text-gray-400 dark:text-gray-500 tabular-nums">
      {t(lang, 'trackerLastUpdated')}: {trackerDataDate}
    </div>
  </div>

  {/* 2 · Quick browse */}
  <div>
    <h3 class="text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400 font-semibold mb-3">
      {t(lang, 'fpBrowseSection')}
    </h3>
    <div class="space-y-2">
      <button
        id="home-search-trigger"
        type="button"
        class="w-full flex items-center gap-2 border border-subtle rounded-md px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:border-primary hover:text-primary transition-colors bg-surface"
      >
        <Icon name="tabler:search" class="w-4 h-4 shrink-0" />
        {t(lang, 'searchSiteLabel')}
      </button>
      <a
        href={localizedHref('/timeline/', lang)}
        class="w-full flex items-center gap-2 border border-subtle rounded-md px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:border-primary hover:text-primary transition-colors bg-surface"
      >
        <Icon name="tabler:timeline" class="w-4 h-4 shrink-0" />
        {t(lang, 'fpBrowseByTime')}
      </a>
      {
        TOPICS_ENABLED && (
          <a
            href={localizedHref('/topics/', lang)}
            class="w-full flex items-center gap-2 border border-subtle rounded-md px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:border-primary hover:text-primary transition-colors bg-surface"
          >
            <Icon name="tabler:category" class="w-4 h-4 shrink-0" />
            {t(lang, 'fpBrowseByTopic')}
          </a>
        )
      }
    </div>
  </div>

  {/* 3 · Hot entries */}
  <div>
    <h3 class="text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400 font-semibold mb-3">
      {t(lang, 'fpHotSection')}
    </h3>
    <ul class="space-y-3">
      {
        hotEntries.map((s) => {
          const labelKey = HOT_LABEL_KEY[s.key];
          return (
            <li>
              <a href={localizedHref(s.href, lang)} class="group block">
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-sm font-medium text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                    {labelKey ? t(lang, labelKey) : s.key}
                  </span>
                  <span class="text-xs text-gray-400 dark:text-gray-500 tabular-nums shrink-0">{s.count}</span>
                </div>
                {s.latest && (
                  <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 truncate">
                    {t(lang, 'fpLatestPrefix')}: {harvestedTitle(s.latest, lang)}
                  </div>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  {/* 4 · In-focus picks — internal links to high-demand detail pages. */}
  <div>
    <h3 class="text-xs uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400 font-semibold mb-3">
      {t(lang, 'fpPicksSection')}
    </h3>
    <ul class="space-y-2">
      {
        picks.map((p) => (
          <li>
            <a
              href={localizedHref(p.href, lang)}
              class="text-sm text-gray-700 dark:text-gray-300 hover:text-primary transition-colors"
            >
              {p.label[lang] || p.label.en}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<script>
  // Delegate to the header's search modal so there is one Pagefind UI.
  document.getElementById('home-search-trigger')?.addEventListener('click', () => {
    document.getElementById('search-trigger')?.click();
  });
</script>
