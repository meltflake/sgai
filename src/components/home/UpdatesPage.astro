---
// Full updates listing — used by /updates/ (en) and /[lang]/updates/.
// One row per record. The most recent 8 weeks are grouped by ISO week
// ("8月18日–24日 · 5 条"), everything older by month — sgai adds a handful
// of records a week, so days are too thin and months too coarse for the
// recent stretch.

import { updatesGrouped, type UpdateGroup } from '~/data/updates';
import NewsletterSignup from '~/components/common/NewsletterSignup.astro';
import SinceLastVisit from '~/components/common/SinceLastVisit.astro';
import { localizedHref, t, type Lang } from '~/i18n';
import { formatEventDate, formatMonth, formatWeekRange } from '~/utils/date-format';
import { CHIP_FALLBACK, TYPE_CHIP, eventDateLabelKey, linkLabel, typeLabel, updateText } from '~/utils/update-type-ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const groups: UpdateGroup[] = updatesGrouped(8);

function groupHeading(g: UpdateGroup): string {
  const base = g.kind === 'week' ? formatWeekRange(g.start, g.end, lang) : formatMonth(g.month, lang);
  return `${base} · ${t(lang, 'updatesCount').replace('{n}', String(g.items.length))}`;
}

const totalEntries = groups.reduce((sum, g) => sum + g.items.length, 0);
const rssHref = localizedHref('/updates.rss.xml', lang);
const SCOPE = 'updates-page-list';
---

<section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 max-w-4xl">
  <div class="mb-12">
    <h1 class="t-display text-gray-900 dark:text-white mb-4">{t(lang, 'updatesPageTitle')}</h1>
    <p class="t-lead text-gray-700 dark:text-gray-300 max-w-prose">
      {t(lang, 'updatesPageBlurb')}
    </p>
    <div class="mt-4 flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400 flex-wrap">
      <span class="tabular-nums">{t(lang, 'updatesCount').replace('{n}', String(totalEntries))}</span>
      <SinceLastVisit lang={lang} scope={SCOPE} />
      <a href={rssHref} class="text-primary hover:text-secondary inline-flex items-center gap-1.5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"
          ></circle></svg
        >
        RSS
      </a>
    </div>
  </div>

  <div id={SCOPE}>
    {
      totalEntries === 0 ? (
        <p class="text-sm text-gray-500 dark:text-gray-400">{t(lang, 'updatesEmpty')}</p>
      ) : (
        groups.map((group) => (
          <div class="mb-12">
            <h2 class="font-serif text-lg font-semibold text-gray-700 dark:text-gray-300 mb-4 pb-2 border-b border-subtle">
              {groupHeading(group)}
            </h2>
            <ul class="divide-y divide-gray-200 dark:divide-slate-800">
              {group.items.map((u) => {
                const chip = TYPE_CHIP[u.type] ?? CHIP_FALLBACK;
                const title = updateText(u, 'title', lang);
                const summary = updateText(u, 'summary', lang);
                const evtKey = u.eventDate ? eventDateLabelKey(u.source) : undefined;
                const showEvent = evtKey && u.eventDate && u.eventDate !== u.date;
                return (
                  <li class="py-5" data-added={u.date}>
                    <div class="flex items-baseline gap-4 flex-wrap sm:flex-nowrap">
                      <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 tabular-nums w-24 shrink-0 inline-flex items-center gap-1.5">
                        <span data-new-dot class="hidden w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true" />
                        {u.date}
                      </span>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap mb-1.5">
                          <span class={`text-[11px] uppercase tracking-wider font-medium px-2 py-0.5 rounded ${chip}`}>
                            {typeLabel(u.type, lang)}
                          </span>
                          {u.href ? (
                            <a
                              href={localizedHref(u.href, lang)}
                              class="font-medium text-gray-900 dark:text-white leading-snug hover:text-primary transition-colors"
                            >
                              {title}
                            </a>
                          ) : (
                            <span class="font-medium text-gray-900 dark:text-white leading-snug">{title}</span>
                          )}
                          {showEvent && (
                            <span class="text-[11px] text-gray-400 dark:text-gray-500 tabular-nums whitespace-nowrap">
                              {t(lang, evtKey)} {formatEventDate(u.eventDate!, lang)}
                            </span>
                          )}
                        </div>
                        {summary && <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{summary}</p>}
                        {u.links && u.links.length > 0 && (
                          <div class="mt-2 flex gap-x-4 gap-y-1 flex-wrap text-xs">
                            {u.links.map((link) => (
                              <a
                                href={localizedHref(link.href, lang)}
                                class="text-primary hover:text-secondary underline-offset-4 hover:underline"
                              >
                                {linkLabel(link, lang)} →
                              </a>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      )
    }
  </div>
  <NewsletterSignup />
</section>
