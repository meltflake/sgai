---
// Ask-AI page body — the /ask/ route (all 5 locales). Multi-turn chat over
// POST /api/ask (functions/api/ask.ts, SSE). Conversation lives only in
// sessionStorage; the API is stateless. All copy resolves server-side via
// t() / the PRESETS record, so the client script is language-free.

import { t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';
import { ASK_API_PATH, TURNSTILE_SITE_KEY } from '~/config/ask';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const PRESETS_ZH = [
  '新加坡的国家 AI 战略 NAIS 2.0 讲了什么？',
  '和其他国家比，新加坡 AI 的独特优势在哪里？',
  '新加坡怎么监管生成式 AI 和 deepfake？',
  '国会最近在辩论哪些 AI 议题？',
  'SEA-LION 是什么？下载量怎么样？',
  '新加坡 AI 人才有哪些培养计划？',
];

const PRESETS: Record<Lang, string[]> = {
  zh: PRESETS_ZH,
  'zh-tw': PRESETS_ZH.map((q) => toTraditional(q)),
  en: [
    'What is Singapore’s National AI Strategy 2.0 (NAIS 2.0)?',
    'What makes Singapore’s AI strategy different from other countries?',
    'How does Singapore regulate generative AI and deepfakes?',
    'What AI topics has Parliament debated recently?',
    'What is SEA-LION and how widely is it used?',
    'What AI talent programmes does Singapore run?',
  ],
  ja: [
    'シンガポールの国家 AI 戦略 NAIS 2.0 とは何ですか？',
    '他国と比べたシンガポール AI の強みはどこですか？',
    'シンガポールは生成 AI やディープフェイクをどう規制していますか？',
    '国会では最近どんな AI 議題が討論されていますか？',
    'SEA-LION とは何ですか？どのくらい使われていますか？',
    'シンガポールにはどんな AI 人材育成プログラムがありますか？',
  ],
  ko: [
    '싱가포르의 국가 AI 전략 NAIS 2.0은 어떤 내용인가요?',
    '다른 나라와 비교해 싱가포르 AI의 강점은 무엇인가요?',
    '싱가포르는 생성형 AI와 딥페이크를 어떻게 규제하나요?',
    '국회에서 최근 어떤 AI 의제를 토론했나요?',
    'SEA-LION은 무엇이며 얼마나 사용되나요?',
    '싱가포르에는 어떤 AI 인재 양성 프로그램이 있나요?',
  ],
};

const presets = PRESETS[lang];

const askConfig = {
  lang,
  apiPath: ASK_API_PATH,
  turnstileSiteKey: TURNSTILE_SITE_KEY,
  labels: {
    thinking: t(lang, 'askThinking'),
    quotaLeft: t(lang, 'askQuotaLeft'),
    quotaExceeded: t(lang, 'askQuotaExceeded'),
    errorGeneric: t(lang, 'askErrorGeneric'),
    errorUnavailable: t(lang, 'askErrorUnavailable'),
    retry: t(lang, 'askRetry'),
  },
};
---

<section class="pt-10 md:pt-14 pb-16 md:pb-24">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <h1 class="t-h1 text-gray-900 dark:text-white mb-3">{t(lang, 'navAsk')}</h1>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-2 max-w-prose leading-relaxed">{t(lang, 'askPageDesc')}</p>
    <p class="text-xs text-gray-500 dark:text-gray-500 mb-8 max-w-prose leading-relaxed">{t(lang, 'askDisclaimer')}</p>

    <div id="ask-app" data-ask-config={JSON.stringify(askConfig)}>
      <div id="ask-thread" class="space-y-5 mb-6"></div>

      <div id="ask-empty">
        <p class="text-xs uppercase tracking-[0.18em] text-primary font-semibold mb-3">{t(lang, 'askPresetHeading')}</p>
        <div class="grid sm:grid-cols-2 gap-2 mb-8">
          {
            presets.map((q) => (
              <button
                type="button"
                class="ask-preset text-left text-sm px-4 py-3 rounded-lg border border-subtle bg-surface hover:border-primary hover:text-primary transition-colors leading-relaxed"
                data-q={q}
              >
                {q}
              </button>
            ))
          }
        </div>
      </div>

      <form id="ask-form" class="rounded-lg border border-subtle bg-surface p-3">
        <textarea
          id="ask-input"
          rows="2"
          maxlength="2000"
          placeholder={t(lang, 'askPlaceholder')}
          class="w-full resize-none bg-transparent text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:outline-none leading-relaxed"
        ></textarea>
        <div class="flex items-center justify-between gap-3 mt-2">
          <button
            type="button"
            id="ask-new"
            class="text-xs text-gray-500 dark:text-gray-400 hover:text-primary transition-colors underline-offset-4 hover:underline"
          >
            {t(lang, 'askNewChat')}
          </button>
          <span id="ask-quota" class="text-xs text-gray-400 dark:text-gray-500"></span>
          <button
            type="submit"
            id="ask-send"
            class="bg-primary hover:bg-secondary disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold px-5 py-2 rounded-md transition-colors text-sm"
          >
            {t(lang, 'askSend')}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  type Role = 'user' | 'assistant';
  interface Msg {
    role: Role;
    content: string;
  }
  interface AskConfig {
    lang: string;
    apiPath: string;
    turnstileSiteKey: string;
    labels: Record<string, string>;
  }

  interface TurnstileApi {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    execute: (widgetId: string) => void;
    reset: (widgetId: string) => void;
  }

  const app = document.getElementById('ask-app');
  if (app) initAsk(app);

  function initAsk(app: HTMLElement): void {
    const config: AskConfig = JSON.parse(app.dataset.askConfig || '{}');
    const labels = config.labels || {};
    const thread = document.getElementById('ask-thread') as HTMLElement;
    const empty = document.getElementById('ask-empty') as HTMLElement;
    const form = document.getElementById('ask-form') as HTMLFormElement;
    const input = document.getElementById('ask-input') as HTMLTextAreaElement;
    const quotaEl = document.getElementById('ask-quota') as HTMLElement;
    const sendBtn = document.getElementById('ask-send') as HTMLButtonElement;
    const newBtn = document.getElementById('ask-new') as HTMLButtonElement;

    const storeKey = `sgai_ask_${config.lang}`;
    let messages: Msg[] = [];
    let sessionId = '';
    let busy = false;

    try {
      const saved = JSON.parse(sessionStorage.getItem(storeKey) || 'null');
      if (saved && Array.isArray(saved.messages)) {
        messages = saved.messages;
        sessionId = typeof saved.sessionId === 'string' ? saved.sessionId : '';
      }
    } catch {
      messages = [];
    }
    if (!sessionId) sessionId = crypto.randomUUID();
    renderAll();

    const q = new URLSearchParams(window.location.search).get('q');
    if (q && q.trim()) {
      resetConversation();
      void send(q.trim());
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input.value.trim();
      if (value) void send(value);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });
    newBtn.addEventListener('click', () => {
      resetConversation();
      input.focus();
    });
    app.querySelectorAll<HTMLButtonElement>('.ask-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const preset = btn.dataset.q;
        if (preset) void send(preset);
      });
    });

    function persist(): void {
      try {
        sessionStorage.setItem(storeKey, JSON.stringify({ sessionId, messages }));
      } catch {
        // Storage full/blocked — the conversation just won't survive reloads.
      }
    }

    function resetConversation(): void {
      messages = [];
      sessionId = crypto.randomUUID();
      persist();
      thread.innerHTML = '';
      empty.hidden = false;
    }

    function renderMarkdown(target: HTMLElement, text: string): void {
      const html = DOMPurify.sanitize(String(marked.parse(text, { async: false, gfm: true })));
      target.innerHTML = html;
      target.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
        const href = a.getAttribute('href') || '';
        const external =
          /^https?:\/\//.test(href) && !href.startsWith('https://sgai.md') && !href.startsWith(window.location.origin);
        if (external) {
          a.target = '_blank';
          a.rel = 'noopener';
        }
      });
    }

    function addExchange(question: string): { exchange: HTMLElement; answer: HTMLElement; status: HTMLElement } {
      const exchange = document.createElement('div');
      exchange.className = 'space-y-4';

      const userRow = document.createElement('div');
      userRow.className = 'flex justify-end';
      const userBubble = document.createElement('div');
      userBubble.className =
        'max-w-[85%] rounded-lg bg-primary/10 dark:bg-primary/20 px-4 py-3 text-sm text-gray-900 dark:text-gray-100 whitespace-pre-wrap leading-relaxed';
      userBubble.textContent = question;
      userRow.appendChild(userBubble);

      const answerWrap = document.createElement('div');
      const status = document.createElement('p');
      status.className = 'text-xs text-gray-400 dark:text-gray-500 animate-pulse';
      status.textContent = labels.thinking || '…';
      const answer = document.createElement('div');
      answer.className = 'ask-answer prose prose-sm dark:prose-invert max-w-none leading-relaxed';
      answerWrap.appendChild(status);
      answerWrap.appendChild(answer);

      exchange.appendChild(userRow);
      exchange.appendChild(answerWrap);
      thread.appendChild(exchange);
      exchange.scrollIntoView({ block: 'end', behavior: 'smooth' });
      return { exchange, answer, status };
    }

    function renderAll(): void {
      thread.innerHTML = '';
      empty.hidden = messages.length > 0;
      for (let i = 0; i < messages.length; i += 2) {
        const question = messages[i];
        const reply = messages[i + 1];
        if (!question || question.role !== 'user') continue;
        const { answer, status } = addExchange(question.content);
        status.remove();
        if (reply && reply.role === 'assistant') renderMarkdown(answer, reply.content);
      }
    }

    function showError(
      exchange: HTMLElement,
      answer: HTMLElement,
      status: HTMLElement,
      message: string,
      question: string
    ): void {
      status.remove();
      answer.classList.remove('prose', 'prose-sm', 'dark:prose-invert');
      answer.innerHTML = '';
      const note = document.createElement('p');
      note.className = 'text-sm text-gray-600 dark:text-gray-400';
      note.textContent = message;
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'mt-2 text-sm font-medium text-primary hover:underline underline-offset-4';
      retry.textContent = labels.retry || 'Retry';
      retry.addEventListener('click', () => {
        exchange.remove();
        void send(question);
      });
      answer.appendChild(note);
      answer.appendChild(retry);
    }

    // --- Turnstile (only active when a site key is configured) ---
    let turnstileWidgetId: string | null = null;
    let turnstileResolve: ((token: string) => void) | null = null;

    function loadTurnstileScript(): Promise<TurnstileApi | null> {
      const existing = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
      if (existing) return Promise.resolve(existing);
      return new Promise((resolve) => {
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        s.async = true;
        s.onload = () => resolve((window as unknown as { turnstile?: TurnstileApi }).turnstile || null);
        s.onerror = () => resolve(null);
        document.head.appendChild(s);
      });
    }

    async function getTurnstileToken(): Promise<string> {
      if (!config.turnstileSiteKey) return '';
      const turnstile = await loadTurnstileScript();
      if (!turnstile) return '';
      if (turnstileWidgetId === null) {
        const host = document.createElement('div');
        host.style.display = 'none';
        document.body.appendChild(host);
        turnstileWidgetId = turnstile.render(host, {
          sitekey: config.turnstileSiteKey,
          size: 'invisible',
          callback: (token: string) => {
            if (turnstileResolve) turnstileResolve(token);
          },
        });
      }
      return new Promise((resolve) => {
        turnstileResolve = resolve;
        turnstile.reset(turnstileWidgetId as string);
        turnstile.execute(turnstileWidgetId as string);
        setTimeout(() => resolve(''), 15000);
      });
    }

    function errorMessageFor(code: string | undefined): string {
      if (code === 'quota_exceeded' || code === 'global_quota_exceeded')
        return labels.quotaExceeded || 'Daily limit reached.';
      if (code === 'unavailable') return labels.errorUnavailable || 'Not available yet.';
      return labels.errorGeneric || 'Something went wrong.';
    }

    async function send(question: string): Promise<void> {
      if (busy) return;
      busy = true;
      sendBtn.disabled = true;
      empty.hidden = true;
      input.value = '';

      const history = messages.slice(-12);
      const { exchange, answer, status } = addExchange(question);
      let streamed = '';

      try {
        const turnstileToken = await getTurnstileToken();
        const res = await fetch(config.apiPath, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question, history, lang: config.lang, sessionId, turnstileToken }),
        });

        if (!res.ok || !res.body) {
          let code: string | undefined;
          try {
            const payload = await res.json();
            code = payload?.error?.code;
          } catch {
            code = undefined;
          }
          showError(exchange, answer, status, errorMessageFor(code), question);
          if (code === 'quota_exceeded' || code === 'global_quota_exceeded') {
            quotaEl.textContent = (labels.quotaLeft || '{n}').replace('{n}', '0');
          }
          return;
        }

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let failed = false;

        const handleEvent = (raw: string): void => {
          let event = '';
          let data = '';
          for (const line of raw.split('\n')) {
            if (line.startsWith('event:')) event = line.slice(6).trim();
            else if (line.startsWith('data:')) data += line.slice(5).trim();
          }
          if (!event) return;
          if (event === 'meta') {
            try {
              const meta = JSON.parse(data);
              if (typeof meta.remaining === 'number') {
                quotaEl.textContent = (labels.quotaLeft || '{n}').replace('{n}', String(meta.remaining));
              }
            } catch {
              // Ignore malformed meta.
            }
          } else if (event === 'delta') {
            try {
              const delta = JSON.parse(data);
              if (typeof delta.text === 'string') {
                if (!streamed) status.remove();
                streamed += delta.text;
                renderMarkdown(answer, streamed);
              }
            } catch {
              // Ignore malformed delta.
            }
          } else if (event === 'error') {
            failed = true;
            showError(exchange, answer, status, errorMessageFor('upstream'), question);
          }
        };

        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          let sep: number;
          while ((sep = buffer.indexOf('\n\n')) !== -1) {
            handleEvent(buffer.slice(0, sep));
            buffer = buffer.slice(sep + 2);
          }
        }

        if (failed || !streamed.trim()) {
          if (!failed) showError(exchange, answer, status, errorMessageFor(undefined), question);
          return;
        }

        messages.push({ role: 'user', content: question });
        messages.push({ role: 'assistant', content: streamed });
        persist();
      } catch {
        showError(exchange, answer, status, errorMessageFor(undefined), question);
      } finally {
        busy = false;
        sendBtn.disabled = false;
      }
    }
  }
</script>
