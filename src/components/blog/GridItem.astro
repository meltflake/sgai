---
// Text-only card for the related-posts grid. Posts on this site carry no
// cover image (see scripts/generate-og-images.ts), so the template's
// fixed-height image box rendered as an empty grey block on every card.
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import { getLangFromPath, localizedHref } from '~/i18n';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = getLangFromPath(new URL(Astro.url).pathname);
const link = APP_BLOG?.post?.isEnabled ? localizedHref(getPermalink(post.permalink, 'post'), lang) : '';
---

<article
  class="mb-6 flex flex-col h-full rounded border border-gray-200 dark:border-slate-700 p-5 transition intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  <p class="text-sm text-muted dark:text-slate-400 mb-2">
    <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate, lang)}</time>
    {post.category && <span> · {post.category.title}</span>}
  </p>

  <h3 class="t-h3 mb-2 dark:text-slate-300">
    {
      link ? (
        <a class="inline-block hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200" href={link}>
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h3>

  <p class="text-muted dark:text-slate-400 line-clamp-4">{post.excerpt}</p>
</article>
