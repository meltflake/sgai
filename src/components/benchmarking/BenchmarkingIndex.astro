---
import { Icon } from 'astro-icon/components';

import Headline from '~/components/ui/Headline.astro';
import Layout from '~/layouts/PageLayout.astro';
import CrossDomainRail from '~/components/listing/CrossDomainRail.astro';
import LatestAdditions from '~/components/listing/LatestAdditions.astro';
import {
  benchmarkCaseProfileUpdated,
  benchmarkCases,
  dataDate,
  dataDisclaimer,
  dataDisclaimerEn,
  dataDisclaimerJa,
  dataDisclaimerKo,
  insights,
  regions,
  reportArchive,
} from '~/data/benchmarking';
import { localizedHref, pickLocalized, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';
import { benchmarkCaseSlug, regionPages, regionSlug } from '~/utils/entity-pages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const DISCLAIMER_BY_LANG: Record<Lang, string> = {
  zh: dataDisclaimer,
  en: dataDisclaimerEn || dataDisclaimer,
  ja: dataDisclaimerJa || dataDisclaimerEn || dataDisclaimer,
  ko: dataDisclaimerKo || dataDisclaimerEn || dataDisclaimer,
  'zh-tw': toTraditional(dataDisclaimer),
};
const disclaimer = DISCLAIMER_BY_LANG[lang];

// The en route renders this pull-quote with typographic curly quotes (its
// pre-refactor text); ja/zh-tw/ko keep the straight-quote string the [lang]
// pages always rendered.
const PULL_QUOTE_STRAIGHT =
  'Useful benchmarking is not "Country X is strong at AI". It asks which concrete object became a national capability: a fund, a university, a model, a testing framework, a government assistant, or a supply-chain node.';
const PULL_QUOTE_ZH =
  '真正有用的对标，不是"某国 AI 很强"这种空话，而是看它把哪个具体对象做成了国家能力：一只基金、一所大学、一个模型、一套测试框架、一个政府 AI 助手，或一个供应链节点。';
const PULL_QUOTE_JA =
  '本当に有用なベンチマークとは「某国は AI に強い」といった空論ではなく、どの具体的な対象を国家的能力へと変えたかを見ることだ——一つのファンド、一つの大学、一つのモデル、一つのテスト枠組み、一つの政府 AI アシスタント、あるいは一つのサプライチェーン・ノード。';
const PULL_QUOTE_KO =
  "정말 유용한 벤치마킹은 '어느 나라가 AI에 강하다'는 공허한 말이 아니라, 어떤 구체적 대상을 국가 역량으로 만들었는지를 보는 것이다——하나의 펀드, 하나의 대학, 하나의 모델, 하나의 테스트 프레임워크, 하나의 정부 AI 어시스턴트, 또는 하나의 공급망 노드.";
let pullQuoteCopy = PULL_QUOTE_STRAIGHT;
if (lang === 'zh') pullQuoteCopy = PULL_QUOTE_ZH;
if (lang === 'zh-tw') pullQuoteCopy = toTraditional(PULL_QUOTE_ZH);
if (lang === 'ja') pullQuoteCopy = PULL_QUOTE_JA;
if (lang === 'ko') pullQuoteCopy = PULL_QUOTE_KO;
if (lang === 'en')
  pullQuoteCopy =
    'Useful benchmarking is not “Country X is strong at AI”. It asks which concrete object became a national capability: a fund, a university, a model, a testing framework, a government assistant, or a supply-chain node.';
const insightCaseIds = ['ai-verify', 'mgx-ai-fund', 'unit-8200-ai-talent-pipeline', 'falcon-llm'];
const caseById = new Map(benchmarkCases.map((caseItem) => [caseItem.id, caseItem]));

function caseHref(caseItem: (typeof benchmarkCases)[number]): string {
  return localizedHref(`/benchmarking/${benchmarkCaseSlug(caseItem)}/`, lang);
}

function insightHref(index: number): string {
  const caseItem = caseById.get(insightCaseIds[index]);
  return caseItem ? caseHref(caseItem) : localizedHref('/benchmarking/', lang);
}
---

<Layout
  metadata={{
    title: t(lang, 'benchmarkingPageTitle'),
    description: t(lang, 'benchmarkingPageDesc'),
  }}
  breadcrumbs={[{ label: t(lang, 'navBenchmarking') }]}
  lang={lang}
>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 max-w-6xl">
    <Headline
      title={t(lang, 'benchmarkingPageTitle')}
      subtitle={t(lang, 'benchmarkIntroSubtitle')}
      classes={{ title: 'text-3xl md:text-4xl', subtitle: 'text-lg md:text-xl' }}
    />
    <LatestAdditions lang={lang} source="benchmark" class="mt-8 mb-2" />

    <div class="mb-12 grid gap-4 md:grid-cols-[1.25fr_0.75fr]">
      <div class="callout-note rounded-lg p-6">
        <p class="font-serif text-lg leading-[1.85] text-gray-900 dark:text-white">
          {pullQuoteCopy}
        </p>
      </div>
      <dl class="grid gap-3 sm:grid-cols-3 md:grid-cols-1">
        <div class="rounded-lg border border-subtle bg-surface p-4">
          <dt class="text-xs uppercase tracking-wider text-muted">{t(lang, 'benchmarkStatCaseProfiles')}</dt>
          <dd class="mt-1 t-stat text-gray-900 dark:text-white">{benchmarkCases.length}</dd>
        </div>
        <div class="rounded-lg border border-subtle bg-surface p-4">
          <dt class="text-xs uppercase tracking-wider text-muted">{t(lang, 'benchmarkStatRegionProfiles')}</dt>
          <dd class="mt-1 t-stat text-gray-900 dark:text-white">{regionPages.length}</dd>
        </div>
        <div class="rounded-lg border border-subtle bg-surface p-4">
          <dt class="text-xs uppercase tracking-wider text-muted">{t(lang, 'benchmarkStatProfilesUpdated')}</dt>
          <dd class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">{benchmarkCaseProfileUpdated}</dd>
        </div>
      </dl>
    </div>

    <div class="mb-12">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between mb-5">
        <div>
          <h2 class="t-h3">{t(lang, 'benchmarkLibraryHeading')}</h2>
          <p class="text-sm text-muted mt-1">
            {t(lang, 'benchmarkLibrarySubtitle')}
          </p>
        </div>
        <a href="#region-overview" class="text-sm text-primary hover:text-secondary inline-flex items-center gap-1">
          {t(lang, 'benchmarkViewRegionOverview')}
          <Icon name="tabler:arrow-down" class="w-4 h-4" />
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          benchmarkCases.map((caseItem) => (
            <a
              href={caseHref(caseItem)}
              class="group flex h-full flex-col rounded-lg border border-subtle bg-surface p-5 hover:border-primary/50 hover:shadow-sm transition-all"
            >
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-xs text-muted">
                    {caseItem.flag} {pickLocalized(caseItem, 'region', lang)} · {pickLocalized(caseItem, 'type', lang)}
                  </p>
                  <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white group-hover:text-primary">
                    {pickLocalized(caseItem, 'name', lang)}
                  </h3>
                </div>
                <Icon name="tabler:arrow-up-right" class="w-5 h-5 text-muted group-hover:text-primary shrink-0" />
              </div>
              <p class="mt-3 text-sm leading-relaxed text-gray-700 dark:text-gray-300">
                {pickLocalized(caseItem, 'headline', lang)}
              </p>
              <dl class="mt-4 grid gap-2 text-xs">
                {caseItem.facts.slice(0, 2).map((fact) => (
                  <div class="flex items-start justify-between gap-3 border-t border-subtle pt-2">
                    <dt class="text-muted">{pickLocalized(fact, 'label', lang)}</dt>
                    <dd class="text-right font-medium text-gray-900 dark:text-white">
                      {pickLocalized(fact, 'value', lang)}
                    </dd>
                  </div>
                ))}
              </dl>
              <span class="mt-auto pt-5 text-sm font-medium text-primary inline-flex items-center gap-1">
                {t(lang, 'openProfileCta')}
                <Icon name="tabler:arrow-right" class="w-4 h-4" />
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="mb-12">
      <h2 class="t-h3 mb-4">{t(lang, 'benchmarkKeyInsightsHeading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          insights.map((insight, index) => (
            <a
              href={insightHref(index)}
              class="group rounded-lg border border-subtle bg-surface p-5 hover:border-primary/50 hover:shadow-sm transition-all"
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-bold text-lg text-gray-900 dark:text-white group-hover:text-primary">
                  {pickLocalized(insight, 'title', lang)}
                </h3>
                <Icon name="tabler:arrow-up-right" class="w-5 h-5 text-muted group-hover:text-primary shrink-0" />
              </div>
              <p class="text-muted text-sm leading-relaxed mt-2">{pickLocalized(insight, 'text', lang)}</p>
            </a>
          ))
        }
      </div>
    </div>

    <div id="region-overview" class="mb-12 scroll-mt-24">
      <h2 class="t-h3 mb-4">{t(lang, 'benchmarkOverviewComparisonHeading')}</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse min-w-[900px]">
          <thead>
            <tr class="bg-slate-100 dark:bg-slate-800">
              <th class="text-left p-3 border border-subtle">{t(lang, 'benchmarkColRegion')}</th>
              <th class="text-left p-3 border border-subtle">{t(lang, 'benchmarkColCoreStrategy')}</th>
              <th class="text-left p-3 border border-subtle">{t(lang, 'benchmarkColYear')}</th>
              <th class="text-left p-3 border border-subtle">{t(lang, 'benchmarkColInvestment')}</th>
              <th class="text-left p-3 border border-subtle">{t(lang, 'benchmarkColGovernance')}</th>
              <th class="text-left p-3 border border-subtle">{t(lang, 'benchmarkColStrength')}</th>
              <th class="text-left p-3 border border-subtle">{t(lang, 'benchmarkColAiRanking')}</th>
            </tr>
          </thead>
          <tbody>
            {
              regions.map((r, i) => (
                <tr
                  class={
                    i === 0
                      ? 'bg-blue-50 dark:bg-blue-900/20 font-semibold'
                      : 'hover:bg-slate-50 dark:hover:bg-slate-800/50'
                  }
                >
                  <td class="p-3 border border-subtle whitespace-nowrap">
                    <a
                      href={localizedHref(`/benchmarking/${regionSlug(r)}/`, lang)}
                      class="text-primary hover:text-secondary inline-flex items-center gap-1"
                    >
                      <span>
                        {r.flag} {pickLocalized(r, 'name', lang)}
                      </span>
                      <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" />
                    </a>
                  </td>
                  <td class="p-3 border border-subtle">{pickLocalized(r, 'strategy', lang)}</td>
                  <td class="p-3 border border-subtle">{r.strategyYear}</td>
                  <td class="p-3 border border-subtle">{pickLocalized(r, 'investment', lang)}</td>
                  <td class="p-3 border border-subtle">{pickLocalized(r, 'governance', lang)}</td>
                  <td class="p-3 border border-subtle">{pickLocalized(r, 'strength', lang)}</td>
                  <td class="p-3 border border-subtle text-muted">{r.aiRanking || '—'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mb-12">
      <h2 class="t-h3 mb-5">{t(lang, 'benchmarkRegionPagesHeading')}</h2>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          regionPages.map((page) => (
            <a
              href={localizedHref(`/benchmarking/${page.slug}/`, lang)}
              class="group rounded-lg border border-subtle bg-surface p-5 hover:border-primary/50 hover:shadow-sm transition-all"
            >
              <p class="text-xs text-muted">
                {page.summary.strategyYear} · {pickLocalized(page.summary, 'governance', lang)}
              </p>
              <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white group-hover:text-primary">
                {page.summary.flag} {pickLocalized(page.summary, 'name', lang)}
              </h3>
              <p class="mt-2 text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                {pickLocalized(page.summary, 'strength', lang)}
              </p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary">
                {t(lang, 'benchmarkViewRegionProfile')}
                <Icon name="tabler:arrow-right" class="w-4 h-4" />
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="mb-12">
      <h2 class="t-h3 mb-2">{t(lang, 'benchmarkReportArchiveHeading')}</h2>
      <p class="text-sm text-muted mb-5 max-w-3xl">{t(lang, 'benchmarkReportArchiveIntro')}</p>
      <div class="space-y-3">
        {
          reportArchive.map((edition) => (
            <details class="group rounded-lg border border-subtle bg-surface">
              <summary class="flex cursor-pointer items-center justify-between gap-3 p-4 select-none">
                <span class="flex items-baseline gap-3">
                  <span class="text-lg font-bold text-gray-900 dark:text-white">{edition.year}</span>
                  <span class="text-sm text-gray-700 dark:text-gray-300">{pickLocalized(edition, 'title', lang)}</span>
                </span>
                <Icon
                  name="tabler:chevron-down"
                  class="w-4 h-4 text-muted transition-transform group-open:rotate-180"
                />
              </summary>
              <div class="px-4 pb-4">
                <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                  {pickLocalized(edition, 'description', lang)}
                </p>
                <a
                  href={edition.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-secondary"
                >
                  {t(lang, 'benchmarkReportArchiveRead')}
                  <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" />
                </a>
              </div>
            </details>
          ))
        }
      </div>
    </div>

    <div class="p-4 rounded-lg bg-slate-50 dark:bg-slate-800 border border-subtle">
      <p class="text-sm text-muted">⚠️ {disclaimer}</p>
      <p class="text-xs text-muted mt-1">
        {t(lang, 'benchmarkBaseDataUpdated')}: {dataDate};{' '}
        {t(lang, 'benchmarkCaseProfilesCurated')}: {benchmarkCaseProfileUpdated}
      </p>
    </div>
  </section>
  <CrossDomainRail lang={lang} current="benchmarking" class="max-w-6xl mx-auto px-4 sm:px-6 pb-16" />
</Layout>
