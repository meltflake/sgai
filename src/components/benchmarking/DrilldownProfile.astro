---
import { Icon } from 'astro-icon/components';

import JsonLd from '~/components/common/JsonLd.astro';
import Layout from '~/layouts/PageLayout.astro';
import { benchmarkCaseProfileUpdated } from '~/data/benchmarking';
import { getBenchmarkDrilldownsForRegion, type BenchmarkDrilldownPage } from '~/utils/entity-pages';
import { IN_LANGUAGES, localizedHref, pickLocalized, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';
import { synthesizeMetaDescription } from '~/utils/utils';

interface Props {
  page: BenchmarkDrilldownPage;
  lang: Lang;
}

const { page, lang } = Astro.props;
// Drilldown pages are synthesized in entity-pages.ts with full zh/en/ja/ko
// siblings (templates authored per locale; data values ride
// `xJa || xEn || x` chains). pickLocalized resolves each locale directly and
// derives zh-tw from zh via OpenCC. scripts/evals/entity-pages-i18n/check.ts
// hard-gates any future En-only synthesized field.
const benchmarkRoot = localizedHref('/benchmarking/', lang);

const title = pickLocalized<string>(page, 'title', lang) || page.title;
const description = pickLocalized<string>(page, 'description', lang) || page.description;
const body = pickLocalized<string>(page, 'body', lang) || page.body;
const category = pickLocalized<string>(page, 'category', lang) || page.category;
const regionName = pickLocalized<string>(page.region.summary, 'name', lang) || page.region.summary.name;
const regionHref = `${benchmarkRoot}${page.region.slug}/`;
const inheritedSources = (pickLocalized<string[]>(page, 'sources', lang) as string[] | null) || page.sources;
const analysisSources = page.analysisSources;

const relatedDrilldowns = getBenchmarkDrilldownsForRegion(page.region.slug)
  .filter((candidate) => candidate.slug !== page.slug)
  .slice(0, 6);

// Page-local data note + back label. zh source with zh-tw derived via OpenCC;
// en/ja/ko hand-written.
const dataNotePendingZh = `本页由地区对标数据自动生成，深度分析尚未补齐（整理于 ${benchmarkCaseProfileUpdated}）。在补深之前不进入搜索索引。`;
const dataNoteReadyZh = `已补深的对标下钻档案，最近整理于 ${benchmarkCaseProfileUpdated}。`;
const dataNotePendingByLang: Record<Lang, string> = {
  zh: dataNotePendingZh,
  'zh-tw': toTraditional(dataNotePendingZh),
  en: `This page is auto-generated from regional benchmark data and is awaiting deep analysis (curated on ${benchmarkCaseProfileUpdated}). It is excluded from search indexing until enrichment lands.`,
  ja: `本ページは地域ベンチマークデータから自動生成され、詳細分析は今後追加予定です（${benchmarkCaseProfileUpdated} 整理）。補強されるまで検索インデックスには含まれません。`,
  ko: `이 페이지는 지역 벤치마크 데이터로 자동 생성되며 심층 분석은 아직 보완 중입니다(${benchmarkCaseProfileUpdated} 정리). 보완 전까지 검색 색인에 포함되지 않습니다.`,
};
const dataNoteReadyByLang: Record<Lang, string> = {
  zh: dataNoteReadyZh,
  'zh-tw': toTraditional(dataNoteReadyZh),
  en: `Curated benchmark drilldown profile, last updated ${benchmarkCaseProfileUpdated}.`,
  ja: `補強済みのベンチマーク詳細ファイル、最終整理日 ${benchmarkCaseProfileUpdated}。`,
  ko: `보완 완료된 벤치마크 세부 파일, 최근 정리 ${benchmarkCaseProfileUpdated}.`,
};
const backToByLang: Record<Lang, string> = {
  zh: `返回 ${regionName}`,
  'zh-tw': `${toTraditional('返回')} ${regionName}`,
  en: `Back to ${regionName}`,
  ja: `${regionName} に戻る`,
  ko: `${regionName}(으)로 돌아가기`,
};

const labels = {
  benchmarkCrumb: t(lang, 'benchmarkCrumb'),
  drilldownEyebrow: t(lang, 'benchmarkDrilldownEyebrow'),
  expandHeading: t(lang, 'benchmarkExpandHeading'),
  sourcesHeading: t(lang, 'benchmarkReferencesHeading'),
  relatedHeading: t(lang, 'benchmarkContinueRegion'),
  dataNoteHeading: t(lang, 'benchmarkDataNoteHeading'),
  dataNote: page.analysisPending
    ? dataNotePendingByLang[lang] || dataNotePendingByLang.en
    : dataNoteReadyByLang[lang] || dataNoteReadyByLang.en,
  backTo: backToByLang[lang] || backToByLang.en,
};

// "<region> benchmark" label — the separator between the region name and the
// suffix is baked per-locale (a Latin space for en, direct concatenation for CJK).
const regionBenchmarkLabelByLang: Record<Lang, string> = {
  zh: `${regionName}国际对标`,
  'zh-tw': `${regionName}${toTraditional('国际对标')}`,
  en: `${regionName} Benchmark`,
  ja: `${regionName}国際ベンチマーク`,
  ko: `${regionName} 국제 벤치마크`,
};
// description alone is one thin line ("HK$3 billion — subsidies …");
// on enriched pages, chain the human-written analysis body behind it so
// the SERP snippet carries substance. Pending pages keep the plain
// description: they are noindex and their auto-generated body is
// boilerplate that just repeats the title. Both fields are synthesized
// with full 4-locale siblings (see the note at the top of this file),
// so no per-locale gating is needed here.
const baseMetadata = {
  title: `${title} · ${regionBenchmarkLabelByLang[lang] || regionBenchmarkLabelByLang.en}`,
  description: page.analysisPending ? description : synthesizeMetaDescription([description, body]) || description,
};

// Until per-drilldown enrichment lands, mark the page noindex,follow so
// thin auto-generated stubs don't erode site-wide SEO quality. Once an
// entry exists in `RegionDetail.drilldownEnrichments`, page.analysisPending
// flips to false and the page becomes regularly indexable.
const metadata = page.analysisPending ? { ...baseMetadata, robots: { index: false, follow: true } } : baseMetadata;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: benchmarkCaseProfileUpdated,
  dateModified: benchmarkCaseProfileUpdated,
  inLanguage: IN_LANGUAGES[lang],
  mainEntityOfPage: new URL(Astro.url).href,
  about: [
    { '@type': 'Thing', name: page.titleEn || page.title },
    { '@type': 'Place', name: page.region.summary.nameEn || page.region.summary.name },
  ],
  isPartOf: {
    '@type': 'WebSite',
    name: t(lang, 'siteName'),
    url: 'https://sgai.md/',
  },
};

const breadcrumbs = [
  { label: labels.benchmarkCrumb, href: localizedHref('/benchmarking/', lang) },
  { label: regionName, href: regionHref },
  { label: title },
];
---

<Layout metadata={metadata} breadcrumbs={breadcrumbs} lang={lang}>
  <JsonLd schema={articleSchema} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <header class="mb-8">
      <div class="mb-5 flex flex-wrap items-center gap-2 text-xs">
        <a
          href={regionHref}
          class="inline-flex items-center gap-1 bg-primary/10 text-primary px-3 py-1.5 rounded font-semibold hover:bg-primary/15 transition-colors"
        >
          <Icon name="tabler:arrow-left" class="w-3.5 h-3.5" />
          {regionName}
        </a>
        <span class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-3 py-1.5 rounded">
          {category}
        </span>
      </div>

      <p class="text-xs uppercase tracking-[0.18em] text-primary font-semibold mb-4">
        {labels.drilldownEyebrow}
        {benchmarkCaseProfileUpdated}
      </p>
      <h1 class="t-display text-gray-900 dark:text-white mb-3">{title}</h1>
      <p class="t-lead text-gray-700 dark:text-gray-300 mt-6">{description}</p>
    </header>

    <dl
      class="bg-surface rounded-lg border border-subtle p-5 mb-10 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm"
    >
      {
        page.facts.map((fact) => (
          <div>
            <dt class="text-xs uppercase tracking-wider text-muted mb-1">
              {pickLocalized(fact, 'label', lang) || fact.label}
            </dt>
            <dd class="text-gray-900 dark:text-white">{pickLocalized(fact, 'value', lang) || fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <section class="mb-10">
      <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.expandHeading}</h2>
      <p class="text-base leading-[1.85] text-gray-800 dark:text-gray-200">{body}</p>
    </section>

    {
      analysisSources && analysisSources.length > 0 && (
        <section class="mb-10">
          <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.sourcesHeading}</h2>
          <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
            {analysisSources.map((source) => (
              <li>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1 text-primary hover:text-secondary"
                >
                  {pickLocalized(source, 'label', lang) || source.label}
                  {source.date && <span class="text-muted ml-1 text-xs">· {source.date}</span>}
                  <Icon name="tabler:external-link" class="w-3.5 h-3.5" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (!analysisSources || analysisSources.length === 0) && inheritedSources.length > 0 && (
        <section class="mb-10">
          <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.sourcesHeading}</h2>
          <ul class="space-y-1 text-sm text-gray-500 dark:text-gray-400">
            {inheritedSources.map((source) => (
              <li>• {source}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      relatedDrilldowns.length > 0 && (
        <section class="mb-10">
          <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.relatedHeading}</h2>
          <div class="grid gap-3 md:grid-cols-2">
            {relatedDrilldowns.map((related) => (
              <a
                href={`${benchmarkRoot}${related.slug}/`}
                class="group bg-surface rounded-lg p-4 border border-subtle hover:border-primary/50 hover:shadow-sm transition-all"
              >
                <p class="text-xs text-muted">{pickLocalized(related, 'category', lang) || related.category}</p>
                <h3 class="mt-1 font-semibold text-gray-900 dark:text-white group-hover:text-primary">
                  {pickLocalized(related, 'title', lang) || related.title}
                </h3>
                <p class="mt-2 text-xs text-gray-600 dark:text-gray-400 line-clamp-2">
                  {pickLocalized(related, 'description', lang) || related.description}
                </p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="mb-10 pt-6 border-t border-subtle">
      <h2 class="text-sm uppercase tracking-wider text-muted font-semibold mb-3">{labels.dataNoteHeading}</h2>
      <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">{labels.dataNote}</p>
    </section>

    <nav class="mt-12 pt-6 border-t border-subtle">
      <a href={regionHref} class="text-sm text-primary hover:text-secondary font-medium inline-flex items-center gap-1">
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        {labels.backTo}
      </a>
    </nav>
  </article>
</Layout>
