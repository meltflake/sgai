---
import { Icon } from 'astro-icon/components';

import JsonLd from '~/components/common/JsonLd.astro';
import Layout from '~/layouts/PageLayout.astro';
import { dataDate, dataDisclaimer, dataDisclaimerEn } from '~/data/benchmarking';
import { getBenchmarkDrilldownsForRegion, regionPages, type RegionPage } from '~/utils/entity-pages';
import { IN_LANGUAGES, localizedHref, pickLocalized, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';

interface Props {
  page: RegionPage & { kind: 'region' };
  lang: Lang;
}

const { page, lang } = Astro.props;
// Scalar summary/detail fields carry *Ja / *Ko siblings, so pickLocalized
// resolves ja → *Ja, ko → *Ko, and zh-tw → OpenCC(zh). The list fields
// (strengths / weaknesses / keyInitiatives / sources) only have *En, so ko
// falls back to en by design (marked below) while zh-tw still derives from
// the zh source via OpenCC.
const benchmarkRoot = localizedHref('/benchmarking/', lang);
const leversHref = localizedHref('/levers/', lang);
const legalAiHref = localizedHref('/legal-ai/', lang);

const summary = page.summary;
const detail = page.detail;
const regionName = pickLocalized<string>(summary, 'name', lang) || summary.name;
const fullName = detail ? pickLocalized<string>(detail, 'fullName', lang) || detail.fullName : undefined;
const overview = detail ? pickLocalized<string>(detail, 'overview', lang) || detail.overview : undefined;
const strategy = pickLocalized<string>(summary, 'strategy', lang) || summary.strategy;
const investment = pickLocalized<string>(summary, 'investment', lang) || summary.investment;
const governance = pickLocalized<string>(summary, 'governance', lang) || summary.governance;
const strength = pickLocalized<string>(summary, 'strength', lang) || summary.strength;

const regionDrilldowns = getBenchmarkDrilldownsForRegion(page.slug);
const regionDrilldownByLocalId = new Map(regionDrilldowns.map((item) => [item.localId, item]));

function drilldownHref(localId: string): string {
  const target = regionDrilldownByLocalId.get(localId);
  return target ? `${benchmarkRoot}${target.slug}/` : benchmarkRoot;
}

const relatedRegions = regionPages.filter((candidate) => candidate.slug !== page.slug).slice(0, 6);

// Page-local prose (one-line-read fallback + pending note). zh source with
// zh-tw derived via OpenCC; en/ja/ko hand-written.
const oneLineReadZh = `${regionName} 的 AI 战略可概括为：${strategy}；治理模式是 ${governance}；相对优势是 ${strength}。`;
const oneLineReadByLang: Record<Lang, string> = {
  zh: oneLineReadZh,
  'zh-tw': toTraditional(oneLineReadZh),
  en: `${regionName}'s AI strategy centres on ${strategy}; its governance model is ${governance}; its comparative strength is ${strength}.`,
  ja: `${regionName} の AI 戦略は ${strategy} を中心とし、ガバナンスモデルは ${governance}、相対的な優位は ${strength} です。`,
  ko: `${regionName}의 AI 전략은 ${strategy}를 중심으로 하며, 거버넌스 모델은 ${governance}, 상대적 우위는 ${strength}입니다.`,
};
const pendingNoteZh = `本页目前使用总览表数据生成。后续可在 src/data/benchmarking.ts 补充完整 RegionDetail，页面会自动展开战略、投资、治理、优势/劣势与来源。`;
const pendingNoteByLang: Record<Lang, string> = {
  zh: pendingNoteZh,
  'zh-tw': toTraditional(pendingNoteZh),
  en: `This page is currently generated from the overview table. Add a full RegionDetail record in src/data/benchmarking.ts and this route will automatically expand with strategy, investment, governance, strengths/weaknesses, and sources.`,
  ja: `本ページは概要テーブルのデータから生成されています。src/data/benchmarking.ts に完全な RegionDetail を追加すると、戦略・投資・ガバナンス・優位/劣位・出典が自動的に展開されます。`,
  ko: `이 페이지는 현재 개요 표 데이터로 생성됩니다. src/data/benchmarking.ts에 완전한 RegionDetail을 보완하면 전략, 투자, 거버넌스, 강점/약점, 출처가 자동으로 확장됩니다.`,
};

const eyebrowByLang: Record<Lang, string> = {
  zh: 'International Benchmark · 数据更新',
  'zh-tw': `International Benchmark · ${toTraditional('数据更新')}`,
  en: 'International Benchmark · Updated',
  ja: 'International Benchmark · データ更新',
  ko: 'International Benchmark · 데이터 업데이트',
};
const pageHeadingSuffixByLang: Record<Lang, string> = {
  zh: 'AI 战略对标',
  'zh-tw': toTraditional('AI 战略对标'),
  en: 'AI Strategy Benchmark',
  ja: 'AI 戦略ベンチマーク',
  ko: 'AI 전략 벤치마크',
};

const labels = {
  benchmarkCrumb: t(lang, 'benchmarkCrumb'),
  eyebrow: eyebrowByLang[lang] || eyebrowByLang.en,
  pageHeading: `${regionName} ${pageHeadingSuffixByLang[lang] || pageHeadingSuffixByLang.en}`,
  coreStrategy: t(lang, 'benchmarkCoreStrategy'),
  investmentScale: t(lang, 'benchmarkInvestmentScale'),
  governanceModel: t(lang, 'benchmarkGovernanceModel'),
  comparativeStrength: t(lang, 'benchmarkComparativeStrength'),
  oneLineRead: t(lang, 'benchmarkOneLineRead'),
  oneLineReadFallback: oneLineReadByLang[lang] || oneLineReadByLang.en,
  coreStrategiesHeading: t(lang, 'benchmarkCoreStrategiesHeading'),
  investmentHeading: t(lang, 'benchmarkInvestmentHeading'),
  governanceHeading: t(lang, 'benchmarkGovernanceHeading'),
  strengthsHeading: t(lang, 'benchmarkStrengthsHeading'),
  weaknessesHeading: t(lang, 'benchmarkWeaknessesHeading'),
  keyHeading: t(lang, 'benchmarkKeyHeading'),
  keyInitiatives: t(lang, 'benchmarkKeyInitiatives'),
  keyBodies: t(lang, 'benchmarkKeyBodies'),
  itemLabel: t(lang, 'benchmarkItemLabel'),
  amountLabel: t(lang, 'benchmarkAmountLabel'),
  noteLabel: t(lang, 'benchmarkNoteLabel'),
  sourcesHeading: t(lang, 'benchmarkSourcesHeading'),
  pendingHeading: t(lang, 'benchmarkPendingHeading'),
  pendingNote: pendingNoteByLang[lang] || pendingNoteByLang.en,
  relatedHeading: t(lang, 'benchmarkRelatedHeading'),
  benchmarkOverview: t(lang, 'benchmarkOverview'),
  leversCta: t(lang, 'benchmarkLeversCta'),
  legalCta: t(lang, 'benchmarkLegalCta'),
  continueHeading: t(lang, 'benchmarkContinueHeading'),
  backTo: t(lang, 'benchmarkBackTo'),
  disclaimer:
    lang === 'zh-tw'
      ? toTraditional(dataDisclaimer)
      : lang === 'en' || lang === 'ja' || lang === 'ko'
        ? dataDisclaimerEn || dataDisclaimer
        : dataDisclaimer,
};

const metaDescByLang: Record<Lang, string> = {
  zh: `${regionName} AI 战略、投资、治理模式与核心优势对标。`,
  'zh-tw': toTraditional(`${regionName} AI 战略、投资、治理模式与核心优势对标。`),
  en: `${regionName}'s AI strategy, investment, governance model, and comparative strengths.`,
  ja: `${regionName} の AI 戦略・投資・ガバナンスモデル・コア優位のベンチマーク。`,
  ko: `${regionName}의 AI 전략, 투자, 거버넌스 모델, 핵심 우위 벤치마크.`,
};
const metaTitleSuffixByLang: Record<Lang, string> = {
  zh: '国际对标',
  'zh-tw': toTraditional('国际对标'),
  en: 'International Benchmarks',
  ja: '国際ベンチマーク',
  ko: '국제 벤치마크',
};
const metadata = {
  title: `${labels.pageHeading} · ${metaTitleSuffixByLang[lang] || metaTitleSuffixByLang.en}`,
  description: overview || metaDescByLang[lang] || metaDescByLang.en,
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: labels.pageHeading,
  description: metadata.description,
  datePublished: dataDate,
  dateModified: dataDate,
  inLanguage: IN_LANGUAGES[lang],
  about: [
    { '@type': 'Place', name: summary.nameEn || summary.name },
    { '@type': 'Thing', name: 'AI strategy' },
  ],
};

const breadcrumbs = [
  { label: labels.benchmarkCrumb, href: localizedHref('/benchmarking/', lang) },
  { label: regionName },
];

// These list fields carry only *En siblings. pickLocalized walks the chain
// per locale: zh → zh, zh-tw → OpenCC(zh), en/ja/ko → *En (ja/ko by design,
// no *Ja/*Ko backfilled yet). detail may be undefined → empty arrays.
const strengthsList = (detail ? pickLocalized<string[]>(detail, 'strengths', lang) : null) || [];
const weaknessesList = (detail ? pickLocalized<string[]>(detail, 'weaknesses', lang) : null) || [];
const keyInitiativesList = (detail ? pickLocalized<string[]>(detail, 'keyInitiatives', lang) : null) || [];
const sourcesList = (detail ? pickLocalized<string[]>(detail, 'sources', lang) : null) || [];
---

<Layout metadata={metadata} breadcrumbs={breadcrumbs} lang={lang}>
  <JsonLd schema={articleSchema} />

  {
    /* ko: strengths/weaknesses/keyInitiatives/sources have no *Ko sibling and
     fall back to en by design (see list getters above). zh-tw derives from zh
     via OpenCC and never leaks en, so the marker is ko-only. */
  }
  <article
    class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16"
    {...lang === 'ko' ? { 'data-i18n-allow-en': 'benchmark-region-en-fallback' } : {}}
  >
    <header class="mb-8">
      <p class="text-xs uppercase tracking-[0.18em] text-primary font-semibold mb-4">
        {labels.eyebrow}
        {dataDate}
      </p>
      <h1 class="t-display text-gray-900 dark:text-white mb-3">
        {summary.flag}
        {labels.pageHeading}
      </h1>
      {fullName && <p class="text-base md:text-lg text-gray-500 dark:text-gray-400">{fullName}</p>}
    </header>

    <section class="grid md:grid-cols-2 gap-3 mb-8">
      <a
        href={drilldownHref('core-strategy')}
        class="group bg-surface border border-subtle rounded-lg p-4 hover:border-primary/50 hover:shadow-sm transition-all"
      >
        <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{labels.coreStrategy}</div>
        <div class="font-semibold group-hover:text-primary">{strategy}</div>
        <div class="text-xs text-gray-500 mt-1">{summary.strategyYear}</div>
      </a>
      <a
        href={drilldownHref('investment-overview')}
        class="group bg-surface border border-subtle rounded-lg p-4 hover:border-primary/50 hover:shadow-sm transition-all"
      >
        <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{labels.investmentScale}</div>
        <div class="font-semibold group-hover:text-primary">{investment}</div>
      </a>
      <a
        href={drilldownHref('governance-model')}
        class="group bg-surface border border-subtle rounded-lg p-4 hover:border-primary/50 hover:shadow-sm transition-all"
      >
        <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{labels.governanceModel}</div>
        <div class="font-semibold group-hover:text-primary">{governance}</div>
      </a>
      <a
        href={drilldownHref('comparative-strength')}
        class="group bg-surface border border-subtle rounded-lg p-4 hover:border-primary/50 hover:shadow-sm transition-all"
      >
        <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{labels.comparativeStrength}</div>
        <div class="font-semibold group-hover:text-primary">{strength}</div>
      </a>
    </section>

    <section class="callout-note rounded-lg p-5 mb-10">
      <h2 class="t-h3 text-gray-900 dark:text-white mb-3">{labels.oneLineRead}</h2>
      <p class="text-gray-800 dark:text-gray-200 leading-[1.85]">{overview || labels.oneLineReadFallback}</p>
    </section>

    {
      detail ? (
        <>
          <section class="mb-10">
            <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.coreStrategiesHeading}</h2>
            <div class="space-y-3">
              {detail.strategies.map((strategyItem, index) => (
                <a
                  href={drilldownHref(`strategy-${index + 1}`)}
                  class="group block bg-surface border border-subtle rounded-lg p-4 hover:border-primary/50 hover:shadow-sm transition-all"
                >
                  <div class="text-xs font-mono text-blue-600 dark:text-blue-400 mb-1">{strategyItem.year}</div>
                  <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-primary">
                    {pickLocalized(strategyItem, 'name', lang) || strategyItem.name}
                  </h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                    {pickLocalized(strategyItem, 'description', lang) || strategyItem.description}
                  </p>
                </a>
              ))}
            </div>
          </section>

          <section class="mb-10">
            <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.investmentHeading}</h2>
            <div class="grid gap-3">
              {detail.investment.map((item, index) => (
                <a
                  href={drilldownHref(`investment-${index + 1}`)}
                  class="group grid gap-3 rounded-lg border border-subtle bg-surface p-4 hover:border-primary/50 hover:shadow-sm transition-all sm:grid-cols-[1.2fr_0.8fr_1.2fr]"
                >
                  <div>
                    <div class="text-xs uppercase tracking-wider text-muted mb-1">{labels.itemLabel}</div>
                    <div class="font-semibold text-gray-900 dark:text-white group-hover:text-primary">
                      {pickLocalized(item, 'item', lang) || item.item}
                    </div>
                  </div>
                  <div>
                    <div class="text-xs uppercase tracking-wider text-muted mb-1">{labels.amountLabel}</div>
                    <div class="font-semibold text-gray-900 dark:text-white">
                      {pickLocalized(item, 'amount', lang) || item.amount}
                    </div>
                  </div>
                  <div>
                    <div class="text-xs uppercase tracking-wider text-muted mb-1">{labels.noteLabel}</div>
                    <div class="text-sm text-gray-600 dark:text-gray-400">
                      {pickLocalized(item, 'note', lang) || item.note}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <section class="mb-10">
            <h2 class="t-h3 text-gray-900 dark:text-white mb-3">{labels.governanceHeading}</h2>
            <p class="text-gray-700 dark:text-gray-300 leading-[1.85]">
              {pickLocalized(detail, 'governance', lang) || detail.governance}
            </p>
          </section>

          <section class="mb-10 grid md:grid-cols-2 gap-5">
            <div>
              <h2 class="t-h3 text-green-700 dark:text-green-300 mb-3">{labels.strengthsHeading}</h2>
              <ul class="space-y-2 text-sm text-gray-700 dark:text-gray-300">
                {strengthsList.map((item) => (
                  <li>• {item}</li>
                ))}
              </ul>
            </div>
            <div>
              <h2 class="t-h3 text-red-700 dark:text-red-300 mb-3">{labels.weaknessesHeading}</h2>
              <ul class="space-y-2 text-sm text-gray-700 dark:text-gray-300">
                {weaknessesList.map((item) => (
                  <li>• {item}</li>
                ))}
              </ul>
            </div>
          </section>

          <section class="mb-10">
            <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.keyHeading}</h2>
            <div class="grid md:grid-cols-2 gap-5">
              <div class="bg-surface border border-subtle rounded-lg p-4">
                <h3 class="font-semibold mb-3">{labels.keyInitiatives}</h3>
                <div class="space-y-2 text-sm">
                  {keyInitiativesList.map((item, index) => (
                    <a
                      href={drilldownHref(`initiative-${index + 1}`)}
                      class="group flex items-start justify-between gap-3 rounded-md border border-subtle p-3 hover:border-primary/50 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors"
                    >
                      <span class="text-gray-700 dark:text-gray-300 group-hover:text-primary">{item}</span>
                      <Icon name="tabler:arrow-up-right" class="w-4 h-4 text-muted group-hover:text-primary shrink-0" />
                    </a>
                  ))}
                </div>
              </div>
              <div class="bg-surface border border-subtle rounded-lg p-4">
                <h3 class="font-semibold mb-3">{labels.keyBodies}</h3>
                <div class="space-y-2 text-sm">
                  {detail.keyBodies.map((body, index) => (
                    <a
                      href={drilldownHref(`body-${index + 1}`)}
                      class="group block rounded-md border border-subtle p-3 hover:border-primary/50 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors"
                    >
                      <div class="font-semibold text-gray-900 dark:text-white group-hover:text-primary">
                        {pickLocalized(body, 'name', lang) || body.name}
                      </div>
                      <div class="mt-1 text-gray-700 dark:text-gray-300">
                        {pickLocalized(body, 'role', lang) || body.role}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <section class="mb-10">
            <h2 class="t-h3 text-gray-900 dark:text-white mb-3">{labels.sourcesHeading}</h2>
            <ul class="space-y-1 text-sm text-gray-500 dark:text-gray-400">
              {sourcesList.map((source) => (
                <li>• {source}</li>
              ))}
            </ul>
          </section>
        </>
      ) : (
        <section class="callout-muted rounded-lg p-5 mb-10">
          <h2 class="font-semibold mb-2">{labels.pendingHeading}</h2>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">{labels.pendingNote}</p>
        </section>
      )
    }

    <section class="mb-10">
      <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.relatedHeading}</h2>
      <div class="flex flex-wrap gap-3">
        <a
          href={benchmarkRoot}
          class="text-sm text-primary hover:text-secondary border border-primary/30 px-4 py-2 rounded-md"
        >
          {labels.benchmarkOverview}
        </a>
        <a
          href={leversHref}
          class="text-sm text-primary hover:text-secondary border border-primary/30 px-4 py-2 rounded-md"
        >
          {labels.leversCta}
        </a>
        <a
          href={legalAiHref}
          class="text-sm text-primary hover:text-secondary border border-primary/30 px-4 py-2 rounded-md"
        >
          {labels.legalCta}
        </a>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{labels.continueHeading}</h2>
      <div class="grid gap-3 md:grid-cols-2">
        {
          relatedRegions.map((item) => (
            <a
              href={`${benchmarkRoot}${item.slug}/`}
              class="block bg-surface rounded-lg p-4 border border-subtle hover:border-blue-300 hover:shadow-sm transition-all"
            >
              <h3 class="font-semibold text-gray-800 dark:text-white text-sm">
                {item.summary.flag} {pickLocalized(item.summary, 'name', lang) || item.summary.name}
              </h3>
              <p class="text-xs text-gray-600 dark:text-gray-400 mt-2">
                {pickLocalized(item.summary, 'strength', lang) || item.summary.strength}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <p class="text-xs text-gray-500 dark:text-gray-400 border-t border-subtle pt-5">{labels.disclaimer}</p>

    <nav class="mt-8">
      <a
        href={benchmarkRoot}
        class="text-sm text-primary hover:text-secondary font-medium inline-flex items-center gap-1"
      >
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        {labels.backTo}
      </a>
    </nav>
  </article>
</Layout>
