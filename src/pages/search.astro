---
// Full-page search (en) — thin wrapper around SearchPage.astro.
// noindex: internal search results pages should not be crawled, and the
// layout's searchIndex=false keeps this page out of the Pagefind index too.

import Layout from '~/layouts/PageLayout.astro';
import SearchPage from '~/components/common/SearchPage.astro';
import { t } from '~/i18n';

const lang = 'en' as const;

const metadata = {
  title: `${t(lang, 'searchSiteLabel')} · ${t(lang, 'siteName')}`,
  description: t(lang, 'searchPageDesc'),
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata} lang={lang} searchIndex={false}>
  <SearchPage lang={lang} />
</Layout>
