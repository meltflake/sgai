---
// Startup entity detail page (EN route default). Thin wrapper around the
// shared StartupProfile component — see src/components/startups/StartupProfile.astro.
import type { GetStaticPaths } from 'astro';

import StartupProfile from '~/components/startups/StartupProfile.astro';
import { startupEntityPages, type StartupEntityPage } from '~/utils/entity-pages';

export const prerender = true;

export const getStaticPaths = (() => {
  return startupEntityPages.map((page) => ({
    params: { id: page.slug },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: StartupEntityPage };
---

<StartupProfile page={page} lang="en" />
