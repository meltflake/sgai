---
// /topics/[slug] hub (en) — thin wrapper around TopicHub.astro.
// [lang] variant: src/pages/[lang]/topics/[slug].astro.

import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import TopicHub from '~/components/topics/TopicHub.astro';
import { topics, type Topic } from '~/data/topics';
import { entriesByTopic } from '~/utils/topic-graph';
import { t, pickLocalized, IN_LANGUAGES } from '~/i18n';

export const getStaticPaths = (() =>
  topics.map((topic) => ({ params: { slug: topic.id }, props: { topic } }))) satisfies GetStaticPaths;

interface Props {
  topic: Topic;
}
const { topic } = Astro.props as Props;
const lang = 'en' as const;

const name = pickLocalized<string>(topic, 'name', lang) ?? topic.nameEn;
const description = pickLocalized<string>(topic, 'description', lang) ?? topic.descriptionEn;

const entries = entriesByTopic(topic.id);
const url = `https://sgai.md/topics/${topic.id}/`;

const metadata = {
  // Compact geo+domain anchor so the hub targets "<topic> Singapore AI".
  title: `${name} — Singapore AI`,
  description,
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name,
  description,
  url,
  inLanguage: IN_LANGUAGES[lang],
};

// Enumerate the aggregated entries so search engines see this hub as a
// concrete, exhaustive list of records (not just a landing page).
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name,
  numberOfItems: entries.length,
  itemListElement: entries.slice(0, 100).map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://sgai.md${e.href}`,
    name: pickLocalized<string>(e, 'title', lang) || e.title,
  })),
};
---

<Layout
  metadata={metadata}
  breadcrumbs={[{ label: t(lang, 'fpBrowseByTopic'), href: '/topics/' }, { label: name }]}
  lang={lang}
>
  <JsonLd schema={collectionSchema} />
  {entries.length > 0 && <JsonLd schema={itemListSchema} />}
  <TopicHub lang={lang} topic={topic} />
</Layout>
