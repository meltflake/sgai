---
// Timeline page (en) — thin wrapper.

import Layout from '~/layouts/PageLayout.astro';
import CrossDomainRail from '~/components/listing/CrossDomainRail.astro';
import TimelinePage from '~/components/timeline/TimelinePage.astro';
import { t } from '~/i18n';

const lang = 'en' as const;
---

<Layout
  metadata={{
    title: t(lang, 'timelinePageTitle'),
    description: t(lang, 'timelinePageDesc'),
  }}
  breadcrumbs={[{ label: t(lang, 'timelinePageTitle') }]}
  lang={lang}
>
  <TimelinePage lang={lang} />
  <CrossDomainRail lang={lang} current="timeline" class="max-w-6xl mx-auto px-4 sm:px-6 pb-16" />
</Layout>
