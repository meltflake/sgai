---
// Legal-AI detail page ([lang]). One page per legal item x non-default locale.

import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';

import JsonLd from '~/components/common/JsonLd.astro';
import Layout from '~/layouts/PageLayout.astro';
import SameTopicRail from '~/components/data/SameTopicRail.astro';
import { dataDate } from '~/data/legal-ai';
import { categories as policyCategories } from '~/data/policies';
import { legalItemPages, legalItemSlug } from '~/utils/entity-pages';
import { NON_DEFAULT_ROUTE_LOCALES, IN_LANGUAGES, pickLocalized, localizedHref, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';
import { getCanonical } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (() =>
  NON_DEFAULT_ROUTE_LOCALES.flatMap((lang) =>
    legalItemPages.map((page) => ({
      params: { lang, id: page.slug },
      props: { page },
    }))
  )) satisfies GetStaticPaths;

const { page } = Astro.props;
const lang = Astro.params.lang as Lang;

const { item, section } = page;
const relatedItems = section.items.filter((candidate) => candidate.title !== item.title).slice(0, 4);

const SCOPE_LABELS_BY_LANG: Record<Lang, Record<string, { label: string; color: string }>> = {
  zh: {
    training: { label: '训练侧', color: 'bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200' },
    output: { label: '输出侧', color: 'bg-rose-100 dark:bg-rose-900 text-rose-800 dark:text-rose-200' },
    liability: { label: '责任', color: 'bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200' },
    governance: { label: '治理', color: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200' },
  },
  en: {
    training: { label: 'Training', color: 'bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200' },
    output: { label: 'Output', color: 'bg-rose-100 dark:bg-rose-900 text-rose-800 dark:text-rose-200' },
    liability: { label: 'Liability', color: 'bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200' },
    governance: { label: 'Governance', color: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200' },
  },
  ja: {
    training: { label: '訓練側', color: 'bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200' },
    output: { label: '出力側', color: 'bg-rose-100 dark:bg-rose-900 text-rose-800 dark:text-rose-200' },
    liability: { label: '責任', color: 'bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200' },
    governance: { label: 'ガバナンス', color: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200' },
  },
  'zh-tw': {
    training: {
      label: toTraditional('训练侧'),
      color: 'bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200',
    },
    output: { label: toTraditional('输出侧'), color: 'bg-rose-100 dark:bg-rose-900 text-rose-800 dark:text-rose-200' },
    liability: {
      label: toTraditional('责任'),
      color: 'bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200',
    },
    governance: {
      label: toTraditional('治理'),
      color: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
    },
  },
  ko: {
    training: { label: '훈련 측', color: 'bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200' },
    output: { label: '출력 측', color: 'bg-rose-100 dark:bg-rose-900 text-rose-800 dark:text-rose-200' },
    liability: { label: '책임', color: 'bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200' },
    governance: { label: '거버넌스', color: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200' },
  },
};
const scopeLabel = SCOPE_LABELS_BY_LANG[lang] || SCOPE_LABELS_BY_LANG.en;

const title = pickLocalized<string>(item, 'title', lang) || item.title;
const summary = pickLocalized<string>(item, 'summary', lang) || item.summary;
const body = pickLocalized<string>(item, 'body', lang) || item.body;
const status = pickLocalized<string>(item, 'status', lang) || item.status;
const dateLocalized = pickLocalized<string>(item, 'date', lang) || item.date;
const authority = pickLocalized<string>(item, 'authority', lang) || item.authority;

// Mirrors the root legal-ai page: items that also exist as policy-archive
// pages under the same slug canonicalise to the richer policy page.
const policyTwin = policyCategories.some((c) => c.policies.some((p) => p.id === page.slug));

const metadata = {
  title: `${title} · ${t(lang, 'navLegalAi')}`,
  description: summary,
  ...(policyTwin ? { canonical: String(getCanonical(localizedHref(`/policies/${page.slug}/`, lang))) } : {}),
};

// alternateName only makes sense when the primary `name` (English) differs
// from the zh source string the zh reader actually sees on the page.
const schemaAlternateName: Record<string, string> = {};
if (lang === 'zh') schemaAlternateName.alternateName = item.title;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Legislation',
  name: item.titleEn || item.title,
  ...schemaAlternateName,
  description: summary,
  datePublished: item.dateEn || item.date,
  inLanguage: IN_LANGUAGES[lang],
  legislationJurisdiction: 'Singapore',
  ...(item.sourceUrl ? { url: item.sourceUrl } : {}),
};
---

<Layout
  metadata={metadata}
  breadcrumbs={[{ label: t(lang, 'navLegalAi'), href: localizedHref('/legal-ai/', lang) }, { label: title }]}
  lang={lang}
>
  <JsonLd schema={schema} />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <header class="mb-8">
      <p class="text-xs uppercase tracking-[0.18em] text-primary font-semibold mb-4">
        {pickLocalized(section, 'title', lang)} · Updated {dataDate}
      </p>
      <h1 class="t-display text-gray-900 dark:text-white mb-3">
        {title}
      </h1>
      {
        lang !== 'zh' && item.titleEn && (
          <p class="text-base md:text-lg text-gray-500 dark:text-gray-400 italic">{item.titleEn}</p>
        )
      }
    </header>

    <section class="flex flex-wrap gap-2 mb-8">
      <span class={`text-xs font-bold px-2 py-1 rounded ${scopeLabel[item.scope].color}`}>
        {scopeLabel[item.scope].label}
      </span>
      <span class="text-xs bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 px-2 py-1 rounded">
        {status}
      </span>
      <span class="text-xs bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 px-2 py-1 rounded">
        {dateLocalized}
      </span>
      {
        item.authorityUrl ? (
          <a
            href={item.authorityUrl}
            target="_blank"
            rel="noopener"
            class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-2 py-1 rounded hover:underline"
          >
            {authority}
          </a>
        ) : (
          <span class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-2 py-1 rounded">
            {authority}
          </span>
        )
      }
    </section>

    <section class="callout-note rounded-lg p-5 mb-8">
      <h2 class="t-h3 text-gray-900 dark:text-white mb-3">{t(lang, 'legalCorePoint')}</h2>
      <p class="text-gray-800 dark:text-gray-200 leading-[1.85]">{summary}</p>
    </section>

    <section class="prose prose-lg dark:prose-invert max-w-none font-serif mb-10">
      <h2>{t(lang, 'legalDetailedNote')}</h2>
      <p>{body}</p>
    </section>

    <section class="bg-surface border border-subtle rounded-lg p-5 mb-10">
      <h2 class="t-h3 text-gray-900 dark:text-white mb-3">{t(lang, 'legalFrameworkPosition')}</h2>
      <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
        {pickLocalized(section, 'philosophy', lang)}
      </p>
    </section>

    <div class="flex flex-wrap gap-3 mb-10">
      {
        item.sourceUrl && (
          <a
            href={item.sourceUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-secondary border border-primary/30 hover:border-primary px-4 py-2 rounded-md transition-colors"
          >
            <Icon name="tabler:external-link" class="w-4 h-4" />
            {t(lang, 'legalStatuteSource')}
          </a>
        )
      }
      <a
        href={localizedHref('/levers/', lang)}
        class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-secondary border border-primary/30 hover:border-primary px-4 py-2 rounded-md transition-colors"
      >
        <Icon name="tabler:target" class="w-4 h-4" />
        {t(lang, 'legalViewLevers')}
      </a>
    </div>

    {
      relatedItems.length > 0 && (
        <section class="mb-10">
          <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{t(lang, 'legalRelatedCards')}</h2>
          <div class="grid gap-3">
            {relatedItems.map((related) => (
              <a
                href={localizedHref(`/legal-ai/${legalItemSlug(related)}/`, lang)}
                class="block bg-surface rounded-lg p-4 border border-subtle hover:border-blue-300 hover:shadow-sm transition-all"
              >
                <h3 class="font-semibold text-gray-800 dark:text-white text-sm">
                  {pickLocalized(related, 'title', lang)}
                </h3>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-2">{pickLocalized(related, 'summary', lang)}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <nav class="mt-12 pt-6 border-t border-subtle">
      <a
        href={localizedHref('/legal-ai/', lang)}
        class="text-sm text-primary hover:text-secondary font-medium inline-flex items-center gap-1"
      >
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        {t(lang, 'back')}
        {t(lang, 'navLegalAi')}
      </a>
    </nav>
  </article>
  <SameTopicRail lang={lang} kind="legal" id={page.slug} class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 mt-4" />
</Layout>
