---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import HomePage from '~/components/home/HomePage.astro';
import { NON_DEFAULT_ROUTE_LOCALES, IN_LANGUAGES, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';

export function getStaticPaths() {
  return NON_DEFAULT_ROUTE_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const homeTitleSuffix =
  lang === 'zh'
    ? ' — 新加坡 AI 战略、政策与生态 · sgai'
    : lang === 'zh-tw'
      ? toTraditional(' — 新加坡 AI 战略、政策与生态 · sgai')
      : lang === 'ja'
        ? ' — シンガポール AI 戦略・政策・エコシステム · sgai'
        : lang === 'ko'
          ? ' — 싱가포르 AI 전략·정책·생태계 · sgai'
          : ' — Singapore AI strategy, policy & ecosystem · sgai';
const metadata = {
  title: `${t(lang, 'siteName')}${homeTitleSuffix}`,
  ignoreTitleTemplate: true,
  description: t(lang, 'siteDescription'),
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t(lang, 'siteName'),
  url: 'https://sgai.md/',
  logo: 'https://sgai.md/favicon.svg',
  description: t(lang, 'siteDescription'),
  sameAs: ['https://github.com/meltflake/sgai'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t(lang, 'siteName'),
  url: 'https://sgai.md/',
  inLanguage: IN_LANGUAGES[lang],
};
---

<Layout metadata={metadata} lang={lang}>
  <JsonLd schema={organizationSchema} />
  <JsonLd schema={websiteSchema} />
  <HomePage lang={lang} />
</Layout>
