---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import HomePage from '~/components/home/HomePage.astro';
import { NON_DEFAULT_ROUTE_LOCALES, IN_LANGUAGES, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';

export function getStaticPaths() {
  return NON_DEFAULT_ROUTE_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

// siteName already carries the country word in every locale — the suffix
// adds the topic triplet only, keeping the whole title inside ~60 chars.
const homeTitleSuffixByLang: Record<Lang, string> = {
  zh: ' — AI 战略、政策与生态 · sgai',
  'zh-tw': toTraditional(' — AI 战略、政策与生态 · sgai'),
  ja: ' — AI 戦略・政策・エコシステム · sgai',
  ko: ' — AI 전략·정책·생태계 · sgai',
  en: ' — AI strategy, policy & ecosystem · sgai',
};
const homeTitleSuffix = homeTitleSuffixByLang[lang] || homeTitleSuffixByLang.en;
const metadata = {
  title: `${t(lang, 'siteName')}${homeTitleSuffix}`,
  ignoreTitleTemplate: true,
  description: t(lang, 'siteDescription'),
  openGraph: { images: [{ url: '~/assets/images/og/home.png', width: 1200, height: 630 }] },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t(lang, 'siteName'),
  url: 'https://sgai.md/',
  logo: 'https://sgai.md/favicon.svg',
  description: t(lang, 'siteDescription'),
  sameAs: ['https://github.com/meltflake/sgai'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t(lang, 'siteName'),
  url: 'https://sgai.md/',
  inLanguage: IN_LANGUAGES[lang],
};
---

<Layout metadata={metadata} lang={lang}>
  <JsonLd schema={organizationSchema} />
  <JsonLd schema={websiteSchema} />
  <HomePage lang={lang} />
</Layout>
