---
import Layout from '~/layouts/PageLayout.astro';
import AgentPage from '~/components/agent/AgentPage.astro';
import { NON_DEFAULT_ROUTE_LOCALES, t, type Lang } from '~/i18n';

export function getStaticPaths() {
  return NON_DEFAULT_ROUTE_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Layout
  metadata={{
    title: t(lang, 'agentPageTitle'),
    description: t(lang, 'agentPageDesc'),
  }}
  breadcrumbs={[{ label: t(lang, 'agentPageTitle') }]}
  lang={lang}
>
  <AgentPage lang={lang} />
</Layout>
