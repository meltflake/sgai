---
// Lever detail page ([lang]). One page per leverPage.slug x non-default locale.

import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';

import JsonLd from '~/components/common/JsonLd.astro';
import RelatedRail from '~/components/data/RelatedRail.astro';
import Layout from '~/layouts/PageLayout.astro';
import SameTopicRail from '~/components/data/SameTopicRail.astro';
import { dataDate, publicLeverGroups } from '~/data/levers';
import { NON_DEFAULT_ROUTE_LOCALES, IN_LANGUAGES, pickLocalized, localizedHref, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';
import { getDebateById, getPolicyById } from '~/utils/graph';
import { leverItemSlug, leverPages, leverSlug } from '~/utils/entity-pages';

export const prerender = true;

export const getStaticPaths = (() =>
  NON_DEFAULT_ROUTE_LOCALES.flatMap((lang) =>
    leverPages.map((page) => ({
      params: { lang, id: page.slug },
      props: { page },
    }))
  )) satisfies GetStaticPaths;

const { page } = Astro.props;
const lang = Astro.params.lang as Lang;

const LABELS: Record<
  Lang,
  {
    updated: string;
    lever: string;
    projects: string;
    transmissionMode: string;
    direct: string;
    passThrough: string;
    bottleneck: string;
    definition: string;
    take: string;
    partOf: string;
    owner: string;
    scale: string;
    parent: string;
    description: string;
    whatStateDoes: string;
    related: string;
    viewParent: string;
    source: string;
  }
> = {
  zh: {
    updated: '更新',
    lever: '抓手',
    projects: '项目数',
    transmissionMode: '传导模式',
    direct: '国家直接做',
    passThrough: '穿透到企业',
    bottleneck: '解决瓶颈',
    definition: '抓手定义',
    take: '判断：',
    partOf: '隶属于',
    owner: '主管机构',
    scale: '规模 / KPI',
    parent: '父抓手',
    description: '项目描述',
    whatStateDoes: '国家直接做什么',
    related: '关联阅读',
    viewParent: '查看父抓手',
    source: '来源',
  },
  'zh-tw': {
    updated: '更新',
    lever: '抓手',
    projects: '項目數',
    transmissionMode: '傳導模式',
    direct: '國家直接做',
    passThrough: '穿透到企業',
    bottleneck: '解決瓶頸',
    definition: '抓手定義',
    take: '判斷：',
    partOf: '隸屬於',
    owner: '主管機構',
    scale: '規模 / KPI',
    parent: '父抓手',
    description: '項目描述',
    whatStateDoes: '國家直接做什麼',
    related: '關聯閱讀',
    viewParent: '查看父抓手',
    source: '來源',
  },
  en: {
    updated: 'Updated',
    lever: 'Lever',
    projects: 'Projects',
    transmissionMode: 'Transmission mode',
    direct: 'State-direct',
    passThrough: 'Transmitted to enterprise',
    bottleneck: 'Bottleneck solved',
    definition: 'Lever Definition',
    take: 'Take: ',
    partOf: 'Part of',
    owner: 'Owner',
    scale: 'Scale / KPI',
    parent: 'Parent lever',
    description: 'Project Description',
    whatStateDoes: 'What the State Does',
    related: 'Related Reading',
    viewParent: 'View parent lever',
    source: 'Source',
  },
  ja: {
    updated: '更新',
    lever: 'レバー',
    projects: 'プロジェクト数',
    transmissionMode: '伝導モード',
    direct: '国家が直接実行',
    passThrough: '企業へ浸透',
    bottleneck: '解決するボトルネック',
    definition: 'レバー定義',
    take: '見方：',
    partOf: '所属',
    owner: '主管機関',
    scale: '規模 / KPI',
    parent: '親レバー',
    description: 'プロジェクト説明',
    whatStateDoes: '国家が直接行うこと',
    related: '関連資料',
    viewParent: '親レバーを見る',
    source: '出典',
  },
  ko: {
    updated: '업데이트',
    lever: '레버',
    projects: '프로젝트 수',
    transmissionMode: '전달 방식',
    direct: '국가가 직접 수행',
    passThrough: '기업으로 전달',
    bottleneck: '해결하는 병목',
    definition: '레버 정의',
    take: '판단: ',
    partOf: '소속',
    owner: '주관 기관',
    scale: '규모 / KPI',
    parent: '상위 레버',
    description: '프로젝트 설명',
    whatStateDoes: '국가가 직접 하는 일',
    related: '관련 읽기',
    viewParent: '상위 레버 보기',
    source: '출처',
  },
};
const L = LABELS[lang];

const lever = page.lever;
const isLever = page.kind === 'lever';
const itemPolicies = page.kind === 'item' ? (page.item.relatedPolicyIds || []).map(getPolicyById).filter(Boolean) : [];
const itemDebates = page.kind === 'item' ? (page.item.relatedDebateIds || []).map(getDebateById).filter(Boolean) : [];
const visibleGroups = publicLeverGroups(lever);
const projectCount = visibleGroups.reduce((sum, group) => sum + group.items.length, 0);

const leverName = pickLocalized(lever, 'name', lang) || lever.name;
const title = isLever
  ? `${L.lever} ${lever.number} · ${leverName}`
  : pickLocalized(page.item, 'name', lang) || page.item.name;
const description = isLever
  ? pickLocalized(lever, 'subtitle', lang) || lever.subtitle
  : pickLocalized(page.item, 'description', lang) || page.item.description;

const itemMinistry = !isLever ? pickLocalized(page.item, 'ministry', lang) || page.item.ministry || '' : '';
const itemScale = !isLever ? pickLocalized(page.item, 'scale', lang) || page.item.scale || '' : '';
const descPrefix = !isLever ? [itemMinistry, itemScale].filter(Boolean).join(' · ') : '';
const isCjk = lang === 'zh' || lang === 'zh-tw';
const metaJoiner = isCjk ? '。' : '. ';
const metaDescription = (
  descPrefix && description ? `${descPrefix}${metaJoiner}${description}` : description || descPrefix
).slice(0, 200);
const brandSuffix =
  lang === 'zh'
    ? `新加坡国家 AI 抓手 ${lever.number} · sgai`
    : lang === 'zh-tw'
      ? toTraditional(`新加坡国家 AI 抓手 ${lever.number} · sgai`)
      : lang === 'ja'
        ? `シンガポール国家 AI レバー ${lever.number} · sgai`
        : lang === 'ko'
          ? `싱가포르 국가 AI 레버 ${lever.number} · sgai`
          : `Singapore National AI Lever ${lever.number} · sgai`;

const metadata = {
  title: `${title} · ${brandSuffix}`,
  description: metaDescription,
};

const schema = {
  '@context': 'https://schema.org',
  '@type': isLever ? 'DefinedTerm' : 'GovernmentService',
  name: title,
  description,
  dateModified: dataDate,
  inLanguage: IN_LANGUAGES[lang],
  isPartOf: {
    '@type': 'CreativeWork',
    name: t(lang, 'leversPageTitle'),
    url: 'https://sgai.md/levers/',
  },
};
---

<Layout
  metadata={metadata}
  breadcrumbs={[{ label: t(lang, 'navLevers'), href: localizedHref('/levers/', lang) }, { label: title }]}
  lang={lang}
>
  <JsonLd schema={schema} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <header class="mb-8">
      <p class="text-xs uppercase tracking-[0.18em] text-primary font-semibold mb-4">
        {L.lever}
        {lever.number} · {L.updated}
        {dataDate}
      </p>
      <h1 class="t-display text-gray-900 dark:text-white mb-3">
        {isLever ? `${lever.icon} ${L.lever} ${lever.number} · ${leverName}` : title}
      </h1>
      <p class="t-lead text-gray-500 dark:text-gray-400">
        {
          isLever
            ? pickLocalized(lever, 'subtitle', lang)
            : `${L.partOf} ${L.lever} ${lever.number} · ${leverName} / ${pickLocalized(page.group, 'title', lang)}`
        }
      </p>
    </header>

    {
      isLever ? (
        <>
          <section class="grid md:grid-cols-3 gap-3 mb-8">
            <div class="bg-surface border border-subtle rounded-lg p-4">
              <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{L.projects}</div>
              <div class="t-stat text-primary">{projectCount}</div>
            </div>
            <div class="bg-surface border border-subtle rounded-lg p-4">
              <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{L.transmissionMode}</div>
              <div class="font-semibold">{lever.transmissionMode === 'direct' ? L.direct : L.passThrough}</div>
            </div>
            <div class="bg-surface border border-subtle rounded-lg p-4">
              <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{L.bottleneck}</div>
              <div class="font-semibold">{pickLocalized(lever, 'bottleneckSolved', lang)}</div>
            </div>
          </section>

          <section class="callout-note rounded-lg p-5 mb-10">
            <h2 class="t-h3 text-gray-900 dark:text-white mb-3">{L.definition}</h2>
            <p class="text-gray-800 dark:text-gray-200 leading-[1.85]">{pickLocalized(lever, 'whatStateDoes', lang)}</p>
            {lever.insight && (
              <p class="text-gray-800 dark:text-gray-200 leading-[1.85] mt-3">
                {L.take}
                {pickLocalized(lever, 'insight', lang)}
              </p>
            )}
          </section>

          <section class="mb-10">
            <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{L.projects}</h2>
            <div class="space-y-6">
              {visibleGroups.map((group) => (
                <div>
                  <h3 class="font-semibold text-gray-900 dark:text-white mb-3">
                    {pickLocalized(group, 'title', lang)}
                  </h3>
                  <div class="grid md:grid-cols-2 gap-3">
                    {group.items.map((item) => (
                      <a
                        href={localizedHref(`/levers/${leverItemSlug(item)}/`, lang)}
                        class="block bg-surface border border-subtle rounded-lg p-4 hover:border-emerald-300 hover:shadow-sm transition-all"
                      >
                        <h4 class="font-semibold text-gray-900 dark:text-white text-sm">
                          {pickLocalized(item, 'name', lang)}
                        </h4>
                        <p class="text-xs text-gray-500 mt-1">
                          {pickLocalized(item, 'ministry', lang) || item.ministry}
                          {item.scale ? ` · ${pickLocalized(item, 'scale', lang)}` : ''}
                        </p>
                        <p class="text-xs text-gray-600 dark:text-gray-400 mt-2">
                          {pickLocalized(item, 'description', lang)}
                        </p>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          <RelatedRail entity={{ type: 'lever', id: lever.number }} variant="full" hideWhenEmpty={true} lang={lang} />
        </>
      ) : (
        <>
          <section class="grid md:grid-cols-3 gap-3 mb-8">
            <div class="bg-surface border border-subtle rounded-lg p-4">
              <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{L.owner}</div>
              <div class="font-semibold">{pickLocalized(page.item, 'ministry', lang) || page.item.ministry}</div>
            </div>
            <div class="bg-surface border border-subtle rounded-lg p-4">
              <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{L.scale}</div>
              <div class="font-semibold">{pickLocalized(page.item, 'scale', lang) || '—'}</div>
            </div>
            <div class="bg-surface border border-subtle rounded-lg p-4">
              <div class="text-xs uppercase tracking-wider text-gray-500 mb-1">{L.parent}</div>
              <a
                href={localizedHref(`/levers/${leverSlug(lever)}/`, lang)}
                class="text-primary hover:text-secondary font-semibold"
              >
                {L.lever} {lever.number} · {leverName}
              </a>
            </div>
          </section>

          <section class="callout-note rounded-lg p-5 mb-10">
            <h2 class="t-h3 text-gray-900 dark:text-white mb-3">{L.description}</h2>
            <p class="text-gray-800 dark:text-gray-200 leading-[1.85]">
              {pickLocalized(page.item, 'description', lang)}
            </p>
          </section>

          <section class="grid md:grid-cols-2 gap-5 mb-10">
            <div class="bg-surface border border-subtle rounded-lg p-5">
              <h2 class="t-h3 text-gray-900 dark:text-white mb-3">{L.whatStateDoes}</h2>
              <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                {pickLocalized(lever, 'whatStateDoes', lang)}
              </p>
            </div>
            <div class="bg-surface border border-subtle rounded-lg p-5">
              <h2 class="t-h3 text-gray-900 dark:text-white mb-3">{L.bottleneck}</h2>
              <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                {pickLocalized(lever, 'bottleneckSolved', lang)}
              </p>
            </div>
          </section>

          <section class="mb-10">
            <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{L.related}</h2>
            <div class="grid gap-3 md:grid-cols-2">
              {itemPolicies.map((policy) => (
                <a
                  href={
                    policy!.id ? localizedHref(`/policies/${policy!.id}/`, lang) : localizedHref('/policies/', lang)
                  }
                  class="block bg-surface border border-subtle rounded-lg p-4 hover:border-purple-300 hover:shadow-sm transition-all"
                >
                  <h3 class="font-semibold text-gray-900 dark:text-white text-sm">
                    {pickLocalized(policy!, 'title', lang)}
                  </h3>
                  <p class="text-xs text-gray-600 dark:text-gray-400 mt-2">{pickLocalized(policy!, 'summary', lang)}</p>
                </a>
              ))}
              {itemDebates.map((debate) => (
                <a
                  href={localizedHref(`/debates/${debate!.id}/`, lang)}
                  class="block bg-surface border border-subtle rounded-lg p-4 hover:border-amber-300 hover:shadow-sm transition-all"
                >
                  <h3 class="font-semibold text-gray-900 dark:text-white text-sm">
                    {pickLocalized(debate!, 'title', lang)}
                  </h3>
                  <p class="text-xs text-gray-600 dark:text-gray-400 mt-2">{pickLocalized(debate!, 'summary', lang)}</p>
                </a>
              ))}
              {itemPolicies.length === 0 && itemDebates.length === 0 && (
                <a
                  href={localizedHref(`/levers/${leverSlug(lever)}/`, lang)}
                  class="block bg-surface border border-subtle rounded-lg p-4 hover:border-emerald-300 hover:shadow-sm transition-all"
                >
                  <h3 class="font-semibold text-gray-900 dark:text-white text-sm">{L.viewParent}</h3>
                  <p class="text-xs text-gray-600 dark:text-gray-400 mt-2">{pickLocalized(lever, 'subtitle', lang)}</p>
                </a>
              )}
            </div>
          </section>

          {page.item.sourceUrl && (
            <a
              href={page.item.sourceUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-secondary border border-primary/30 hover:border-primary px-4 py-2 rounded-md transition-colors"
            >
              <Icon name="tabler:external-link" class="w-4 h-4" />
              {L.source}
            </a>
          )}
        </>
      )
    }

    <nav class="mt-12 pt-6 border-t border-subtle">
      <a
        href={localizedHref('/levers/', lang)}
        class="text-sm text-primary hover:text-secondary font-medium inline-flex items-center gap-1"
      >
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        {t(lang, 'back')}
        {t(lang, 'navLevers')}
      </a>
    </nav>
  </article>
  <SameTopicRail
    lang={lang}
    kind="lever"
    id={String(page.lever.number)}
    class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 mt-4"
  />
</Layout>
