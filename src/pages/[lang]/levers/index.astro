---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/ui/Headline.astro';
import RelatedRail from '~/components/data/RelatedRail.astro';
import { levers, publicLeverGroups, transmissionExplainer, dataDate } from '~/data/levers';
import { NON_DEFAULT_ROUTE_LOCALES, localizedHref, pickLocalized, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';
import { renderInlineMarkdown } from '~/utils/inline-markdown';
import { leverItemSlug, leverSlug } from '~/utils/entity-pages';

export function getStaticPaths() {
  return NON_DEFAULT_ROUTE_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

// Long-form subtitle + "why classify by lever" intro. Hand-typed for zh/en/ja/ko;
// zh-tw runs the zh source through OpenCC.
const SUBTITLE_BY_LANG: Record<Lang, string> = {
  zh: `数据更新：${dataDate}。把新加坡 Budget 2026 + 各部委的 AI 政策按"AI 引入路径"重新分类，6 个抓手跨多部委——这比按部门分类更能看出整体形状。`,
  en: `${t(lang, 'freshnessUpdated')}: ${dataDate}. Re-classifying Singapore's Budget 2026 plus all ministry-level AI policies along "AI-injection paths" yields six cross-ministry levers — a clearer view of the whole shape than reading them department by department.`,
  ja: `データ更新：${dataDate}。シンガポールの Budget 2026 と各省庁の AI 政策を「AI 導入経路」で再分類——6 つのレバーが複数省庁を横断し、部門別に読むより全体像がはっきり見えます。`,
  'zh-tw': toTraditional(
    `数据更新：${dataDate}。把新加坡 Budget 2026 + 各部委的 AI 政策按"AI 引入路径"重新分类，6 个抓手跨多部委——这比按部门分类更能看出整体形状。`
  ),
  ko: `데이터 업데이트: ${dataDate}. 싱가포르 Budget 2026과 각 부처의 AI 정책을 "AI 도입 경로"에 따라 재분류 — 6개 레버가 여러 부처를 횡단하며, 부서별로 읽는 것보다 전체 형태를 더 명확히 볼 수 있습니다.`,
};
const subtitle = SUBTITLE_BY_LANG[lang] || SUBTITLE_BY_LANG.en;

const WHY_LEVER_HEADING: Record<Lang, string> = {
  zh: '为什么按抓手分类？',
  en: 'Why classify by lever?',
  ja: 'なぜレバーで分類するのか？',
  'zh-tw': toTraditional('为什么按抓手分类？'),
  ko: '왜 레버로 분류하는가?',
};
const whyLeverHeading = WHY_LEVER_HEADING[lang] || WHY_LEVER_HEADING.en;

const WHY_LEVER_BODY_MD: Record<Lang, string> = {
  zh: `多数 AI 政策文章把"国家"和"企业"并列分析——错过了嵌套关系。新加坡战略的本质是**把整个国家当成企业 AI-native 转型的"包装层"**：国家自己不必成为 AI-native，只要把企业转型速度放大就够了。

6 个抓手按"AI 引入路径"分类（基建 → 治理 → 人才 → 应用 → 政府自用 → 外交）。每个抓手都跨多个部委，串起来才是完整的执行管线。`,
  en: `Most analyses treat the state and the enterprise as parallel actors — and miss the nesting relationship. The essence of Singapore's strategy is to **treat the entire state as the wrapper layer for enterprise AI-native transformation**: the state itself need not become AI-native; it is enough to amplify the speed at which enterprises do.

The six levers map "AI-injection paths" (infrastructure → governance → talent → applications → government self-use → diplomacy). Each lever crosses multiple ministries; chained together, they form the full execution pipeline.`,
  ja: `多くの AI 政策分析は「国家」と「企業」を並列のアクターとして扱い——入れ子関係を見落としています。シンガポール戦略の本質は**国家全体を企業の AI-native トランスフォーメーションの「ラッパー層」とする**ことです：国家自身が AI-native になる必要はなく、企業のトランスフォーメーション速度を増幅すれば十分です。

6 つのレバーは「AI 導入経路」で分類されます（インフラ → ガバナンス → 人材 → 応用 → 政府自用 → 外交）。各レバーは複数の省庁を横断し、つなげて初めて完全な実行パイプラインになります。`,
  'zh-tw': '',
  ko: `대부분의 AI 정책 분석은 "국가"와 "기업"을 병렬적 행위자로 다루어——중첩 관계를 놓칩니다. 싱가포르 전략의 본질은 **국가 전체를 기업 AI-native 전환의 "래퍼 계층"으로 삼는 것**입니다: 국가 스스로 AI-native가 될 필요는 없으며, 기업 전환 속도를 증폭시키는 것으로 충분합니다.

6개 레버는 "AI 도입 경로"에 따라 분류됩니다 (인프라 → 거버넌스 → 인재 → 응용 → 정부 자체 활용 → 외교). 각 레버는 여러 부처를 횡단하며, 연결되어야 비로소 완전한 실행 파이프라인이 됩니다.`,
};
WHY_LEVER_BODY_MD['zh-tw'] = toTraditional(WHY_LEVER_BODY_MD.zh);
const whyLeverBodyMd = WHY_LEVER_BODY_MD[lang] || WHY_LEVER_BODY_MD.en;

const STATE_DIRECT_LABEL: Record<Lang, string> = {
  zh: '国家直接做的事',
  en: 'What the state does',
  ja: '国家が直接行うこと',
  'zh-tw': toTraditional('国家直接做的事'),
  ko: '국가가 직접 하는 일',
};
const stateDirectLabel = STATE_DIRECT_LABEL[lang] || STATE_DIRECT_LABEL.en;

const BOTTLENECK_LABEL: Record<Lang, string> = {
  zh: '解决企业的什么瓶颈',
  en: 'Enterprise bottleneck solved',
  ja: '企業のどのボトルネックを解決するか',
  'zh-tw': toTraditional('解决企业的什么瓶颈'),
  ko: '기업의 어떤 병목을 해결하는가',
};
const bottleneckLabel = BOTTLENECK_LABEL[lang] || BOTTLENECK_LABEL.en;

const DETAIL_ARROW_LABEL: Record<Lang, string> = {
  zh: '详情 →',
  en: 'Detail →',
  ja: '詳細を見る →',
  'zh-tw': toTraditional('详情 →'),
  ko: '자세히 보기 →',
};
const detailArrowLabel = DETAIL_ARROW_LABEL[lang] || DETAIL_ARROW_LABEL.en;

const FURTHER_READING_LABEL: Record<Lang, string> = {
  zh: '延伸阅读：',
  en: 'Further reading:',
  ja: '関連の読み物：',
  'zh-tw': toTraditional('延伸阅读：'),
  ko: '추가 자료:',
};
const furtherReadingLabel = FURTHER_READING_LABEL[lang] || FURTHER_READING_LABEL.en;

const NATIVE_VS_NATIONS_LABEL: Record<Lang, string> = {
  zh: '从 50 人到 5,700,000 人——同一种 AI-native 架构，两个尺度',
  en: 'From 50 to 5,700,000 — the same AI-native architecture, two scales',
  ja: '50 人から 570 万人へ — 同じ AI-native アーキテクチャ、2 つのスケール',
  'zh-tw': toTraditional('从 50 人到 5,700,000 人——同一种 AI-native 架构，两个尺度'),
  ko: '50명에서 570만명까지 — 동일한 AI-native 아키텍처, 두 가지 규모',
};
const nativeVsNationsLabel = NATIVE_VS_NATIONS_LABEL[lang] || NATIVE_VS_NATIONS_LABEL.en;
---

<Layout
  metadata={{
    title: t(lang, 'leversPageTitle'),
    description: t(lang, 'leversPageDesc'),
  }}
  breadcrumbs={[{ label: t(lang, 'navLevers') }]}
  lang={lang}
>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 max-w-6xl">
    <Headline title={`🎯 ${t(lang, 'leversPageTitle')}`} subtitle={subtitle} />

    <div class="callout-note rounded-lg mb-12 leading-relaxed">
      <p class="font-bold text-base mb-2">{whyLeverHeading}</p>
      <div class="text-base space-y-2" set:html={renderInlineMarkdown(whyLeverBodyMd)} />
    </div>

    <div class="space-y-16">
      {
        levers.map((lever) => (
          <div class="border border-subtle rounded-xl p-8 bg-surface shadow-md">
            <div class="flex items-start gap-4 mb-6 flex-wrap">
              <div class="text-5xl">{lever.icon}</div>
              <div class="flex-1 min-w-[280px]">
                <div class="flex items-center gap-3 flex-wrap mb-1">
                  <h2 class="t-h2 m-0">
                    <a
                      href={localizedHref(`/levers/${leverSlug(lever)}/`, lang)}
                      class="hover:text-blue-600 dark:hover:text-blue-400"
                    >
                      {t(lang, 'leverWord')} {lever.number} · {pickLocalized(lever, 'name', lang)}
                    </a>
                  </h2>
                  {lever.transmissionMode === 'direct' ? (
                    <span class="text-xs font-bold bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 px-2 py-1 rounded">
                      {t(lang, 'leverMapColDirect')}
                    </span>
                  ) : (
                    <span class="text-xs font-bold bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200 px-2 py-1 rounded">
                      {t(lang, 'leverMapColPassThrough')}
                    </span>
                  )}
                </div>
                <p class="text-base text-muted m-0">{pickLocalized(lever, 'subtitle', lang)}</p>
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-4 mb-6 text-sm">
              <div class="bg-slate-50 dark:bg-slate-800 p-4 rounded-lg">
                <div class="text-xs font-bold uppercase tracking-wide text-slate-500 mb-1">{stateDirectLabel}</div>
                <div>{pickLocalized(lever, 'whatStateDoes', lang)}</div>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800 p-4 rounded-lg">
                <div class="text-xs font-bold uppercase tracking-wide text-slate-500 mb-1">{bottleneckLabel}</div>
                <div>{pickLocalized(lever, 'bottleneckSolved', lang)}</div>
              </div>
            </div>

            {publicLeverGroups(lever).map((group) => (
              <div class="mb-6">
                <h3 class="text-lg font-bold mb-3 border-b border-subtle pb-1">
                  {pickLocalized(group, 'title', lang)}
                </h3>
                <div class="grid gap-3 md:grid-cols-2">
                  {group.items.map((item) => (
                    <div class="border border-subtle rounded-lg p-4 hover:shadow-md transition-shadow">
                      <div class="flex items-start gap-2 flex-wrap mb-2">
                        <h4 class="text-base font-bold m-0 flex-1 min-w-0">
                          <a
                            href={localizedHref(`/levers/${leverItemSlug(item)}/`, lang)}
                            class="hover:text-blue-600 dark:hover:text-blue-400"
                          >
                            {pickLocalized(item, 'name', lang)}
                          </a>
                        </h4>
                        <span class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-2 py-1 rounded shrink-0">
                          {pickLocalized(item, 'ministry', lang)}
                        </span>
                      </div>
                      {item.scale && (
                        <div class="text-sm font-mono font-bold text-slate-700 dark:text-slate-300 mb-1">
                          {pickLocalized(item, 'scale', lang)}
                        </div>
                      )}
                      <p class="text-sm text-muted m-0 mb-2">{pickLocalized(item, 'description', lang)}</p>
                      {item.sourceUrl && (
                        <div class="flex flex-wrap gap-3">
                          <a
                            href={localizedHref(`/levers/${leverItemSlug(item)}/`, lang)}
                            class="text-xs text-blue-600 dark:text-blue-400 hover:underline"
                          >
                            {detailArrowLabel}
                          </a>
                          <a
                            href={item.sourceUrl}
                            target="_blank"
                            rel="noopener"
                            class="text-xs text-blue-600 dark:text-blue-400 hover:underline"
                          >
                            🔗 {t(lang, 'source')}
                          </a>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            ))}

            {lever.insight && (
              <div class="callout-muted rounded mt-4 italic">💡 {pickLocalized(lever, 'insight', lang)}</div>
            )}
            <RelatedRail entity={{ type: 'lever', id: lever.number }} variant="compact" />
          </div>
        ))
      }
    </div>

    <div class="mt-16 bg-surface rounded-xl p-8 border border-subtle">
      <h2 class="t-h2 mb-4">{pickLocalized(transmissionExplainer, 'title', lang)}</h2>
      <pre
        class="text-sm whitespace-pre-wrap leading-relaxed bg-transparent p-0 border-0 m-0">{pickLocalized(transmissionExplainer, 'body', lang)}</pre>
    </div>

    <div class="mt-12 text-sm text-muted text-center">
      {furtherReadingLabel}
      <a
        href={localizedHref('/singapore-ai-native-companies-vs-nations/', lang)}
        class="text-blue-600 dark:text-blue-400 hover:underline"
      >
        {nativeVsNationsLabel}
      </a>
    </div>
  </section>
</Layout>
