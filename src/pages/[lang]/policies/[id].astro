---
// Policy detail page ([lang]). One page per Policy.id × non-default locale.

import type { GetStaticPaths } from 'astro';

import JsonLd from '~/components/common/JsonLd.astro';
import PolicyProfile from '~/components/data/PolicyProfile.astro';
import Layout from '~/layouts/PageLayout.astro';
import SameTopicRail from '~/components/data/SameTopicRail.astro';
import CiteBlock from '~/components/common/CiteBlock.astro';
import { categories } from '~/data/policies';
import { NON_DEFAULT_ROUTE_LOCALES, localizedHref, pickLocalized, t, type Lang } from '~/i18n';
import { synthesizeMetaDescription } from '~/utils/seo-meta';

export const prerender = true;

export const getStaticPaths = (() => {
  const all = categories.flatMap((c) =>
    c.policies.map((p) => ({ ...p, _categoryName: c.name, _categoryNameEn: c.nameEn, _categoryIcon: c.icon }))
  );
  return NON_DEFAULT_ROUTE_LOCALES.flatMap((lang) =>
    all
      .filter((p) => p.id)
      .map((policy) => ({
        params: { lang, id: policy.id! },
        props: { policy },
      }))
  );
}) satisfies GetStaticPaths;

const { policy } = Astro.props;
const lang = Astro.params.lang as Lang;

const title = pickLocalized<string>(policy, 'title', lang) || policy.title;
const summary = pickLocalized<string>(policy, 'summary', lang) || '';

// Year + ministry baked into description. Title carries only the year —
// Metadata.astro's template already appends the `· sgai` brand token, so a
// page-level section suffix on top double-branded every title (GSC 2026-07).
const isCjk = lang === 'zh' || lang === 'zh-tw';
const yearMatch = (policy.date || '').slice(0, 4);
const metaPrefix = [yearMatch, policy.ministry].filter(Boolean).join(' · ');
const metaJoiner = isCjk ? '。' : '. ';
const metaDescription = synthesizeMetaDescription([
  metaPrefix && summary ? `${metaPrefix}${metaJoiner}${summary}` : summary || metaPrefix,
]);

const metadata = {
  title: `${title}${yearMatch ? `（${yearMatch}）` : ''}`,
  description: metaDescription,
};

const datePadded =
  policy.date.length === 4 ? `${policy.date}-01-01` : policy.date.length === 7 ? `${policy.date}-01` : policy.date;
const datePublished = `${datePadded}T00:00:00+08:00`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished,
  description: summary,
  ...(policy.ministry ? { author: { '@type': 'Organization', name: policy.ministry } } : {}),
};

const govServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentService',
  name: policy.titleEn || policy.title,
  alternateName: policy.title,
  description: summary,
  serviceType: 'Policy document',
  ...(policy.ministry ? { provider: { '@type': 'GovernmentOrganization', name: policy.ministry } } : {}),
};

const breadcrumbs = [{ label: t(lang, 'navPolicies'), href: localizedHref('/policies/', lang) }, { label: title }];
---

<Layout metadata={metadata} breadcrumbs={breadcrumbs} lang={lang}>
  <JsonLd schema={articleSchema} />
  <JsonLd schema={govServiceSchema} />
  <PolicyProfile policy={policy} lang={lang} />
  <CiteBlock
    title={title}
    anchorId={policy.id ?? 'policy'}
    markdownHref={localizedHref(`/policies/${policy.id}.md`, lang)}
  />
  <SameTopicRail lang={lang} kind="policy" id={policy.id ?? ''} class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 mt-4" />
</Layout>
