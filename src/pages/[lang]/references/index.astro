---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/ui/Headline.astro';
import { sections } from '~/data/references';
import { NON_DEFAULT_ROUTE_LOCALES, pickLocalized, t, type Lang } from '~/i18n';

export function getStaticPaths() {
  return NON_DEFAULT_ROUTE_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

// One-off page copy (intro subtitle + footer note), not reused elsewhere —
// kept as a local per-locale dict per the project's i18n convention rather
// than growing the central dictionary for single-use strings.
const SUBTITLE: Record<Lang, string> = {
  zh: '新加坡 AI 政策相关的官方文件、研究报告、新闻报道和分析文章。',
  en: "Official documents, research reports, news coverage, and analytical reading on Singapore's AI policy.",
  ja: 'シンガポールの AI 政策に関する公式文書、調査報告書、報道、分析記事。',
  'zh-tw': '新加坡 AI 政策相關的官方文件、研究報告、新聞報道和分析文章。',
  ko: '싱가포르 AI 정책 관련 공식 문서, 연구 보고서, 뉴스 보도 및 분석 기사.',
};
const FOOTER_NOTE: Record<Lang, string> = {
  zh: '共 30+ 条参考资料，持续更新中。欢迎提交新资源。',
  en: '30+ references; the list grows over time. Submit additions on GitHub.',
  ja: '30 件以上の参考資料を継続的に更新しています。GitHub から新規リソースの提案を歓迎します。',
  'zh-tw': '共 30+ 條參考資料，持續更新中。歡迎提交新資源。',
  ko: '30개 이상의 참고 자료를 지속적으로 업데이트하고 있습니다. GitHub에서 새로운 자료를 제안해 주세요.',
};
const CHINESE_TRANSLATION_LABEL: Record<Lang, string> = {
  zh: '[中文翻译]',
  en: '[Chinese translation]',
  ja: '[中国語訳]',
  'zh-tw': '[中文翻譯]',
  ko: '[중국어 번역]',
};
---

<Layout
  metadata={{
    title: t(lang, 'referencesPageTitle'),
    description: t(lang, 'referencesPageDesc'),
  }}
  breadcrumbs={[{ label: t(lang, 'navReferences') }]}
  lang={lang}
>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 max-w-4xl">
    <Headline title={`📚 ${t(lang, 'referencesPageTitle')}`} subtitle={SUBTITLE[lang]} />

    <div class="space-y-8">
      {
        sections.map((section) => (
          <div>
            <h2 class="t-h3 mb-3">
              {section.icon} {pickLocalized(section, 'title', lang)}
            </h2>
            <ul class="space-y-2">
              {section.links.map((link) => (
                <li class="flex items-start gap-2">
                  <span class="text-blue-500 mt-1">&bull;</span>
                  <div>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener"
                      class="text-blue-600 dark:text-blue-400 hover:underline"
                    >
                      {pickLocalized(link, 'text', lang)}
                    </a>
                    {link.translation && (
                      <a
                        href={link.translation}
                        class="text-sm text-green-600 dark:text-green-400 hover:underline ml-2"
                      >
                        {CHINESE_TRANSLATION_LABEL[lang]}
                      </a>
                    )}
                    {pickLocalized(link, 'note', lang) && (
                      <span class="text-sm text-muted ml-2">— {pickLocalized(link, 'note', lang)}</span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-muted">{FOOTER_NOTE[lang]}</p>
  </section>
</Layout>
