---
// Debate detail page ([lang]). One page per Debate.id x non-default locale.

import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SameTopicRail from '~/components/data/SameTopicRail.astro';
import PrevNextNav from '~/components/common/PrevNextNav.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import CiteBlock from '~/components/common/CiteBlock.astro';
import RelatedRail from '~/components/data/RelatedRail.astro';
import { Icon } from 'astro-icon/components';
import { debates } from '~/data/debates';
import { getDebateTranscript, getDebateTranscriptParagraphs } from '~/data/debate-transcripts';
import { debateTypeLabel, debateTopicLabel } from '~/utils/debate-labels';
import { DEBATE_TOPIC_TO_TOPIC_IDS } from '~/data/topic-mappings';
import { findPersonId, getPerson, personDisplayName } from '~/utils/people';
import { NON_DEFAULT_ROUTE_LOCALES, IN_LANGUAGES, t, pickLocalized, localizedHref, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';
import { synthesizeMetaDescription } from '~/utils/seo-meta';

export const prerender = true;

export const getStaticPaths = (() =>
  NON_DEFAULT_ROUTE_LOCALES.flatMap((lang) =>
    debates.map((debate) => ({
      params: { lang, id: debate.id },
      props: { debate },
    }))
  )) satisfies GetStaticPaths;

const { debate } = Astro.props;

// Linear prev/next: date ascending, ties broken by id for stability.
const _pnSorted = [...debates].sort((a, b) => (a.date === b.date ? (a.id < b.id ? -1 : 1) : a.date < b.date ? -1 : 1));
const _pnIdx = _pnSorted.findIndex((r) => r.id === debate.id);
const pnPrev = _pnIdx > 0 ? _pnSorted[_pnIdx - 1] : undefined;
const pnNext = _pnIdx >= 0 && _pnIdx < _pnSorted.length - 1 ? _pnSorted[_pnIdx + 1] : undefined;
const lang = Astro.params.lang as Lang;
// isCjk groups zh + zh-tw — both prefer the zh content track. zh-tw runs
// returned strings through OpenCC at the field level via pickLocalized.
const isZh = lang === 'zh';
const isCjk = lang === 'zh' || lang === 'zh-tw';

const transcript = getDebateTranscript(debate.id);
const transcriptZh = getDebateTranscriptParagraphs(debate.id, 'zh');
const transcriptEn = getDebateTranscriptParagraphs(debate.id, 'en');
// Localized full-text track. ja/ko must NOT fall back to English here — the
// English original renders in its own verbatim section below, and a "full
// translation" heading over English text is a silent wrong-language page.
const transcriptLocal =
  lang === 'ja' ? (transcript?.paragraphsJa ?? []) : lang === 'ko' ? (transcript?.paragraphsKo ?? []) : transcriptZh;
const originalParagraphs = transcriptEn.length
  ? transcriptEn
  : isCjk
    ? debate.summary
      ? [debate.summary]
      : []
    : debate.transcriptEn
      ? [debate.transcriptEn]
      : [];

// Controversy labels per locale. Use the shared `t` dictionary entries
// (added below) so adding a sixth locale only needs a dict update.
const CONTROVERSY_LABELS: Record<Lang, Record<number, string>> = {
  zh: { 1: '信息发布', 2: '温和质询', 3: '实质辩论', 4: '激烈争议', 5: '高度对立' },
  en: { 1: 'Information', 2: 'Mild query', 3: 'Substantive debate', 4: 'Heated dispute', 5: 'High polarisation' },
  ja: { 1: '情報発信', 2: '軽度質問', 3: '実質的議論', 4: '激しい論争', 5: '高度な対立' },
  'zh-tw': {
    1: toTraditional('信息发布'),
    2: toTraditional('温和质询'),
    3: toTraditional('实质辩论'),
    4: toTraditional('激烈争议'),
    5: toTraditional('高度对立'),
  },
  ko: { 1: '정보 공개', 2: '온건한 질의', 3: '실질적 토론', 4: '치열한 논쟁', 5: '높은 대립' },
};
const controversyLabels = CONTROVERSY_LABELS[lang] || CONTROVERSY_LABELS.en;

const speakers = debate.speakers.map((raw) => {
  const pid = findPersonId(raw);
  const p = pid ? getPerson(pid) : undefined;
  // Speaker display: zh and zh-tw use the curated Chinese name (zh-tw via
  // OpenCC), keeping speaker names consistent with the rest of the localized
  // page. ja / ko / en fall through to the Latin Roman name — no *Ja/*Ko name
  // fields exist at the data layer, and Singapore MP names are written in
  // Latin in ja/ko press.
  let display = raw;
  if (p) {
    if (lang === 'zh') display = personDisplayName(pid!);
    else if (lang === 'zh-tw') display = toTraditional(personDisplayName(pid!));
    else display = p.nameEn || p.name || raw;
  }
  return { raw, pid, display };
});

const summaryShort = pickLocalized<string>(debate, 'summary', lang) || debate.summary || '';
const whyItMatters = pickLocalized<string>(debate, 'whyItMatters', lang) || '';
const keyPointsRaw = pickLocalized<string[]>(debate, 'keyPoints', 'keyPointsEn', lang);
const keyPoints = (Array.isArray(keyPointsRaw) ? keyPointsRaw : debate.keyPoints) || [];
const govStance = pickLocalized<string>(debate, 'governmentStance', 'governmentStanceEn', lang);
const oppStance = pickLocalized<string>(debate, 'oppositionStance', 'oppositionStanceEn', lang);
const policySignal = pickLocalized<string>(debate, 'policySignal', 'policySignalEn', lang);
const notableQuote = pickLocalized<string>(debate, 'notableQuote', 'notableQuoteEn', lang);

const debateTitle = pickLocalized<string>(debate, 'title', 'titleEn', lang) || debate.title;

// SERP-optimised title: include date + brand suffix. The data title already
// carries year/ministry/topic where applicable (e.g. "2026 MOH COS — Gen AI
// for Clinical Documentation"), so we just anchor it with date + site.
const yearMatch = (debate.date || '').slice(0, 4);
const typeLabelForMeta = debateTypeLabel(debate.type, lang);
const topicListForMeta = (debate.topics || [])
  .map((tt) => debateTopicLabel(tt, lang))
  .slice(0, 2)
  .join(' · ');
const metaDescPrefix = [debate.date, typeLabelForMeta, topicListForMeta].filter(Boolean).join(' · ');
const metaDescription = synthesizeMetaDescription([
  metaDescPrefix && summaryShort ? `${metaDescPrefix}。${summaryShort}` : summaryShort || metaDescPrefix,
]);

const metadata = {
  title: `${debateTitle}（${yearMatch}）`,
  description: metaDescription,
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: debateTitle,
  // Both zh and zh-tw display the CJK title as primary (isCjk, defined
  // above), so both benefit from the raw zh title as an alternativeHeadline.
  ...(isCjk ? { alternativeHeadline: debate.title } : {}),
  description: summaryShort,
  datePublished: debate.date,
  inLanguage: IN_LANGUAGES[lang],
  isPartOf: { '@type': 'CreativeWork', name: 'Singapore Hansard', url: 'https://sprs.parl.gov.sg/' },
};

const breadcrumbs = [
  { label: t(lang, 'navParliament'), href: localizedHref('/debates/', lang) },
  { label: debateTitle },
];
---

<Layout metadata={metadata} breadcrumbs={breadcrumbs} lang={lang}>
  <JsonLd schema={articleSchema} />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <p class="text-xs uppercase tracking-[0.18em] text-primary font-semibold mb-4">
      {debateTypeLabel(debate.type, lang)} · {debate.date} · {t(lang, 'parliamentSession')}
      {debate.parliament}
    </p>
    <h1 class="t-display text-gray-900 dark:text-white mb-3">
      {debateTitle}
    </h1>
    {
      isZh && (
        <p class="text-sm md:text-base text-gray-500 dark:text-gray-400 italic mb-6 leading-relaxed">{debate.title}</p>
      )
    }

    {
      debate.topics && debate.topics.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {debate.topics.map((tp) => {
            const tid = DEBATE_TOPIC_TO_TOPIC_IDS[tp]?.[0];
            const label = debateTopicLabel(tp, lang);
            return tid ? (
              <a
                href={localizedHref(`/topics/${tid}/`, lang)}
                class="text-xs bg-primary/10 text-primary hover:bg-primary/20 px-3 py-1.5 rounded-full transition-colors"
              >
                {label}
              </a>
            ) : (
              <span class="text-xs bg-primary/10 text-primary px-3 py-1.5 rounded-full">{label}</span>
            );
          })}
          <span class="text-xs bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-3 py-1.5 rounded-full ml-auto">
            {t(lang, 'controversyLevel')} {debate.controversyLevel} · {controversyLabels[debate.controversyLevel] || ''}
          </span>
        </div>
      )
    }

    {
      summaryShort && (
        <p class="font-serif text-lg leading-[1.85] text-gray-800 dark:text-gray-200 mb-8 border-l-4 border-primary pl-5 italic">
          {summaryShort}
        </p>
      )
    }
    {
      whyItMatters && (
        <section class="callout-note rounded-lg p-5 mb-8">
          <h2 class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold mb-2">
            {t(lang, 'whyItMattersHeading')}
          </h2>
          <p class="text-gray-900 dark:text-white leading-relaxed font-medium">{whyItMatters}</p>
        </section>
      )
    }

    {
      keyPoints.length > 0 && (
        <section class="mb-8">
          <h2 class="t-h3 text-gray-900 dark:text-white mb-4">{t(lang, 'keyPoints')}</h2>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300 leading-[1.85]">
            {keyPoints.map((kp) => (
              <li class="flex gap-3">
                <span class="text-primary shrink-0 mt-1">&bull;</span>
                <span>{kp}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (govStance || oppStance) && (
        <section class="mb-8 grid md:grid-cols-2 gap-4">
          {govStance && (
            <div class="border border-subtle rounded-lg p-4">
              <div class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-2">
                {t(lang, 'governmentStance')}
              </div>
              <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">{govStance}</p>
            </div>
          )}
          {oppStance && (
            <div class="border border-subtle rounded-lg p-4">
              <div class="text-xs font-semibold uppercase tracking-wider text-orange-600 dark:text-orange-400 mb-2">
                {t(lang, 'oppositionStance')}
              </div>
              <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">{oppStance}</p>
            </div>
          )}
        </section>
      )
    }

    {
      policySignal && (
        <section class="mb-8 bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-lg p-4">
          <div class="text-xs font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400 mb-1">
            {t(lang, 'policySignal')}
          </div>
          <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">{policySignal}</p>
        </section>
      )
    }

    {
      notableQuote && (
        <blockquote class="border-l-4 border-gray-300 dark:border-gray-600 pl-5 my-8 text-lg font-serif italic text-gray-700 dark:text-gray-300 leading-[1.85]">
          &ldquo;{notableQuote}&rdquo;
        </blockquote>
      )
    }

    {
      speakers.length > 0 && (
        <section class="mb-8 mt-10 pt-6 border-t border-subtle">
          <h2 class="text-sm uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold mb-3">
            {t(lang, 'participants')} ({speakers.length})
          </h2>
          <ul class="flex flex-wrap gap-x-4 gap-y-2">
            {speakers.map((s) => (
              <li>
                {s.pid ? (
                  <a
                    href={localizedHref(`/voices/${s.pid}/`, lang)}
                    class="text-primary hover:text-secondary text-sm font-medium"
                    title={s.raw}
                  >
                    {s.display}
                  </a>
                ) : (
                  <span class="text-sm text-gray-700 dark:text-gray-300">{s.raw}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      transcriptLocal.length > 0 && (
        <section class="my-8 border border-primary/20 bg-primary/5 rounded-xl p-5">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
            <h2 class="t-h3 text-gray-900 dark:text-white">{t(lang, 'fullTextTranslated')}</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              {t(lang, 'hansardSource')}
              {transcript?.translatedAt && ` · ${transcript.translatedAt}`}
            </p>
          </div>
          <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-[1.9]">
            {transcriptLocal.map((paragraph) => (
              <p>{lang === 'zh-tw' ? toTraditional(paragraph) : paragraph}</p>
            ))}
          </div>
        </section>
      )
    }

    {
      originalParagraphs.length > 0 && (
        <section
          class="my-8 border border-subtle rounded-xl p-5"
          data-i18n-allow-cjk="hansard-original"
          data-i18n-allow-en="hansard-original"
        >
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
            <h2 class="t-h3 text-gray-900 dark:text-white">{t(lang, 'fullTextEn')}</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              {t(lang, 'sprsHansardOriginal')}
              {transcript?.fetchedAt && ` · ${t(lang, 'fetchedAtColon')}${transcript.fetchedAt}`}
            </p>
          </div>
          <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            {originalParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-10 flex flex-wrap gap-3">
      {
        debate.sourceUrl && (
          <a
            href={debate.sourceUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-secondary border border-primary/30 hover:border-primary px-4 py-2 rounded-md transition-colors"
          >
            <Icon name="tabler:external-link" class="w-4 h-4" />
            {t(lang, 'hansardSource')}
          </a>
        )
      }
    </div>

    <RelatedRail entity={{ type: 'debate', id: debate.id }} variant="full" hideWhenEmpty={true} class="mt-12" />

    <nav class="mt-12 pt-6 border-t border-subtle">
      <a
        href={localizedHref('/debates/', lang)}
        class="text-sm text-primary hover:text-secondary font-medium inline-flex items-center gap-1"
      >
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        {t(lang, 'back')}
        {t(lang, 'navParliament')}
      </a>
    </nav>
  </article>
  <PrevNextNav
    lang={lang}
    prev={pnPrev && {
      href: localizedHref(`/debates/${pnPrev.id}/`, lang),
      label: pickLocalized<string>(pnPrev, 'title', lang) || pnPrev.title,
    }}
    next={pnNext && {
      href: localizedHref(`/debates/${pnNext.id}/`, lang),
      label: pickLocalized<string>(pnNext, 'title', lang) || pnNext.title,
    }}
    class="max-w-5xl mx-auto px-4 sm:px-6 mt-8"
  />
  <CiteBlock title={debateTitle} anchorId={debate.id} markdownHref={localizedHref(`/debates/${debate.id}.md`, lang)} />
  <SameTopicRail lang={lang} kind="debate" id={debate.id} class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 mt-4" />
</Layout>
