---
import Layout from '~/layouts/PageLayout.astro';
import { NON_DEFAULT_ROUTE_LOCALES, localizedHref, t, type Lang } from '~/i18n';
import { deepToTraditional } from '~/i18n/opencc';

export function getStaticPaths() {
  return NON_DEFAULT_ROUTE_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const dashboardHref = localizedHref('/tracker/', lang);

const metadata = {
  title: `${t(lang, 'trackerMethodologyTitle')} · ${t(lang, 'trackerPageTitle')}`,
  description: t(lang, 'trackerMethodologyDesc'),
};

// Methodology body modelled as structured data so each locale is a data
// entry rather than a JSX branch. zh-tw is derived from zh via OpenCC
// (deepToTraditional) instead of a hand-maintained parallel structure.
//
// A "block" is one rendered element. `p` renders a paragraph; `ul` / `ol`
// render lists; `h3` renders a sub-heading. Inline `**bold**` and `*em*`
// markers are parsed by the renderer below, so bold labels and emphasis
// survive the transcription verbatim.
type Block = { kind: 'p'; text: string } | { kind: 'h3'; text: string } | { kind: 'ul' | 'ol'; items: string[] };
type Section = { h: string; blocks: Block[] };

