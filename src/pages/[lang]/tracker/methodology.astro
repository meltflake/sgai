const content =
  lang === 'zh-tw' ? deepToTraditional(CONTENT.zh) : (CONTENT[lang as 'zh' | 'en' | 'ja' | 'ko'] ?? CONTENT.en);

// Parse inline **bold** / *em* markers into segment tuples the template can
// render without dangerouslySetInnerHTML. Order matters: strong (`**`) is
// matched before em (`*`) so `**x**` isn't mis-split as two em runs.
type Seg = { t: 'text' | 'strong' | 'em'; v: string };
function parseInline(s: string): Seg[] {
  const segs: Seg[] = [];
  const re = /\*\*([^*]+)\*\*|\*([^*]+)\*/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s)) !== null) {
    if (m.index > last) segs.push({ t: 'text', v: s.slice(last, m.index) });
    if (m[1] !== undefined) segs.push({ t: 'strong', v: m[1] });
    else segs.push({ t: 'em', v: m[2] });
    last = re.lastIndex;
  }
  if (last < s.length) segs.push({ t: 'text', v: s.slice(last) });
  return segs;
}
---

<Layout
  metadata={metadata}
  breadcrumbs={[
    { label: t(lang, 'trackerPageTitle'), href: dashboardHref },
    { label: t(lang, 'trackerMethodologyTitle') },
  ]}
  lang={lang}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16 prose dark:prose-invert">
    <h1 class="not-prose t-display mb-6">{t(lang, 'trackerMethodologyTitle')}</h1>

    {
      content.map((section) => (
        <>
          <h2>{section.h}</h2>
          {section.blocks.map((block) => {
            if (block.kind === 'h3') return <h3>{block.text}</h3>;
            if (block.kind === 'p')
              return (
                <p>
                  {parseInline(block.text).map((seg) =>
                    seg.t === 'strong' ? <strong>{seg.v}</strong> : seg.t === 'em' ? <em>{seg.v}</em> : seg.v
                  )}
                </p>
              );
            const items = block.items.map((item) => (
              <li>
                {parseInline(item).map((seg) =>
                  seg.t === 'strong' ? <strong>{seg.v}</strong> : seg.t === 'em' ? <em>{seg.v}</em> : seg.v
                )}
              </li>
            ));
            return block.kind === 'ol' ? <ol>{items}</ol> : <ul>{items}</ul>;
          })}
        </>
      ))
    }
  </article>
</Layout>
