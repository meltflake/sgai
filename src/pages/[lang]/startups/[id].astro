---
// Startup entity detail page ([lang]). One page per startup slug x non-default
// locale. Thin wrapper around the shared StartupProfile component — see
// src/components/startups/StartupProfile.astro.
import type { GetStaticPaths } from 'astro';

import StartupProfile from '~/components/startups/StartupProfile.astro';
import { startupEntityPages, type StartupEntityPage } from '~/utils/entity-pages';
import { NON_DEFAULT_ROUTE_LOCALES, type Lang } from '~/i18n';

export const prerender = true;

export const getStaticPaths = (() =>
  NON_DEFAULT_ROUTE_LOCALES.flatMap((lang) =>
    startupEntityPages.map((page) => ({
      params: { lang, id: page.slug },
      props: { page },
    }))
  )) satisfies GetStaticPaths;

const { page } = Astro.props as { page: StartupEntityPage };
const lang = Astro.params.lang as Lang;
---

<StartupProfile page={page} lang={lang} />
