---
// Voice profile page ([lang]). One page per person.id x non-default locale.

import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';

import JsonLd from '~/components/common/JsonLd.astro';
import Layout from '~/layouts/PageLayout.astro';
import SameTopicRail from '~/components/data/SameTopicRail.astro';
import ParliamentaryRecord from '~/components/widgets/ParliamentaryRecord.astro';
import PersonContributions from '~/components/widgets/PersonContributions.astro';
import { allPeople, type Person } from '~/data/people';
import { videos } from '~/data/videos';
import { getRelated, getPersonCounts } from '~/utils/graph';
import { buildParliamentarySummary } from '~/utils/parliamentary-record';
import { isLowSignalPerson } from '~/utils/quality';
import { NON_DEFAULT_ROUTE_LOCALES, channelLabel, pickLocalized, localizedHref, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';
import { synthesizeMetaDescription } from '~/utils/seo-meta';
import { personDisplayName } from '~/utils/people';

export const prerender = true;

export const getStaticPaths = (() =>
  NON_DEFAULT_ROUTE_LOCALES.flatMap((lang) =>
    allPeople.map((person) => ({
      params: { lang, id: person.id },
      props: { person },
    }))
  )) satisfies GetStaticPaths;

const { person } = Astro.props as { person: Person };
const lang = Astro.params.lang as Lang;
const isZh = lang === 'zh';

const related = getRelated({ type: 'person', id: person.id });
const counts = getPersonCounts(person.id);
// video.speaker is always stored in Latin/Roman form (Singapore press
// convention), so match against person.nameEn regardless of lang — the
// previous logic picked person.name (Chinese) on zh pages when lang was
// 'zh', comparing it against the Latin video.speaker, which never matched.
const relatedVideos = videos
  .filter((video) => video.speaker === (person.nameEn || person.name) || (person.aliases || []).includes(video.speaker))
  .sort((a, b) => b.date.localeCompare(a.date));

const summary = pickLocalized(person, 'summary', lang) || '';
// On zh-tw, pickLocalized returns the zh stub marker OpenCC-converted to
// '[需補充]' — match both forms or zh-tw stubs masquerade as real bios.
const isStub =
  !summary || summary === 'Profile pending.' || summary.startsWith('[需补充]') || summary.startsWith('[需補充]');

// Auto-generated factual line from the person's parliamentary record
// (≥ 3 debates, see utils/parliamentary-record.ts). For stubs it replaces
// the "Profile pending" boilerplate in the positioning block, the meta
// description, and the JSON-LD description. Localized per lang; zh-tw is
// derived inside the builder via OpenCC (rule #10).
const parlSummary = isStub ? buildParliamentarySummary(person, lang) : null;
const bioLine = (isStub && parlSummary ? parlSummary : summary) || '';
// zh/zh-tw use personDisplayName(id) for the curated bilingual name +
// honorific (with its own nameEn fallback baked in); zh-tw runs it through
// toTraditional per CLAUDE.md rule #10. Other locales prefer pickLocalized
// (which walks ja → en → zh chain via shape A).
const displayName =
  lang === 'zh'
    ? personDisplayName(person.id)
    : lang === 'zh-tw'
      ? toTraditional(personDisplayName(person.id))
      : pickLocalized(person, 'name', lang) || person.name;
const displayTitle =
  lang === 'zh'
    ? person.title
    : lang === 'zh-tw'
      ? toTraditional(person.title)
      : pickLocalized(person, 'title', lang) || person.title;

const categoryLabels: Record<Person['category'], string> = {
  government: t(lang, 'categoryGovernment'),
  academic: t(lang, 'categoryAcademic'),
  industry: t(lang, 'categoryIndustry'),
};

const categoryColors: Record<Person['category'], string> = {
  government: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300',
  academic: 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300',
  industry: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300',
};

// noindex 三无人物：无 curated contributions + 无国会发言 + 无政策 + 无视频。
// 镜像 EN 页面的 robots 策略——同一人，同一索引决定，跨语言一致。
// 一旦补上任何信号自动放开。
const isLowSignal = isLowSignalPerson(person);

// Title suffix per locale — AI topic keyword up front; Metadata.astro's
// template appends the `· sgai` brand token.
const titleSuffixByLang: Record<Lang, string> = {
  zh: '的 AI 政策影响力',
  'zh-tw': toTraditional('的 AI 政策影响力'),
  ja: 'の AI 政策影響力',
  ko: '의 AI 정책 영향력',
  en: ' on AI — Singapore policy, speeches, videos',
};
const titleSuffix = titleSuffixByLang[lang] || titleSuffixByLang.en;

// Build signal line from counts. Empty if all-zero (low-signal profile).
// zh-tw uses zh source strings routed through toTraditional() per CLAUDE.md
// rule #10 (no raw simplified-CJK in zh-tw branches).
const zhTw = (s: string) => toTraditional(s);
const signalParts: string[] = [];
if (counts.debateCount > 0) {
  signalParts.push(
    lang === 'zh'
      ? `国会发言 ${counts.debateCount} 次`
      : lang === 'zh-tw'
        ? zhTw(`国会发言 ${counts.debateCount} 次`)
        : lang === 'ja'
          ? `議会発言 ${counts.debateCount} 回`
          : lang === 'ko'
            ? `국회 발언 ${counts.debateCount} 회`
            : `${counts.debateCount} parliamentary speech${counts.debateCount === 1 ? '' : 'es'}`
  );
}
if (counts.policyAuthorCount > 0) {
  signalParts.push(
    lang === 'zh'
      ? `主导政策 ${counts.policyAuthorCount} 项`
      : lang === 'zh-tw'
        ? zhTw(`主导政策 ${counts.policyAuthorCount} 项`)
        : lang === 'ja'
          ? `主導政策 ${counts.policyAuthorCount} 件`
          : lang === 'ko'
            ? `주도 정책 ${counts.policyAuthorCount} 건`
            : `${counts.policyAuthorCount} polic${counts.policyAuthorCount === 1 ? 'y' : 'ies'}`
  );
}
if (relatedVideos.length > 0) {
  signalParts.push(
    lang === 'zh'
      ? `视频观点 ${relatedVideos.length} 段`
      : lang === 'zh-tw'
        ? zhTw(`视频观点 ${relatedVideos.length} 段`)
        : lang === 'ja'
          ? `動画 ${relatedVideos.length} 本`
          : lang === 'ko'
            ? `영상 ${relatedVideos.length} 편`
            : `${relatedVideos.length} video${relatedVideos.length === 1 ? '' : 's'}`
  );
}
const isCjkPeriod = isZh || lang === 'zh-tw';
const signalLine = signalParts.length > 0 ? signalParts.join(' · ') + (isCjkPeriod ? '。' : '.') : '';
const descParts = [displayTitle ? `${displayTitle}${isCjkPeriod ? '。' : '.'}` : '', bioLine, signalLine].filter(
  Boolean
);
const fallbackDesc =
  lang === 'zh'
    ? `${displayName} 在新加坡 AI 政策中的发言、政策关联与公开视频记录。`
    : lang === 'zh-tw'
      ? `${displayName} 在新加坡 AI 政策中的發言、政策關聯與公開視頻記錄。`
      : lang === 'ja'
        ? `${displayName} のシンガポール AI 政策における発言・政策関連・公開動画記録。`
        : lang === 'ko'
          ? `${displayName}의 싱가포르 AI 정책 관련 발언, 정책 연계, 공개 영상 기록.`
          : `${displayName}'s speeches, policy links, and public AI video records in Singapore.`;

const metadata = {
  title: `${displayName}${titleSuffix}`,
  description: synthesizeMetaDescription(descParts) || fallbackDesc,
  robots: { index: !isLowSignal, follow: true },
};

// Both zh and zh-tw display the CJK name as primary, so both benefit from
// the Latin name as an alternateName (helps schema.org entity resolution).
const isCjkPrimary = lang === 'zh' || lang === 'zh-tw';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: pickLocalized(person, 'name', lang) || person.nameEn || person.name,
  ...(isCjkPrimary ? { alternateName: person.nameEn || person.name } : {}),
  jobTitle: pickLocalized(person, 'title', lang) || person.titleEn || person.title,
  description: bioLine,
  affiliation: person.affiliations.map((name) => ({ '@type': 'Organization', name })),
  sameAs: person.channels.map((ch) => ch.url),
};
---

<Layout
  metadata={metadata}
  breadcrumbs={[{ label: t(lang, 'navVoices'), href: localizedHref('/voices/', lang) }, { label: displayName }]}
  lang={lang}
>
  <JsonLd schema={personSchema} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <header class="mb-8">
      <div class="flex items-start justify-between flex-wrap gap-3">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-primary font-semibold mb-3">AI Influence Profile</p>
          <h1 class="t-display text-gray-900 dark:text-white">
            {displayName}
          </h1>
          {isZh && person.name && <p class="text-lg text-gray-500 dark:text-gray-400 mt-2">{person.name}</p>}
        </div>
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-full shrink-0 ${categoryColors[person.category]}`}>
          {categoryLabels[person.category]}
        </span>
      </div>
      <p class="text-gray-700 dark:text-gray-300 mt-4 font-medium">{displayTitle}</p>
    </header>

    <section class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-8">
      <div class="bg-surface rounded-xl p-4 shadow-sm border border-subtle">
        <div class="t-stat text-blue-600">{counts.debateCount}</div>
        <div class="text-xs text-gray-500 mt-0.5">{t(lang, 'debateCount')}</div>
      </div>
      <div class="bg-surface rounded-xl p-4 shadow-sm border border-subtle">
        <div class="t-stat text-purple-600">{counts.policyAuthorCount}</div>
        <div class="text-xs text-gray-500 mt-0.5">{t(lang, 'policyCount')}</div>
      </div>
      <div class="bg-surface rounded-xl p-4 shadow-sm border border-subtle">
        <div class="t-stat text-rose-600">{relatedVideos.length}</div>
        <div class="text-xs text-gray-500 mt-0.5">{t(lang, 'videoCount')}</div>
      </div>
    </section>

    {
      ((!isStub && summary) || (isStub && parlSummary)) && (
        <section class="callout-note p-5 rounded-lg mb-8">
          <h2 class="font-semibold mb-2">{t(lang, 'voicePositioningHeading')}</h2>
          <p class="text-gray-800 dark:text-gray-200 leading-relaxed">{isStub ? parlSummary : summary}</p>
        </section>
      )
    }

    {
      isStub && !parlSummary && (
        <section class="callout-muted p-4 rounded-lg mb-8 text-sm">
          <p class="text-amber-900 dark:text-amber-200">{t(lang, 'profilePending')}</p>
        </section>
      )
    }

    {
      person.channels.length > 0 && (
        <section class="mb-10">
          <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">
            {t(lang, 'officialChannels')}
          </h2>
          <div class="flex flex-wrap gap-2">
            {person.channels.map((ch) => (
              <a
                href={ch.url}
                target="_blank"
                rel="noopener noreferrer"
                class={`inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full border transition-all hover:shadow-sm ${
                  ch.primary
                    ? 'bg-blue-50 border-blue-300 text-blue-700 font-semibold dark:bg-blue-900/30 dark:border-blue-600 dark:text-blue-300'
                    : 'bg-gray-50 border-gray-200 text-gray-600 hover:border-gray-300 dark:bg-slate-700 dark:border-slate-600 dark:text-gray-300'
                }`}
              >
                {ch.primary && <span class="inline-block w-1.5 h-1.5 rounded-full bg-blue-500 dark:bg-blue-400" />}
                {channelLabel(ch, lang)}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <PersonContributions person={person} lang={lang} />

    <ParliamentaryRecord person={person} lang={lang} />

    {
      related.policies.length > 0 && (
        <section class="mb-10">
          <h2 class="t-h3 text-gray-800 dark:text-white mb-4">
            {t(lang, 'voicePoliciesChampionedHeading').replace('{count}', String(related.policies.length))}
          </h2>
          <div class="grid gap-3">
            {related.policies.map((policy) => (
              <a
                href={policy.id ? localizedHref(`/policies/${policy.id}/`, lang) : localizedHref('/policies/', lang)}
                class="block bg-surface rounded-lg p-4 border border-subtle hover:border-purple-300 hover:shadow-sm transition-all"
              >
                <h3 class="font-semibold text-gray-800 dark:text-white text-sm">
                  {pickLocalized(policy, 'title', lang)}
                </h3>
                <p class="text-xs text-gray-500 mt-0.5">{policy.date}</p>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-2">{pickLocalized(policy, 'summary', lang)}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      relatedVideos.length > 0 && (
        <section class="mb-10">
          <h2 class="t-h3 text-gray-800 dark:text-white mb-4">
            {t(lang, 'voiceAiVideosHeading').replace('{count}', String(relatedVideos.length))}
          </h2>
          <div class="grid gap-3">
            {relatedVideos.map((video) => (
              <a
                href={localizedHref(`/videos/${video.id}/`, lang)}
                class="block bg-surface rounded-lg p-4 border border-subtle hover:border-rose-300 hover:shadow-sm transition-all"
              >
                <h3 class="font-semibold text-gray-800 dark:text-white text-sm">
                  {pickLocalized(video, 'title', lang)}
                </h3>
                <p class="text-xs text-gray-500 mt-0.5">
                  {video.date} · {video.duration} · {video.channel}
                </p>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-2">{pickLocalized(video, 'summary', lang)}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <nav class="mt-12 pt-6 border-t border-subtle">
      <a
        href={localizedHref('/voices/', lang)}
        class="text-sm text-primary hover:text-secondary font-medium inline-flex items-center gap-1"
      >
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        {t(lang, 'back')}
        {t(lang, 'navVoices')}
      </a>
    </nav>
  </article>
  <SameTopicRail lang={lang} kind="person" id={person.id} class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 mt-4" />
</Layout>
