---
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import { mddiSpeeches, type MddiSpeech } from '~/data/voices';
import {
  speechId,
  getSpeechTranscript,
  getSpeechTranscriptParagraphs,
  getSpeechTranscriptTldr,
} from '~/data/speech-transcripts';
import { findPersonId, getPerson } from '~/utils/people';
import { NON_DEFAULT_ROUTE_LOCALES, IN_LANGUAGES, localizedHref, pickLocalized, t, type Lang } from '~/i18n';
import { toTraditional } from '~/i18n/opencc';

export const prerender = true;

export const getStaticPaths = (() =>
  NON_DEFAULT_ROUTE_LOCALES.flatMap((lang) =>
    mddiSpeeches.map((speech) => ({
      params: { lang, id: speechId(speech) },
      props: { speech },
    }))
  )) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const isZh = lang === 'zh';
const isZhLike = lang === 'zh' || lang === 'zh-tw';
const { speech } = Astro.props as { speech: MddiSpeech };
const id = speechId(speech);
const transcript = getSpeechTranscript(id);
const paragraphsEn = getSpeechTranscriptParagraphs(id, 'en');
// The getters are lang-aware: zh-tw converts via OpenCC, ja/ko read their
// dedicated translated tracks and return nothing while a backfill is missing
// (never English — that made silent wrong-language pages under /ja/ /ko/).
const paragraphsLocal = getSpeechTranscriptParagraphs(id, lang);
const tldrLocal = getSpeechTranscriptTldr(id, lang);

const speakerPid = findPersonId(speech.speaker);
// Resolve speaker display name via Person record so non-zh locales get
// the Latin Roman form (Singapore press standard) instead of the raw
// Chinese name stored in speech.speaker.
const speakerPerson = speakerPid ? getPerson(speakerPid) : undefined;
const speakerDisplay = isZhLike
  ? lang === 'zh-tw'
    ? toTraditional(speech.speaker)
    : speech.speaker
  : (speakerPerson && (pickLocalized<string>(speakerPerson, 'name', 'nameEn', lang) || speakerPerson.nameEn)) ||
    speech.speaker;
const titleDisplay = pickLocalized<string>(speech, 'title', 'titleEn', lang) || speech.title;
const speakerTitle = pickLocalized(speech, 'speakerTitle', 'speakerTitleEn', lang);
const eventDisplay = pickLocalized<string>(speech, 'event', 'eventEn', lang) || speech.event;

const mddiSpeechLabel = t(lang, 'mddiSpeechLabel') || 'MDDI Speech';

const metadata = {
  // No section suffix: Metadata.astro's template appends `· sgai`, and a
  // page-level suffix on top double-branded the title (GSC 2026-07).
  title: titleDisplay,
  description: titleDisplay,
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titleDisplay,
  // Both zh and zh-tw display the CJK title as primary, so both benefit
  // from the raw zh title as an alternativeHeadline.
  ...(isZhLike ? { alternativeHeadline: speech.title } : {}),
  datePublished: speech.date,
  inLanguage: IN_LANGUAGES[lang],
  author: { '@type': 'Person', name: speakerDisplay },
  publisher: {
    '@type': 'GovernmentOrganization',
    name: 'Ministry of Digital Development and Information',
    url: 'https://www.mddi.gov.sg/',
  },
};

const breadcrumbs = [{ label: t(lang, 'navVoices'), href: localizedHref('/voices/', lang) }, { label: titleDisplay }];

const hasLocalCopy = !!transcript && paragraphsEn.length > 0;
const tldr = tldrLocal;

const speechCopy: Record<
  Lang,
  {
    translatedHeading: string;
    translatedNote: string;
    translatedAtLabel: string;
    originalHeading: string;
    originalNote: string;
    fetchedAtLabel: string;
    pending: string;
  }
> = {
  zh: {
    translatedHeading: '完整译文（中文）',
    translatedNote: 'MDDI 英文原文译文',
    translatedAtLabel: '翻译日期',
    originalHeading: '英文原文',
    originalNote: 'MDDI 官网原始记录',
    fetchedAtLabel: '抓取日期',
    pending: '此演讲尚未本地存档。暂时请到 MDDI 官网阅读原文。我们正在分批补全所有 AI 相关演讲稿的本地存档与中文译文。',
  },
  'zh-tw': {
    translatedHeading: '完整譯文（繁體中文）',
    translatedNote: 'MDDI 英文原文譯文',
    translatedAtLabel: '翻譯日期',
    originalHeading: '英文原文',
    originalNote: 'MDDI 官網原始記錄',
    fetchedAtLabel: '抓取日期',
    pending: '此演講尚未本地存檔。暫時請到 MDDI 官網閱讀原文。我們正在分批補全所有 AI 相關演講稿的本地存檔與中文譯文。',
  },
  ja: {
    translatedHeading: '全文翻訳',
    translatedNote: 'MDDI 英語原文の翻訳',
    translatedAtLabel: '翻訳日',
    originalHeading: '英語原文',
    originalNote: 'MDDI 公式サイト原文',
    fetchedAtLabel: '取得日',
    pending:
      'このスピーチの日本語全文はまだ準備中です。現時点では MDDI 公式サイトの原文をご確認ください。全文翻訳は順次追加します。',
  },
  ko: {
    translatedHeading: '전체 번역',
    translatedNote: 'MDDI 영어 원문의 번역',
    translatedAtLabel: '번역일',
    originalHeading: '영어 원문',
    originalNote: 'MDDI 공식 웹사이트 원문',
    fetchedAtLabel: '수집일',
    pending:
      '이 연설의 한국어 전문 번역은 아직 준비 중입니다. 현재는 MDDI 공식 웹사이트의 원문을 확인해 주세요. 전문 번역은 순차적으로 추가합니다.',
  },
  en: {
    translatedHeading: 'Full translation',
    translatedNote: 'Translation of the MDDI English original',
    translatedAtLabel: 'translated',
    originalHeading: 'Full speech',
    originalNote: 'Archived from mddi.gov.sg',
    fetchedAtLabel: 'fetched',
    pending:
      'Local archive is not yet available. Please read the original on the MDDI website. We are progressively archiving full text and translations for all AI-related MDDI speeches.',
  },
};

const copy = speechCopy[lang];
---

<Layout metadata={metadata} breadcrumbs={breadcrumbs} lang={lang}>
  <JsonLd schema={articleSchema} />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <p class="text-xs uppercase tracking-[0.18em] text-primary font-semibold mb-4">
      {mddiSpeechLabel} · {speech.date}
    </p>
    <h1 class="t-display text-gray-900 dark:text-white mb-3">
      {titleDisplay}
    </h1>
    {
      isZh && (
        <p class="text-sm md:text-base text-gray-500 dark:text-gray-400 italic mb-6 leading-relaxed">{speech.title}</p>
      )
    }

    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600 dark:text-gray-400 mb-8">
      {
        speakerPid ? (
          <a href={localizedHref(`/voices/${speakerPid}/`, lang)} class="font-medium text-primary hover:text-secondary">
            {speakerDisplay}
          </a>
        ) : (
          <span class="font-medium text-gray-700 dark:text-gray-300">{speakerDisplay}</span>
        )
      }
      <span class="text-gray-300 dark:text-gray-600">·</span>
      <span>{speakerTitle}</span>
      {
        eventDisplay && (
          <>
            <span class="text-gray-300 dark:text-gray-600">·</span>
            <span class="italic">{eventDisplay}</span>
          </>
        )
      }
    </div>

    {
      tldr && tldr.length > 0 && (
        <section class="mb-8 border-l-4 border-primary pl-5">
          <h2 class="text-xs uppercase tracking-wider text-primary font-semibold mb-2">
            {t(lang, 'speechSummaryPoints')}
          </h2>
          <ul class="space-y-2 text-base text-gray-700 dark:text-gray-300 leading-[1.85]">
            {tldr.map((point) => (
              <li class="flex gap-3">
                <span class="text-primary shrink-0 mt-1">•</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      paragraphsLocal.length > 0 && (
        <section class="my-8 border border-primary/20 bg-primary/5 rounded-xl p-5">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
            <h2 class="t-h3 text-gray-900 dark:text-white">{copy.translatedHeading}</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              {copy.translatedNote}
              {transcript?.translatedAt && ` · ${copy.translatedAtLabel}: ${transcript.translatedAt}`}
            </p>
          </div>
          <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-[1.9]">
            {paragraphsLocal.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      )
    }

    {
      paragraphsEn.length > 0 && paragraphsLocal.length === 0 && (
        <section class="my-8 callout-muted rounded-xl p-5 text-sm text-amber-900 dark:text-amber-200">
          {copy.pending}
        </section>
      )
    }

    {
      paragraphsEn.length > 0 && (
        <section class="my-8 border border-subtle rounded-xl p-5" data-i18n-allow-en="speech-verbatim-source">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
            <h2 class="t-h3 text-gray-900 dark:text-white">{copy.originalHeading}</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              {copy.originalNote}
              {transcript?.fetchedAt && ` · ${copy.fetchedAtLabel}: ${transcript.fetchedAt}`}
            </p>
          </div>
          <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            {paragraphsEn.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      )
    }

    {
      !hasLocalCopy && (
        <section class="my-8 callout-muted rounded-xl p-5 text-sm">
          <p class="text-amber-900 dark:text-amber-200">
            {copy.pending}{' '}
            <a href={speech.url} target="_blank" rel="noopener" class="underline">
              {t(lang, 'mddiSourceLabel') || 'MDDI website'}
            </a>
          </p>
        </section>
      )
    }

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={speech.url}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-secondary border border-primary/30 hover:border-primary px-4 py-2 rounded-md transition-colors"
      >
        <Icon name="tabler:external-link" class="w-4 h-4" />
        {t(lang, 'mddiSourceLabel') || 'Source on mddi.gov.sg'}
      </a>
    </div>

    <nav class="mt-12 pt-6 border-t border-subtle">
      <a
        href={localizedHref('/voices/', lang)}
        class="text-sm text-primary hover:text-secondary font-medium inline-flex items-center gap-1"
      >
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        {t(lang, 'back') || 'Back'} · {t(lang, 'navVoices')}
      </a>
    </nav>
  </article>
</Layout>
