/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Markdown twins of the detail pages (/debates/<id>.md and friends). They
# exist to be read by agents, so they must be served as text (not offered
# as a download) and be cross-origin fetchable.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

# Machine-readable exports. The live site already answers with
# `access-control-allow-origin: *` on every path (a Cloudflare-side rule,
# not this file) — declaring it here makes the guarantee part of the repo,
# so a dashboard change or a move off Cloudflare cannot silently revoke it.
# Five-minute browser cache, one-hour edge cache: the data changes weekly.
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, s-maxage=3600
