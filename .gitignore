# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

pnpm-lock.yaml

# astro cache
.astro/

# python cache
__pycache__/
*.pyc

# local tooling
.claude/
.playwright-mcp/

# auto update
scripts/auto_update_config.py
scripts/logs/
scripts/data/
scripts/hansard/data/transcripts/
scripts/hansard/data/translations/
scripts/videos/data/
scripts/voices/data/

# Phase 1 codemod intermediate outputs (regenerated from sources)
scripts/out/

# refresh pipeline caches (auto-discovered URLs, summaries, raw HTML)
scripts/refresh/policies/data/
scripts/refresh/ecosystem/data/
scripts/refresh/levers/data/
scripts/refresh/legal-ai/data/
scripts/refresh/talent/data/
scripts/refresh/startups/data/
scripts/refresh/tracker/data/
scripts/refresh/benchmarking/data/
scripts/refresh/voices/data/*
# Reject-decision cache IS tracked: weekly PRs surface drops for review
# and fresh checkouts inherit the seeded PMO date-floor backlog.
!scripts/refresh/voices/data/rejected-ids.json

# i18n translation cache (sha256-keyed claude haiku output)
scripts/i18n/data/

# eval reports — historical artefacts, regenerated each run
scripts/evals/*/reports/
# eval caches (sha256-keyed ai-summary / translation output), regenerated each run
scripts/evals/*/cache/
scripts/hansard/data/translate-cache-ko/
scripts/hansard/data/translate-cache-ja/
# transient backfill run logs
scripts/hansard/data/*.log

# data-relations review queues are review-in-progress working files;
# .gitkeep keeps the directory, individual queues stay local
scripts/data-relations/queue/*.json
